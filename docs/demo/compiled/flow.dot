digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_text_improver [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await start_text_improver(p)</i></td></tr><tr><td bgcolor="white" align="left">p['iteration'] = 0</td></tr></table>>];
  router_text_improver_line_29_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_text_improver_line_29_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['iteration'] &gt;= MAX_ITERATIONS</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>pass</b></font></td></tr></table></td></tr></table>>];
  router_text_improver_line_26_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_text_improver_line_26_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p.get('score', 0) &gt;= SCORE_THRESHOLD</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  router_text_improver_line_21_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_text_improver_line_21_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['iteration'] += 1</td></tr></table>>];
  router_text_improver_line_20_loop_back_0 [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_text_improver_line_20_loop_ba…(p)</i></td></tr></table>>];
  end_text_improver [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await end_text_improver(p)</i></td></tr></table>>];
  evaluator [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await evaluator(p)</i></td></tr></table>>];
  generator [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await generator(p)</i></td></tr></table>>];
  polisher [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await polisher(p)</i></td></tr></table>>];

  evaluator -> router_text_improver_line_26_if;
  generator -> evaluator;
  polisher -> end_text_improver;
  router_text_improver_line_20_loop_back_0 -> router_text_improver_line_21_seq [constraint=false];
  router_text_improver_line_21_seq -> generator;
  router_text_improver_line_26_if -> polisher [label="T", color=darkseagreen4];
  router_text_improver_line_26_if -> router_text_improver_line_29_if [label="F", color=indianred4];
  router_text_improver_line_29_if -> polisher [label="T", color=darkseagreen4];
  router_text_improver_line_29_if -> router_text_improver_line_20_loop_back_0 [label="F", color=indianred4];
  start_text_improver -> router_text_improver_line_20_loop_back_0;
}