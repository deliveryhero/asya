graph LR
    %% Left Zone: Runner
    subgraph Runner ["Runner Script"]
    RS["<b>Batch Runner</b><br/>(cron / manual)<br/>Runs N in parallel"]
    end

    %% Middle Zone: Fan out to Parallel Pipelines
    subgraph KFP ["Vertex AI / KFP Pipelines (Parallel)"]
    direction TB
    P1["<b>Pipeline Instance 1</b><br/>fetch → enhance → GPU"]
    P2["<b>Pipeline Instance 2</b><br/>fetch → enhance → GPU"]
    P_dots["..."]
    PN["<b>Pipeline Instance N</b><br/>fetch → enhance → GPU"]

    Logic["<b>Resilience Logic</b><br/><i>@retry, ThreadPool, sleep(backoff)</i>"]
    end

    %% Right Zone: Backend
    subgraph Backend ["Backend"]
    BE["<b>FastAPI Server</b><br/>+ PubSub<br/>+ PostgreSQL"]
    end

    %% External AI block
    subgraph External ["External Services"]
    AI["<b>AI APIs</b><br/>(LLM, Image Service, etc)<br/>⚡ 429 Rate Limits"]
    end

    %% Connections
    RS --> P1
    RS --> P2
    RS --> PN

    P1 <--> AI
    P2 <--> AI
    PN <--> AI

    P1 --> BE
    P2 --> BE
    PN --> BE

    %% Styling
    style AI fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style RS fill:#e1f5fe,stroke:#01579b
    style KFP fill:#f3e5f5,stroke:#4a148c
    style BE fill:#e8f5e9,stroke:#1b5e20
    style P_dots fill:none,stroke:none
