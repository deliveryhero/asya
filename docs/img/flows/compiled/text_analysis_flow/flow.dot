digraph "text_analysis_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    clean_text [label="clean_text", fillcolor=lightblue];
    end_text_analysis_flow [label="end_text_analysis_flow", fillcolor=palegreen];
    english_sentiment [label="english_sentiment", fillcolor=lightblue];
    extract_entities [label="extract_entities", fillcolor=lightblue];
    router_text_analysis_flow_line_11_if_4 [label="router_text_analysis_flow_line_11_if_4", fillcolor=wheat];
    router_text_analysis_flow_line_13_if_3 [label="router_text_analysis_flow_line_13_if_3", fillcolor=wheat];
    router_text_analysis_flow_line_16_seq_2 [label="router_text_analysis_flow_line_16_seq_2", fillcolor=wheat];
    router_text_analysis_flow_line_20_seq_1 [label="router_text_analysis_flow_line_20_seq_1", fillcolor=wheat];
    spanish_sentiment [label="spanish_sentiment", fillcolor=lightblue];
    start_text_analysis_flow [label="start_text_analysis_flow", fillcolor=palegreen];
    tokenize [label="tokenize", fillcolor=lightblue];

    start_text_analysis_flow -> clean_text;
    clean_text -> tokenize;
    tokenize -> router_text_analysis_flow_line_11_if_4;
    router_text_analysis_flow_line_13_if_3 -> spanish_sentiment [label="p['language'] == 'es'"];
    router_text_analysis_flow_line_13_if_3 -> router_text_analysis_flow_line_16_seq_2 [label="not (p['language'] == 'es')"];
    router_text_analysis_flow_line_11_if_4 -> english_sentiment [label="p['language'] == 'en'"];
    english_sentiment -> extract_entities;
    extract_entities -> router_text_analysis_flow_line_20_seq_1;
    router_text_analysis_flow_line_11_if_4 -> router_text_analysis_flow_line_13_if_3 [label="not (p['language'] == 'en')"];
    spanish_sentiment -> extract_entities;
    router_text_analysis_flow_line_16_seq_2 -> extract_entities;
    router_text_analysis_flow_line_20_seq_1 -> end_text_analysis_flow;
}