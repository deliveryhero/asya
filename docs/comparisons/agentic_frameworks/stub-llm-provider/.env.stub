# Source this file to use the stub AI provider
# Usage: source stub-llm-provider/.env.stub

# Stub server base URL (used by multiple frameworks)
export STUB_AI_BASE_URL="http://localhost:8100"

# OpenAI-compatible (CrewAI, OpenAI Agents, DSPy)
export OPENAI_API_KEY="stub-test-key"
export OPENAI_BASE_URL="http://localhost:8100"

# Anthropic (Anthropic SDK, LangGraph with langchain-anthropic)
export ANTHROPIC_API_KEY="stub-test-key"
export ANTHROPIC_BASE_URL="http://localhost:8100"

# Google ADK (uses STUB_AI_BASE_URL via custom StubGemini class)
export GOOGLE_API_KEY="stub-test-key"
