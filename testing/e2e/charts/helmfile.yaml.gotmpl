helmDefaults:
  wait: true
  timeout: 1200
  createNamespace: true
  atomic: false

environments:
  rabbitmq-minio-pg:
    values:
      - values.yaml
      - ../profiles/rabbitmq-minio-pg.yaml
  sqs-s3-pg:
    values:
      - values.yaml
      - ../profiles/sqs-s3-pg.yaml
  sqs-s3-pvc:
    values:
      - values.yaml
      - ../profiles/sqs-s3-pvc.yaml
  pubsub-gcs-pg:
    values:
      - values.yaml
      - ../profiles/pubsub-gcs-pg.yaml

---

repositories:
  - name: kedacore
    url: https://kedacore.github.io/charts
  - name: crossplane-stable
    url: https://charts.crossplane.io/stable
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts

releases:
  - name: keda
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: kedacore/keda
    labels:
      layer: infra
    {{- if hasKey .Values "keda" }}
    values:
      - {{- .Values.keda | toYaml | nindent 8 }}
    {{- end }}
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying KEDA...' && date +%s > /tmp/helm-keda-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] KEDA deployed in $(($(date +%s) - $(cat /tmp/helm-keda-start)))s\""]

# Disabled: prometheus and grafana are not tested in e2e
  # - name: prometheus
  #   namespace: {{ .Values.namespace | default "asya-e2e" }}
  #   chart: prometheus-community/prometheus
  #   labels:
  #     layer: infra

  # - name: grafana
  #   namespace: {{ .Values.namespace | default "asya-e2e" }}
  #   chart: grafana/grafana
  #   labels:
  #     layer: infra

  - name: postgres
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: ./postgres
    condition: postgres.enabled
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying PostgreSQL...' && date +%s > /tmp/helm-postgres-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] PostgreSQL deployed in $(($(date +%s) - $(cat /tmp/helm-postgres-start)))s\""]

  - name: s3
    namespace: asya-system
    chart: ./s3
    condition: storage.s3.enabled
    values:
      - enabled: {{ .Values.storage.s3.enabled | default false }}
        region: us-east-1
        {{- if and .Values.storage.s3.enabled .Values.actors.storage }}
        buckets:
          {{- if hasKey .Values.actors.storage "resultsBucket" }}
          - name: {{ .Values.actors.storage.resultsBucket }}
          {{- end }}
          {{- if hasKey .Values.actors.storage "errorsBucket" }}
          - name: {{ .Values.actors.storage.errorsBucket }}
          {{- end }}
          {{- if and (not (hasKey .Values.actors.storage "resultsBucket")) (not (hasKey .Values.actors.storage "errorsBucket")) (hasKey .Values.actors.storage "bucket") }}
          - name: {{ .Values.actors.storage.bucket }}
          {{- end }}
        {{- end }}
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying S3 (LocalStack)...' && date +%s > /tmp/helm-s3-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] S3 (LocalStack) deployed in $(($(date +%s) - $(cat /tmp/helm-s3-start)))s\""]

  - name: sqs
    namespace: asya-system
    chart: ./sqs
    condition: transport.sqs.enabled
    values:
      - enabled: {{ .Values.transport.sqs.enabled | default false }}
        region: us-east-1
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying SQS (LocalStack)...' && date +%s > /tmp/helm-sqs-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] SQS (LocalStack) deployed in $(($(date +%s) - $(cat /tmp/helm-sqs-start)))s\""]

  - name: rabbitmq
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: ./rabbitmq
    condition: transport.rabbitmq.enabled
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying RabbitMQ...' && date +%s > /tmp/helm-rabbitmq-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] RabbitMQ deployed in $(($(date +%s) - $(cat /tmp/helm-rabbitmq-start)))s\""]

  - name: minio
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: ./minio
    condition: storage.minio.enabled
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying MinIO...' && date +%s > /tmp/helm-minio-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] MinIO deployed in $(($(date +%s) - $(cat /tmp/helm-minio-start)))s\""]

  - name: pubsub
    namespace: asya-system
    chart: ./pubsub
    condition: transport.pubsub.enabled
    values:
      - enabled: {{ .Values.transport.pubsub.enabled | default false }}
        projectId: test-project
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying Pub/Sub (emulator)...' && date +%s > /tmp/helm-pubsub-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] Pub/Sub (emulator) deployed in $(($(date +%s) - $(cat /tmp/helm-pubsub-start)))s\""]

  - name: gcs
    namespace: asya-system
    chart: ./gcs
    condition: storage.gcs.enabled
    values:
      - enabled: {{ .Values.storage.gcs.enabled | default false }}
        {{- if and (.Values.storage.gcs.enabled) (.Values.actors).storage }}
        buckets:
          {{- with .Values.actors.storage.resultsBucket }}
          - {{ . }}
          {{- end }}
          {{- with .Values.actors.storage.errorsBucket }}
          - {{ . }}
          {{- end }}
        {{- end }}
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying GCS (emulator)...' && date +%s > /tmp/helm-gcs-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] GCS (emulator) deployed in $(($(date +%s) - $(cat /tmp/helm-gcs-start)))s\""]

  - name: tempo
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: grafana/tempo
    version: "~1.x"
    condition: tracing.enabled
    values:
      - tempo:
          storage:
            trace:
              backend: local
          retention: 24h
          receivers:
            otlp:
              protocols:
                grpc:
                  endpoint: "0.0.0.0:4317"
                http:
                  endpoint: "0.0.0.0:4318"
          metricsGenerator:
            enabled: true
            remoteWriteUrl: "http://prometheus-server.{{ .Values.namespace | default "asya-e2e" }}.svc.cluster.local:80/api/v1/write"
            processor:
              service_graphs:
                wait: 10s
                max_items: 10000
                enable_messaging_system_latency_histogram: true
                enable_virtual_node_label: true
              span_metrics:
                enable_target_info: true
        overrides:
          defaults:
            metrics_generator:
              processors:
                - service-graphs
                - span-metrics
        resources:
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            cpu: 250m
            memory: 256Mi
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying Tempo...' && date +%s > /tmp/helm-tempo-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] Tempo deployed in $(($(date +%s) - $(cat /tmp/helm-tempo-start)))s\""]

  - name: prometheus
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: prometheus-community/prometheus
    condition: observability.prometheus.enabled
    values:
      - server:
          persistentVolume:
            enabled: false
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
          extraFlags:
            - "web.enable-remote-write-receiver"
        alertmanager:
          enabled: false
        kube-state-metrics:
          enabled: false
        prometheus-node-exporter:
          enabled: false
        prometheus-pushgateway:
          enabled: false
        extraScrapeConfigs: |
          - job_name: asya-actors
            kubernetes_sd_configs:
              - role: pod
                namespaces:
                  names:
                    - {{ .Values.namespace | default "asya-e2e" }}
            relabel_configs:
              - source_labels: [__meta_kubernetes_pod_container_name]
                action: keep
                regex: asya-sidecar
              - source_labels: [__address__]
                action: replace
                regex: ([^:]+)(?::\d+)?
                replacement: ${1}:8080
                target_label: __address__
              - source_labels: [__meta_kubernetes_namespace]
                target_label: namespace
              - source_labels: [__meta_kubernetes_pod_label_asya_sh_actor]
                target_label: actor
              - source_labels: [__meta_kubernetes_pod_name]
                target_label: pod
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying Prometheus...' && date +%s > /tmp/helm-prometheus-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] Prometheus deployed in $(($(date +%s) - $(cat /tmp/helm-prometheus-start)))s\""]

  - name: loki
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: grafana/loki
    condition: observability.loki.enabled
    values:
      - deploymentMode: SingleBinary
        loki:
          auth_enabled: false
          useTestSchema: true
          commonConfig:
            replication_factor: 1
          storage:
            type: filesystem
        singleBinary:
          replicas: 1
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
        backend:
          replicas: 0
        read:
          replicas: 0
        write:
          replicas: 0
        gateway:
          enabled: false
        chunksCache:
          enabled: false
        resultsCache:
          enabled: false
        monitoring:
          selfMonitoring:
            enabled: false
          lokiCanary:
            enabled: false
        test:
          enabled: false
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying Loki...' && date +%s > /tmp/helm-loki-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] Loki deployed in $(($(date +%s) - $(cat /tmp/helm-loki-start)))s\""]

  - name: promtail
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: grafana/promtail
    condition: observability.promtail.enabled
    needs:
      - loki
    values:
      - config:
          clients:
            - url: http://loki:3100/loki/api/v1/push
        resources:
          requests:
            cpu: 25m
            memory: 64Mi
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying Promtail...' && date +%s > /tmp/helm-promtail-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] Promtail deployed in $(($(date +%s) - $(cat /tmp/helm-promtail-start)))s\""]

  - name: jwks-server
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: ./jwks-server
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying JWKS server...' && date +%s > /tmp/helm-jwks-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] JWKS server deployed in $(($(date +%s) - $(cat /tmp/helm-jwks-start)))s\""]

  - name: asya-crossplane
    namespace: asya-system
    chart: ../../../deploy/helm-charts/asya-crossplane
    needs:
      {{- $ns := .Values.namespace | default "asya-e2e" }}
      {{- if .Values.transport.sqs.enabled }}
      - asya-system/sqs
      {{- end }}
      {{- if .Values.storage.s3.enabled }}
      - asya-system/s3
      {{- end }}
      {{- if .Values.transport.rabbitmq.enabled }}
      - {{ $ns }}/rabbitmq
      {{- end }}
      {{- if .Values.storage.minio.enabled }}
      - {{ $ns }}/minio
      {{- end }}
      {{- if .Values.transport.pubsub.enabled }}
      - asya-system/pubsub
      {{- end }}
      {{- if .Values.storage.gcs.enabled }}
      - asya-system/gcs
      {{- end }}
    values:
      - {{- .Values.crossplane | toYaml | nindent 8 }}
      {{- if .Values.tracing.enabled }}
      - sidecar:
          tracingEndpoint: {{ printf "tempo.%s.svc.cluster.local:4317" (.Values.namespace | default "asya-e2e") | quote }}
      {{- end }}
    labels:
      layer: infra
    hooks:
      - events: ["presync"]
        command: "sh"
        args: ["-c", "echo '[.] Deploying asya-crossplane...' && date +%s > /tmp/helm-crossplane-start"]
      - events: ["postsync"]
        command: "sh"
        args: ["-c", "echo \"[+] asya-crossplane deployed in $(($(date +%s) - $(cat /tmp/helm-crossplane-start)))s\""]

  - name: asya-gateway
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: ../../../deploy/helm-charts/asya-gateway
    needs:
      {{- if .Values.postgres.enabled }}
      - postgres
      {{- end }}
    values:
      - {{- .Values.gateway | toYaml | nindent 8 }}
      {{- if .Values.tracing.enabled }}
      - tracing:
          endpoint: {{ printf "tempo.%s.svc.cluster.local:4317" (.Values.namespace | default "asya-e2e") | quote }}
      {{- end }}
    labels:
      layer: infra

  # System actors (crew) - using asya-crew chart (deployed before test-actors)
  - name: asya-crew
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: ../../../deploy/helm-charts/asya-crew
    values:
      - {{- .Values.crew | toYaml | nindent 8 }}
      {{- if .Values.tracing.enabled }}
      - tracing:
          endpoint: {{ printf "tempo.%s.svc.cluster.local:4317" (.Values.namespace | default "asya-e2e") | quote }}
      {{- end }}
    labels:
      layer: app

  # Test actors - deployed using asya-test-actors chart
  - name: test-actors
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: ./asya-test-actors
    needs:
      - asya-crew
    values:
      - namespace: {{ .Values.actors.namespace | default "asya-e2e" }}
        transport: {{ if .Values.transport.sqs.enabled }}sqs{{ else if .Values.transport.rabbitmq.enabled }}rabbitmq{{ else if .Values.transport.pubsub.enabled }}pubsub{{ else }}sqs{{ end }}
        workload:
          image: ghcr.io/deliveryhero/asya-testing:latest
          imagePullPolicy: Never
    labels:
      layer: app

  # Flow test actors - deployed using asya-test-flows chart
  - name: test-flows
    namespace: {{ .Values.namespace | default "asya-e2e" }}
    chart: ./asya-test-flows
    needs:
      - asya-crew
    values:
      - workload:
          image: ghcr.io/deliveryhero/asya-testing:latest
          imagePullPolicy: Never
        crewImage: ghcr.io/deliveryhero/asya-crew:latest
        stateProxy:
          backend: {{ .Values.actors.storage.type | default "s3" }}
          config:
            bucket: {{ .Values.actors.storage.bucket | default "asya-results" }}
            {{- if eq (.Values.actors.storage.type | default "s3") "s3" }}
            endpoint: {{ .Values.actors.storage.endpoint | default "" }}
            region: {{ .Values.actors.storage.region | default "us-east-1" }}
            accessKey: {{ .Values.actors.storage.accessKey | default "" }}
            secretKey: {{ .Values.actors.storage.secretKey | default "" }}
            {{- else if eq .Values.actors.storage.type "gcs" }}
            project: {{ .Values.actors.storage.project | default "" }}
            emulatorHost: {{ .Values.actors.storage.emulatorHost | default "" }}
            {{- end }}
    labels:
      layer: app
