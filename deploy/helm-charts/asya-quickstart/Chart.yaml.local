apiVersion: v2
name: asya-quickstart
description: Demo package for local development and testing with Asya. NOT for production use.
type: application
# versions don't matter in local
version: 0.0.0
appVersion: "0.0.0"
keywords:
- asya
- actor
- operator
- gateway
- demo
- quickstart
maintainers:
- name: Asya Team

# Local dependencies (for development/testing with unpublished chart versions)
dependencies:
# locally, versions are always 0.0.0
- name: asya-operator
  version: "0.0.0"
  repository: "file://../asya-operator"
- name: asya-crew
  version: "0.0.0"
  repository: "file://../asya-crew"
  condition: crew.enabled
- name: asya-gateway
  version: "0.0.0"
  repository: "file://../asya-gateway"
  condition: gateway.enabled
