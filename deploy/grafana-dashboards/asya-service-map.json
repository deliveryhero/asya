{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": ["asya"],
      "targetBlank": false,
      "title": "Actors Overview",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "nodes": {},
        "edges": {}
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "serviceMap",
          "refId": "A"
        }
      ],
      "title": "Actor Service Map",
      "description": "Live topology of the actor mesh. Nodes = actors/services, edges = message flow. Requires Tempo metricsGenerator for full edge metrics.",
      "type": "nodeGraph"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 10,
      "title": "Recent Traces",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "/explore?orgId=1&left=%7B%22datasource%22:%22${tempo_datasource}%22,%22queries%22:%5B%7B%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22%7D%5D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "ms" }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceqlSearch",
          "limit": 20,
          "filters": [
            {
              "id": "service-name",
              "tag": "resource.service.name",
              "operator": "=",
              "scope": "resource",
              "value": ["${service:pipe}"]
            },
            {
              "id": "span-name",
              "tag": "name",
              "operator": "=",
              "scope": "span"
            },
            {
              "id": "min-duration",
              "tag": "duration",
              "operator": ">",
              "valueType": "duration"
            }
          ],
          "refId": "A"
        }
      ],
      "title": "Recent Traces",
      "description": "Click a trace ID to view the full waterfall",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 11,
      "title": "Error Traces",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{status=error && resource.service.name=~\"${service:pipe}\"}",
          "limit": 20,
          "refId": "A"
        }
      ],
      "title": "Error Traces",
      "description": "Traces with at least one error span",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "id": 12,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{name=\"actor.runtime.call\" && resource.service.name=~\"${service:pipe}\"} | rate()",
          "refId": "A"
        }
      ],
      "title": "Runtime Call Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{name=\"actor.runtime.call\" && resource.service.name=~\"${service:pipe}\"} | quantile_over_time(duration, 0.95)",
          "refId": "A"
        }
      ],
      "title": "Runtime Call Latency (P95)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["asya", "tracing"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "tempo_datasource",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "tempo",
          "uid": "${tempo_datasource}"
        },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "queryType": "traceql",
          "query": "{} | select(resource.service.name)"
        },
        "refresh": 2,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "title": "Asya - Service Map & Traces",
  "uid": "asya-service-map-traces"
}
