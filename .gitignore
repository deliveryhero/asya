# Managed by git-aint — overwritten on every `git aint init`
# On aint-sync branch: only track aints/ and config
# Everything else (source code, docs, etc.) lives on main branch
*
!.gitignore
!.aint-config.yaml
!aints/
!aints/**

# Tmux session logs (local only) — must come AFTER !aints/** to override it
aints/**/.tmux-logs/
