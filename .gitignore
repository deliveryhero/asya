# Managed by git-aint — overwritten on every `git aint init`
# On aint-sync branch: track active/, archive/, scripts/, docs/, and auto files
*
!.gitignore
!.gitattributes
!AGENTS.md
!active/
!active/*
!active/**/*
!archive/
!archive/*
!archive/**/*
!docs/
!docs/*
!docs/**/*
!trash/
!trash/*
!trash/**/*
!scripts/
!scripts/*
!scripts/**/*
!auto_state.md
