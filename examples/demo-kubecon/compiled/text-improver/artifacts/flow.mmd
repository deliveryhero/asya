flowchart TD
    %% Flow: text_improver

    evaluate[evaluate]
    generate[generate]
    polish[polish]
    research[research]
    router_text_improver_if_iteration_ge_max_iterations{{router_text_improver_if_iteration_ge_max_iterations}}
    router_text_improver_if_score_ge_threshold{{router_text_improver_if_score_ge_threshold}}
    router_text_improver_seq_set_iteration{{"router_text_improver_seq_set_iteration<br/><br/>p['iteration'] = p.get('iteration', 1) + 1"}}
    router_text_improver_while_loop{{router_text_improver_while_loop}}
    start_text_improver(["start_text_improver<br/><br/>p['topic'] = p.get('topic', 'anything')"])
    __end__((( )))

    start_text_improver --> research
    research --> router_text_improver_while_loop
    router_text_improver_if_iteration_ge_max_iterations -->|"p['iteration'] >= p.get('max_iterations', 3)"| polish
    router_text_improver_if_score_ge_threshold -->|"else"| router_text_improver_if_iteration_ge_max_iterations
    router_text_improver_if_score_ge_threshold -->|"p['score'] >= p.get('threshold', 85)"| polish
    router_text_improver_seq_set_iteration --> generate
    generate --> evaluate
    evaluate --> router_text_improver_if_score_ge_threshold
    router_text_improver_while_loop --> router_text_improver_seq_set_iteration
    router_text_improver_if_iteration_ge_max_iterations -->|"else"| router_text_improver_while_loop
    polish --> __end__

