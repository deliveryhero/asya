digraph "text_improver" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_text_improver; }

    evaluate [label="evaluate", fillcolor=lightblue];
    format_output [label="format_output", fillcolor=lightsalmon];
    generate [label="generate", fillcolor=lightblue];
    polish [label="polish", fillcolor=lightblue];
    research [label="research", fillcolor=lightblue];
    router_text_improver_if_iteration_ge_max_iterations [label="router_text_improver_if_iteration_ge_max_iterations", fillcolor=wheat];
    router_text_improver_if_score_ge_threshold [label="router_text_improver_if_score_ge_threshold", fillcolor=wheat];
    router_text_improver_seq_set_feedback [label="router_text_improver_seq_set_feedback\n\np['feedback'] = ''\np['iteration'] = 0", fillcolor=wheat];
    router_text_improver_seq_set_iteration [label="router_text_improver_seq_set_iteration\n\np['iteration'] += 1", fillcolor=wheat];
    router_text_improver_while_loop [label="router_text_improver_while_loop", fillcolor=wheat];
    start_text_improver [label="start_text_improver", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_text_improver -> research;
    research -> router_text_improver_seq_set_feedback;
    router_text_improver_if_iteration_ge_max_iterations -> polish [label="p['iteration'] >= p.get('max_iterations', 3)", color="#2E8B57", fontcolor="#2E8B57"];
    polish -> format_output;
    router_text_improver_if_score_ge_threshold -> router_text_improver_if_iteration_ge_max_iterations [label="else", color="#D35400", fontcolor="#D35400"];
    router_text_improver_if_score_ge_threshold -> polish [label="p['score'] >= p.get('threshold', 85)", color="#2E8B57", fontcolor="#2E8B57"];
    router_text_improver_seq_set_iteration -> generate;
    generate -> evaluate;
    evaluate -> router_text_improver_if_score_ge_threshold;
    router_text_improver_while_loop -> router_text_improver_seq_set_iteration;
    router_text_improver_seq_set_feedback -> router_text_improver_while_loop;
    router_text_improver_if_iteration_ge_max_iterations -> router_text_improver_while_loop [label="else", color="#D35400", fontcolor="#D35400"];
    format_output -> __end__;
}