digraph "greet_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_greet_flow; }

    greet [label="greet", fillcolor=lightblue];
    router_greet_flow_seq_p_shout_p [label="router_greet_flow_seq_p_shout_p", fillcolor=wheat];
    start_greet_flow [label="start_greet_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_greet_flow -> greet;
    greet -> router_greet_flow_seq_p_shout_p;
    router_greet_flow_seq_p_shout_p -> __end__;
}