digraph "pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_pipeline; }

    analyze [label="analyze", fillcolor=lightblue];
    start_pipeline [label="start_pipeline", fillcolor=palegreen];
    summarize [label="summarize", fillcolor=lightblue];
    translate [label="translate", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_pipeline -> analyze;
    analyze -> summarize;
    summarize -> translate;
    translate -> __end__;
}