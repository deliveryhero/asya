digraph flow {
  rankdir=TB;
  compound=true;
  node [shape=box, style=rounded];

  n0 [label="flow_conditional_routing", shape=ellipse, style=filled, fillcolor=lightgreen];
  n1 [label="End", shape=ellipse, style=filled, fillcolor=lightcoral];

  subgraph cluster_0 {
    style=filled;
    fillcolor=lightgrey;
    label="flow_conditional_routing";

    n2 [label="Setup route", shape=box, style="rounded,filled", fillcolor=white];
  }

  subgraph cluster_1 {
    style=filled;
    fillcolor=lightblue;
    label="handler_validate_input";

    n3 [label="Execute\nhandler_validate_input", shape=box, style="rounded,filled", fillcolor=white];
  }

  subgraph cluster_2 {
    style=filled;
    fillcolor=wheat;
    label="flow_conditional_routing_line_19_if";

    n4 [label="Check:\np['type'] == 'A'", shape=diamond, style=filled, fillcolor=white];
    n6 [label="Check:\np['type'] == 'B'", shape=diamond, style=filled, fillcolor=white];
    n7 [label="Check:\np['type'] == 'C'", shape=diamond, style=filled, fillcolor=white];
    n4 -> n6 [label="false", color=red];
    n6 -> n7 [label="false", color=red];
  }

  n5 [label="", shape=point, width=0.1];

  subgraph cluster_3 {
    style=filled;
    fillcolor=lightblue;
    label="handler_type_a";

    n8 [label="Execute\nhandler_type_a", shape=box, style="rounded,filled", fillcolor=white];
  }

  subgraph cluster_4 {
    style=filled;
    fillcolor=lightblue;
    label="handler_type_b";

    n9 [label="Execute\nhandler_type_b", shape=box, style="rounded,filled", fillcolor=white];
  }

  subgraph cluster_5 {
    style=filled;
    fillcolor=lightblue;
    label="handler_type_c";

    n10 [label="Execute\nhandler_type_c", shape=box, style="rounded,filled", fillcolor=white];
  }

  subgraph cluster_6 {
    style=filled;
    fillcolor=lightblue;
    label="handler_default";

    n11 [label="Execute\nhandler_default", shape=box, style="rounded,filled", fillcolor=white];
  }

  subgraph cluster_7 {
    style=filled;
    fillcolor=lightblue;
    label="handler_finalize";

    n12 [label="Execute\nhandler_finalize", shape=box, style="rounded,filled", fillcolor=white];
  }

  n0 -> n2;
  n2 -> n3;
  n3 -> n4;
  n4 -> n8 [label="true", color=green];
  n8 -> n5;
  n6 -> n9 [label="true", color=green];
  n9 -> n5;
  n7 -> n10 [label="true", color=green];
  n10 -> n5;
  n7 -> n11 [label="false", color=red];
  n11 -> n5;
  n5 -> n12;
  n12 -> n1 [label="return"];
}
