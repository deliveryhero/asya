digraph "human_in_the_loop" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_human_in_the_loop [label="end_human_in_the_loop", fillcolor=palegreen];
    executor [label="executor", fillcolor=lightblue];
    notifier [label="notifier", fillcolor=lightblue];
    router_human_in_the_loop_line_70_if_5 [label="router_human_in_the_loop_line_70_if_5", fillcolor=wheat];
    router_human_in_the_loop_line_79_if_3 [label="router_human_in_the_loop_line_79_if_3", fillcolor=wheat];
    router_human_in_the_loop_line_80_seq_2 [label="router_human_in_the_loop_line_80_seq_2", fillcolor=wheat];

    router_human_in_the_loop_line_80_seq_2 -> notifier;
    router_human_in_the_loop_line_79_if_3 -> router_human_in_the_loop_line_80_seq_2 [label="p['attempt'] >= 3"];
    router_human_in_the_loop_line_70_if_5 -> executor [label="p.get('approval') in ('approved', 'modified')"];
    router_human_in_the_loop_line_70_if_5 -> notifier [label="p.get('approval') in ('approved', 'modified')"];
}