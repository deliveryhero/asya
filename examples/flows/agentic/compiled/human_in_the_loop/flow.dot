digraph "human_in_the_loop" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_human_in_the_loop; }

    approval_gate [label="approval_gate", fillcolor=lightblue];
    executor [label="executor", fillcolor=lightblue];
    notifier [label="notifier", fillcolor=lightblue];
    proposal_generator [label="proposal_generator", fillcolor=lightblue];
    revision_agent [label="revision_agent", fillcolor=lightblue];
    router_human_in_the_loop_line_60_while_1 [label="router_human_in_the_loop_line_60_while_1", fillcolor=wheat];
    router_human_in_the_loop_line_61_seq_6 [label="router_human_in_the_loop_line_61_seq_6\n\np['attempt'] += 1", fillcolor=wheat];
    router_human_in_the_loop_line_70_if_5 [label="router_human_in_the_loop_line_70_if_5", fillcolor=wheat];
    router_human_in_the_loop_line_75_if_4 [label="router_human_in_the_loop_line_75_if_4", fillcolor=wheat];
    router_human_in_the_loop_line_79_if_3 [label="router_human_in_the_loop_line_79_if_3", fillcolor=wheat];
    router_human_in_the_loop_line_80_seq_2 [label="router_human_in_the_loop_line_80_seq_2\n\np['result'] = 'Max revision attempts reached'", fillcolor=wheat];
    start_human_in_the_loop [label="start_human_in_the_loop\n\np['attempt'] = 0", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_human_in_the_loop -> router_human_in_the_loop_line_60_while_1;
    router_human_in_the_loop_line_80_seq_2 -> notifier;
    router_human_in_the_loop_line_79_if_3 -> router_human_in_the_loop_line_80_seq_2 [label="p['attempt'] >= 3", color="#2E8B57", fontcolor="#2E8B57"];
    router_human_in_the_loop_line_75_if_4 -> revision_agent [label="p.get('approval') == 'rejected'", color="#2E8B57", fontcolor="#2E8B57"];
    router_human_in_the_loop_line_70_if_5 -> router_human_in_the_loop_line_75_if_4 [label="else", color="#E07040", fontcolor="#E07040"];
    router_human_in_the_loop_line_70_if_5 -> executor [label="p.get('approval') in ('approved', 'modified')", color="#2E8B57", fontcolor="#2E8B57"];
    executor -> notifier;
    router_human_in_the_loop_line_61_seq_6 -> proposal_generator;
    proposal_generator -> approval_gate;
    approval_gate -> router_human_in_the_loop_line_70_if_5;
    router_human_in_the_loop_line_60_while_1 -> router_human_in_the_loop_line_61_seq_6;
    revision_agent -> router_human_in_the_loop_line_79_if_3;
    router_human_in_the_loop_line_79_if_3 -> router_human_in_the_loop_line_60_while_1 [label="else", color="#E07040", fontcolor="#E07040"];
    router_human_in_the_loop_line_75_if_4 -> router_human_in_the_loop_line_60_while_1 [label="else", color="#E07040", fontcolor="#E07040"];
    notifier -> __end__;
}