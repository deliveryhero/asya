digraph "routing_classifier" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    account_agent [label="account_agent", fillcolor=lightblue];
    billing_agent [label="billing_agent", fillcolor=lightblue];
    classifier [label="classifier", fillcolor=lightblue];
    end_routing_classifier [label="end_routing_classifier", fillcolor=palegreen];
    format_reply [label="format_reply", fillcolor=lightblue];
    general_agent [label="general_agent", fillcolor=lightblue];
    router_routing_classifier_line_47_if_3 [label="router_routing_classifier_line_47_if_3", fillcolor=wheat];
    router_routing_classifier_line_49_if_2 [label="router_routing_classifier_line_49_if_2", fillcolor=wheat];
    router_routing_classifier_line_51_if_1 [label="router_routing_classifier_line_51_if_1", fillcolor=wheat];
    start_routing_classifier [label="start_routing_classifier", fillcolor=palegreen];
    technical_agent [label="technical_agent", fillcolor=lightblue];

    start_routing_classifier -> classifier;
    start_routing_classifier -> router_routing_classifier_line_47_if_3;
    router_routing_classifier_line_51_if_1 -> account_agent [label="p.get('category') == 'account'"];
    router_routing_classifier_line_51_if_1 -> general_agent [label="not (p.get('category') == 'account')"];
    router_routing_classifier_line_49_if_2 -> technical_agent [label="p.get('category') == 'technical'"];
    router_routing_classifier_line_49_if_2 -> router_routing_classifier_line_51_if_1 [label="not (p.get('category') == 'technical')"];
    router_routing_classifier_line_47_if_3 -> billing_agent [label="p.get('category') == 'billing'"];
    router_routing_classifier_line_47_if_3 -> format_reply [label="p.get('category') == 'billing'"];
    router_routing_classifier_line_47_if_3 -> router_routing_classifier_line_49_if_2 [label="not (p.get('category') == 'billing')"];
    router_routing_classifier_line_47_if_3 -> format_reply [label="not (p.get('category') == 'billing')"];
}