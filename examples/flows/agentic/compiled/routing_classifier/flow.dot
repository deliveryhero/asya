digraph "routing_classifier" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_routing_classifier; }

    account_agent [label="account_agent", fillcolor=lightblue];
    billing_agent [label="billing_agent", fillcolor=lightblue];
    classifier [label="classifier", fillcolor=lightblue];
    format_reply [label="format_reply", fillcolor=lightsalmon];
    general_agent [label="general_agent", fillcolor=lightblue];
    router_routing_classifier_if_category_eq_account [label="router_routing_classifier_if_category_eq_account", fillcolor=wheat];
    router_routing_classifier_if_category_eq_billing [label="router_routing_classifier_if_category_eq_billing", fillcolor=wheat];
    router_routing_classifier_if_category_eq_technical [label="router_routing_classifier_if_category_eq_technical", fillcolor=wheat];
    start_routing_classifier [label="start_routing_classifier", fillcolor=palegreen];
    technical_agent [label="technical_agent", fillcolor=lightblue];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_routing_classifier -> classifier;
    classifier -> router_routing_classifier_if_category_eq_billing;
    router_routing_classifier_if_category_eq_account -> account_agent [label="p.get('category') == 'account'", color="#2E8B57", fontcolor="#2E8B57"];
    router_routing_classifier_if_category_eq_account -> general_agent [label="else", color="#D35400", fontcolor="#D35400"];
    router_routing_classifier_if_category_eq_technical -> technical_agent [label="p.get('category') == 'technical'", color="#2E8B57", fontcolor="#2E8B57"];
    router_routing_classifier_if_category_eq_technical -> router_routing_classifier_if_category_eq_account [label="else", color="#D35400", fontcolor="#D35400"];
    router_routing_classifier_if_category_eq_billing -> billing_agent [label="p.get('category') == 'billing'", color="#2E8B57", fontcolor="#2E8B57"];
    billing_agent -> format_reply;
    router_routing_classifier_if_category_eq_billing -> router_routing_classifier_if_category_eq_technical [label="else", color="#D35400", fontcolor="#D35400"];
    technical_agent -> format_reply;
    account_agent -> format_reply;
    general_agent -> format_reply;
    format_reply -> __end__;
}