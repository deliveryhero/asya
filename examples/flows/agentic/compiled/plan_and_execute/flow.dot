digraph "plan_and_execute" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_plan_and_execute; }

    executor [label="executor", fillcolor=lightblue];
    planner [label="planner", fillcolor=lightblue];
    re_planner [label="re_planner", fillcolor=lightblue];
    router_plan_and_execute_line_54_while_2 [label="router_plan_and_execute_line_54_while_2", fillcolor=wheat];
    router_plan_and_execute_line_59_if_3 [label="router_plan_and_execute_line_59_if_3\n\np['current_step'] += 1", fillcolor=wheat];
    router_plan_and_execute_line_62_seq_1 [label="router_plan_and_execute_line_62_seq_1\n\np['completed'] = True", fillcolor=wheat];
    start_plan_and_execute [label="start_plan_and_execute\n\np['current_step'] = 0\np['step_results'] = []", fillcolor=palegreen];
    synthesizer [label="synthesizer", fillcolor=lightsalmon];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_plan_and_execute -> planner;
    planner -> router_plan_and_execute_line_54_while_2;
    router_plan_and_execute_line_62_seq_1 -> synthesizer;
    router_plan_and_execute_line_59_if_3 -> re_planner [label="p['current_step'] < len(p.get('plan', []))", color="#2E8B57", fontcolor="#2E8B57"];
    router_plan_and_execute_line_54_while_2 -> executor [label="p['current_step'] < len(p.get('plan', []))", color="#2E8B57", fontcolor="#2E8B57"];
    executor -> router_plan_and_execute_line_59_if_3;
    router_plan_and_execute_line_54_while_2 -> router_plan_and_execute_line_62_seq_1 [label="else", color="#D35400", fontcolor="#D35400"];
    re_planner -> router_plan_and_execute_line_54_while_2;
    router_plan_and_execute_line_59_if_3 -> router_plan_and_execute_line_54_while_2 [label="else", color="#D35400", fontcolor="#D35400"];
    synthesizer -> __end__;
}