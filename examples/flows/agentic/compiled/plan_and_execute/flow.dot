digraph "plan_and_execute" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_plan_and_execute [label="end_plan_and_execute", fillcolor=palegreen];
    executor [label="executor", fillcolor=lightblue];
    planner [label="planner", fillcolor=lightblue];
    re_planner [label="re_planner", fillcolor=lightblue];
    router_plan_and_execute_line_49_seq_4 [label="router_plan_and_execute_line_49_seq_4", fillcolor=wheat];
    router_plan_and_execute_line_54_while_2 [label="router_plan_and_execute_line_54_while_2", fillcolor=wheat];
    router_plan_and_execute_line_59_if_3 [label="router_plan_and_execute_line_59_if_3", fillcolor=wheat];
    router_plan_and_execute_line_62_seq_1 [label="router_plan_and_execute_line_62_seq_1", fillcolor=wheat];
    start_plan_and_execute [label="start_plan_and_execute", fillcolor=palegreen];
    synthesizer [label="synthesizer", fillcolor=lightblue];

    start_plan_and_execute -> router_plan_and_execute_line_49_seq_4;
    router_plan_and_execute_line_62_seq_1 -> synthesizer;
    router_plan_and_execute_line_59_if_3 -> re_planner [label="p['current_step'] < len(p.get('plan', []))"];
    router_plan_and_execute_line_54_while_2 -> executor [label="p['current_step'] < len(p.get('plan', []))"];
    executor -> router_plan_and_execute_line_59_if_3;
    router_plan_and_execute_line_54_while_2 -> router_plan_and_execute_line_62_seq_1 [label="not (p['current_step'] < len(p.get('plan', [])))"];
    router_plan_and_execute_line_49_seq_4 -> planner;
    planner -> router_plan_and_execute_line_54_while_2;
    re_planner -> router_plan_and_execute_line_54_while_2;
    synthesizer -> end_plan_and_execute;
}