digraph "plan_and_execute" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_plan_and_execute [label="end_plan_and_execute", fillcolor=palegreen];
    router_plan_and_execute_line_54_while_2 [label="router_plan_and_execute_line_54_while_2", fillcolor=wheat];
    router_plan_and_execute_line_62_seq_1 [label="router_plan_and_execute_line_62_seq_1", fillcolor=wheat];

    router_plan_and_execute_line_54_while_2 -> router_plan_and_execute_line_62_seq_1 [label="p['current_step'] < len(p.get('plan', []))"];
}