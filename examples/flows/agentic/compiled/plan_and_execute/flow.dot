digraph "plan_and_execute" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_plan_and_execute; }

    executor [label="executor", fillcolor=lightblue];
    planner [label="planner", fillcolor=lightblue];
    re_planner [label="re_planner", fillcolor=lightblue];
    router_plan_and_execute_if_current_step_lt_len_p_get_plan [label="router_plan_and_execute_if_current_step_lt_len_p_get_plan\n\np['current_step'] += 1", fillcolor=wheat];
    router_plan_and_execute_seq_set_completed [label="router_plan_and_execute_seq_set_completed\n\np['completed'] = True", fillcolor=wheat];
    router_plan_and_execute_while_current_step_lt_len_p_get_plan [label="router_plan_and_execute_while_current_step_lt_len_p_get_plan", fillcolor=wheat];
    start_plan_and_execute [label="start_plan_and_execute\n\np['current_step'] = 0\np['step_results'] = []", fillcolor=palegreen];
    synthesizer [label="synthesizer", fillcolor=lightsalmon];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_plan_and_execute -> planner;
    planner -> router_plan_and_execute_while_current_step_lt_len_p_get_plan;
    router_plan_and_execute_seq_set_completed -> synthesizer;
    router_plan_and_execute_if_current_step_lt_len_p_get_plan -> re_planner [label="p['current_step'] < len(p.get('plan', []))", color="#2E8B57", fontcolor="#2E8B57"];
    router_plan_and_execute_while_current_step_lt_len_p_get_plan -> executor [label="p['current_step'] < len(p.get('plan', []))", color="#2E8B57", fontcolor="#2E8B57"];
    executor -> router_plan_and_execute_if_current_step_lt_len_p_get_plan;
    router_plan_and_execute_while_current_step_lt_len_p_get_plan -> router_plan_and_execute_seq_set_completed [label="else", color="#D35400", fontcolor="#D35400"];
    re_planner -> router_plan_and_execute_while_current_step_lt_len_p_get_plan;
    router_plan_and_execute_if_current_step_lt_len_p_get_plan -> router_plan_and_execute_while_current_step_lt_len_p_get_plan [label="else", color="#D35400", fontcolor="#D35400"];
    synthesizer -> __end__;
}