digraph "tool_calling_agent" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_tool_calling_agent; }

    calculate [label="calculate", fillcolor=lightblue];
    format_response [label="format_response", fillcolor=lightsalmon];
    get_weather [label="get_weather", fillcolor=lightblue];
    list_gcs_files [label="list_gcs_files", fillcolor=lightblue];
    llm_reason [label="llm_reason", fillcolor=lightblue];
    router_tool_calling_agent_line_103_while_1 [label="router_tool_calling_agent_line_103_while_1", fillcolor=wheat];
    router_tool_calling_agent_line_104_seq_8 [label="router_tool_calling_agent_line_104_seq_8\n\np['iteration'] += 1", fillcolor=wheat];
    router_tool_calling_agent_line_109_if_7 [label="router_tool_calling_agent_line_109_if_7", fillcolor=wheat];
    router_tool_calling_agent_line_115_if_6 [label="router_tool_calling_agent_line_115_if_6", fillcolor=wheat];
    router_tool_calling_agent_line_117_if_5 [label="router_tool_calling_agent_line_117_if_5", fillcolor=wheat];
    router_tool_calling_agent_line_119_if_4 [label="router_tool_calling_agent_line_119_if_4", fillcolor=wheat];
    router_tool_calling_agent_line_122_if_3 [label="router_tool_calling_agent_line_122_if_3", fillcolor=wheat];
    router_tool_calling_agent_line_127_seq_2 [label="router_tool_calling_agent_line_127_seq_2\n\np['messages'] = p['messages'] + [{'role': 'tool', 'content': p['tool_result']}]", fillcolor=wheat];
    start_tool_calling_agent [label="start_tool_calling_agent\n\np['messages'] = p.get('messages', [])\np['iteration'] = 0", fillcolor=palegreen];
    web_search [label="web_search", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_tool_calling_agent -> router_tool_calling_agent_line_103_while_1;
    router_tool_calling_agent_line_122_if_3 -> list_gcs_files [label="p['tool_name'] == 'list_gcs_files'", color="#2E8B57", fontcolor="#2E8B57"];
    router_tool_calling_agent_line_119_if_4 -> calculate [label="p['tool_name'] == 'calculate'", color="#2E8B57", fontcolor="#2E8B57"];
    router_tool_calling_agent_line_119_if_4 -> router_tool_calling_agent_line_122_if_3 [label="else", color="#D35400", fontcolor="#D35400"];
    router_tool_calling_agent_line_117_if_5 -> web_search [label="p['tool_name'] == 'web_search'", color="#2E8B57", fontcolor="#2E8B57"];
    router_tool_calling_agent_line_117_if_5 -> router_tool_calling_agent_line_119_if_4 [label="else", color="#D35400", fontcolor="#D35400"];
    router_tool_calling_agent_line_115_if_6 -> get_weather [label="p['tool_name'] == 'get_weather'", color="#2E8B57", fontcolor="#2E8B57"];
    get_weather -> router_tool_calling_agent_line_127_seq_2;
    router_tool_calling_agent_line_115_if_6 -> router_tool_calling_agent_line_117_if_5 [label="else", color="#D35400", fontcolor="#D35400"];
    router_tool_calling_agent_line_109_if_7 -> router_tool_calling_agent_line_115_if_6 [label="else", color="#D35400", fontcolor="#D35400"];
    router_tool_calling_agent_line_109_if_7 -> format_response [label="not p.get('tool_name')", color="#2E8B57", fontcolor="#2E8B57"];
    router_tool_calling_agent_line_104_seq_8 -> llm_reason;
    llm_reason -> router_tool_calling_agent_line_109_if_7;
    router_tool_calling_agent_line_103_while_1 -> router_tool_calling_agent_line_104_seq_8;
    web_search -> router_tool_calling_agent_line_127_seq_2;
    calculate -> router_tool_calling_agent_line_127_seq_2;
    list_gcs_files -> router_tool_calling_agent_line_127_seq_2;
    router_tool_calling_agent_line_127_seq_2 -> router_tool_calling_agent_line_103_while_1;
    router_tool_calling_agent_line_122_if_3 -> router_tool_calling_agent_line_103_while_1 [label="else", color="#D35400", fontcolor="#D35400"];
    format_response -> __end__;
}