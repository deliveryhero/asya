digraph "tool_calling_agent" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_tool_calling_agent; }

    calculate [label="calculate", fillcolor=lightblue];
    format_response [label="format_response", fillcolor=lightsalmon];
    get_weather [label="get_weather", fillcolor=lightblue];
    list_gcs_files [label="list_gcs_files", fillcolor=lightblue];
    llm_reason [label="llm_reason", fillcolor=lightblue];
    router_tool_calling_agent_if_not_tool_name [label="router_tool_calling_agent_if_not_tool_name", fillcolor=wheat];
    router_tool_calling_agent_if_tool_name_eq_calculate [label="router_tool_calling_agent_if_tool_name_eq_calculate", fillcolor=wheat];
    router_tool_calling_agent_if_tool_name_eq_get_weather [label="router_tool_calling_agent_if_tool_name_eq_get_weather", fillcolor=wheat];
    router_tool_calling_agent_if_tool_name_eq_list_gcs_files [label="router_tool_calling_agent_if_tool_name_eq_list_gcs_files", fillcolor=wheat];
    router_tool_calling_agent_if_tool_name_eq_web_search [label="router_tool_calling_agent_if_tool_name_eq_web_search", fillcolor=wheat];
    router_tool_calling_agent_seq_set_iteration [label="router_tool_calling_agent_seq_set_iteration\n\np['iteration'] += 1", fillcolor=wheat];
    router_tool_calling_agent_seq_set_messages [label="router_tool_calling_agent_seq_set_messages\n\np['messages'] = p['messages'] + [{'role': 'tool', 'content': p['tool_result']}]", fillcolor=wheat];
    router_tool_calling_agent_while_loop [label="router_tool_calling_agent_while_loop", fillcolor=wheat];
    start_tool_calling_agent [label="start_tool_calling_agent\n\np['messages'] = p.get('messages', [])\np['iteration'] = 0", fillcolor=palegreen];
    web_search [label="web_search", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_tool_calling_agent -> router_tool_calling_agent_while_loop;
    router_tool_calling_agent_if_tool_name_eq_list_gcs_files -> list_gcs_files [label="p['tool_name'] == 'list_gcs_files'", color="#2E8B57", fontcolor="#2E8B57"];
    router_tool_calling_agent_if_tool_name_eq_calculate -> calculate [label="p['tool_name'] == 'calculate'", color="#2E8B57", fontcolor="#2E8B57"];
    router_tool_calling_agent_if_tool_name_eq_calculate -> router_tool_calling_agent_if_tool_name_eq_list_gcs_files [label="else", color="#D35400", fontcolor="#D35400"];
    router_tool_calling_agent_if_tool_name_eq_web_search -> web_search [label="p['tool_name'] == 'web_search'", color="#2E8B57", fontcolor="#2E8B57"];
    router_tool_calling_agent_if_tool_name_eq_web_search -> router_tool_calling_agent_if_tool_name_eq_calculate [label="else", color="#D35400", fontcolor="#D35400"];
    router_tool_calling_agent_if_tool_name_eq_get_weather -> get_weather [label="p['tool_name'] == 'get_weather'", color="#2E8B57", fontcolor="#2E8B57"];
    get_weather -> router_tool_calling_agent_seq_set_messages;
    router_tool_calling_agent_if_tool_name_eq_get_weather -> router_tool_calling_agent_if_tool_name_eq_web_search [label="else", color="#D35400", fontcolor="#D35400"];
    router_tool_calling_agent_if_not_tool_name -> router_tool_calling_agent_if_tool_name_eq_get_weather [label="else", color="#D35400", fontcolor="#D35400"];
    router_tool_calling_agent_if_not_tool_name -> format_response [label="not p.get('tool_name')", color="#2E8B57", fontcolor="#2E8B57"];
    router_tool_calling_agent_seq_set_iteration -> llm_reason;
    llm_reason -> router_tool_calling_agent_if_not_tool_name;
    router_tool_calling_agent_while_loop -> router_tool_calling_agent_seq_set_iteration;
    web_search -> router_tool_calling_agent_seq_set_messages;
    calculate -> router_tool_calling_agent_seq_set_messages;
    list_gcs_files -> router_tool_calling_agent_seq_set_messages;
    router_tool_calling_agent_seq_set_messages -> router_tool_calling_agent_while_loop;
    router_tool_calling_agent_if_tool_name_eq_list_gcs_files -> router_tool_calling_agent_while_loop [label="else", color="#D35400", fontcolor="#D35400"];
    format_response -> __end__;
}