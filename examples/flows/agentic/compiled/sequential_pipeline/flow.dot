digraph "sequential_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_sequential_pipeline; }

    data_analyst [label="data_analyst", fillcolor=lightblue];
    execution_planner [label="execution_planner", fillcolor=lightblue];
    risk_evaluator [label="risk_evaluator", fillcolor=lightsalmon];
    start_sequential_pipeline [label="start_sequential_pipeline", fillcolor=palegreen];
    trading_analyst [label="trading_analyst", fillcolor=lightblue];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_sequential_pipeline -> data_analyst;
    data_analyst -> trading_analyst;
    trading_analyst -> execution_planner;
    execution_planner -> risk_evaluator;
    risk_evaluator -> __end__;
}