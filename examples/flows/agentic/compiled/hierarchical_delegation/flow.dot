digraph "hierarchical_delegation" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_hierarchical_delegation; }

    api_specialist [label="api_specialist", fillcolor=lightblue];
    content_generalist [label="content_generalist", fillcolor=lightblue];
    content_team_lead [label="content_team_lead", fillcolor=lightblue];
    data_generalist [label="data_generalist", fillcolor=lightblue];
    data_team_lead [label="data_team_lead", fillcolor=lightblue];
    editor [label="editor", fillcolor=lightblue];
    final_assembler [label="final_assembler", fillcolor=lightsalmon];
    generalist [label="generalist", fillcolor=lightblue];
    root_agent [label="root_agent", fillcolor=lightblue];
    router_hierarchical_delegation_if_domain_eq_content [label="router_hierarchical_delegation_if_domain_eq_content", fillcolor=wheat];
    router_hierarchical_delegation_if_domain_eq_data [label="router_hierarchical_delegation_if_domain_eq_data", fillcolor=wheat];
    router_hierarchical_delegation_if_subtask_eq_api [label="router_hierarchical_delegation_if_subtask_eq_api", fillcolor=wheat];
    router_hierarchical_delegation_if_subtask_eq_edit [label="router_hierarchical_delegation_if_subtask_eq_edit", fillcolor=wheat];
    router_hierarchical_delegation_if_subtask_eq_sql [label="router_hierarchical_delegation_if_subtask_eq_sql", fillcolor=wheat];
    router_hierarchical_delegation_if_subtask_eq_write [label="router_hierarchical_delegation_if_subtask_eq_write", fillcolor=wheat];
    sql_specialist [label="sql_specialist", fillcolor=lightblue];
    start_hierarchical_delegation [label="start_hierarchical_delegation", fillcolor=palegreen];
    writer [label="writer", fillcolor=lightblue];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_hierarchical_delegation -> root_agent;
    root_agent -> router_hierarchical_delegation_if_domain_eq_data;
    router_hierarchical_delegation_if_subtask_eq_api -> api_specialist [label="p.get('subtask') == 'api'", color="#2E8B57", fontcolor="#2E8B57"];
    router_hierarchical_delegation_if_subtask_eq_api -> data_generalist [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_if_subtask_eq_sql -> sql_specialist [label="p.get('subtask') == 'sql'", color="#2E8B57", fontcolor="#2E8B57"];
    router_hierarchical_delegation_if_subtask_eq_sql -> router_hierarchical_delegation_if_subtask_eq_api [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_if_subtask_eq_edit -> editor [label="p.get('subtask') == 'edit'", color="#2E8B57", fontcolor="#2E8B57"];
    router_hierarchical_delegation_if_subtask_eq_edit -> content_generalist [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_if_subtask_eq_write -> writer [label="p.get('subtask') == 'write'", color="#2E8B57", fontcolor="#2E8B57"];
    router_hierarchical_delegation_if_subtask_eq_write -> router_hierarchical_delegation_if_subtask_eq_edit [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_if_domain_eq_content -> content_team_lead [label="p.get('domain') == 'content'", color="#2E8B57", fontcolor="#2E8B57"];
    content_team_lead -> router_hierarchical_delegation_if_subtask_eq_write;
    router_hierarchical_delegation_if_domain_eq_content -> generalist [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_if_domain_eq_data -> data_team_lead [label="p.get('domain') == 'data'", color="#2E8B57", fontcolor="#2E8B57"];
    data_team_lead -> router_hierarchical_delegation_if_subtask_eq_sql;
    router_hierarchical_delegation_if_domain_eq_data -> router_hierarchical_delegation_if_domain_eq_content [label="else", color="#D35400", fontcolor="#D35400"];
    sql_specialist -> final_assembler;
    generalist -> final_assembler;
    api_specialist -> final_assembler;
    data_generalist -> final_assembler;
    writer -> final_assembler;
    editor -> final_assembler;
    content_generalist -> final_assembler;
    final_assembler -> __end__;
}