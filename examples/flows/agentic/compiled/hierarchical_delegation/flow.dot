digraph "hierarchical_delegation" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_hierarchical_delegation; }

    api_specialist [label="api_specialist", fillcolor=lightblue];
    content_generalist [label="content_generalist", fillcolor=lightblue];
    content_team_lead [label="content_team_lead", fillcolor=lightblue];
    data_generalist [label="data_generalist", fillcolor=lightblue];
    data_team_lead [label="data_team_lead", fillcolor=lightblue];
    editor [label="editor", fillcolor=lightblue];
    final_assembler [label="final_assembler", fillcolor=lightsalmon];
    generalist [label="generalist", fillcolor=lightblue];
    root_agent [label="root_agent", fillcolor=lightblue];
    router_hierarchical_delegation_line_60_if_6 [label="router_hierarchical_delegation_line_60_if_6", fillcolor=wheat];
    router_hierarchical_delegation_line_64_if_2 [label="router_hierarchical_delegation_line_64_if_2", fillcolor=wheat];
    router_hierarchical_delegation_line_66_if_1 [label="router_hierarchical_delegation_line_66_if_1", fillcolor=wheat];
    router_hierarchical_delegation_line_71_if_5 [label="router_hierarchical_delegation_line_71_if_5", fillcolor=wheat];
    router_hierarchical_delegation_line_75_if_4 [label="router_hierarchical_delegation_line_75_if_4", fillcolor=wheat];
    router_hierarchical_delegation_line_77_if_3 [label="router_hierarchical_delegation_line_77_if_3", fillcolor=wheat];
    sql_specialist [label="sql_specialist", fillcolor=lightblue];
    start_hierarchical_delegation [label="start_hierarchical_delegation", fillcolor=palegreen];
    writer [label="writer", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_hierarchical_delegation -> root_agent;
    root_agent -> router_hierarchical_delegation_line_60_if_6;
    router_hierarchical_delegation_line_66_if_1 -> api_specialist [label="p.get('subtask') == 'api'", color="#2E8B57", fontcolor="#2E8B57"];
    router_hierarchical_delegation_line_66_if_1 -> data_generalist [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_line_64_if_2 -> sql_specialist [label="p.get('subtask') == 'sql'", color="#2E8B57", fontcolor="#2E8B57"];
    router_hierarchical_delegation_line_64_if_2 -> router_hierarchical_delegation_line_66_if_1 [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_line_77_if_3 -> editor [label="p.get('subtask') == 'edit'", color="#2E8B57", fontcolor="#2E8B57"];
    router_hierarchical_delegation_line_77_if_3 -> content_generalist [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_line_75_if_4 -> writer [label="p.get('subtask') == 'write'", color="#2E8B57", fontcolor="#2E8B57"];
    router_hierarchical_delegation_line_75_if_4 -> router_hierarchical_delegation_line_77_if_3 [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_line_71_if_5 -> content_team_lead [label="p.get('domain') == 'content'", color="#2E8B57", fontcolor="#2E8B57"];
    content_team_lead -> router_hierarchical_delegation_line_75_if_4;
    router_hierarchical_delegation_line_71_if_5 -> generalist [label="else", color="#D35400", fontcolor="#D35400"];
    router_hierarchical_delegation_line_60_if_6 -> data_team_lead [label="p.get('domain') == 'data'", color="#2E8B57", fontcolor="#2E8B57"];
    data_team_lead -> router_hierarchical_delegation_line_64_if_2;
    router_hierarchical_delegation_line_60_if_6 -> router_hierarchical_delegation_line_71_if_5 [label="else", color="#D35400", fontcolor="#D35400"];
    sql_specialist -> final_assembler;
    generalist -> final_assembler;
    api_specialist -> final_assembler;
    data_generalist -> final_assembler;
    writer -> final_assembler;
    editor -> final_assembler;
    content_generalist -> final_assembler;
    final_assembler -> __end__;
}