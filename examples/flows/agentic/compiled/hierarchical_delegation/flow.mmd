    start_hierarchical_delegation --> root_agent
    root_agent --> router_hierarchical_delegation_if_domain_eq_data
    router_hierarchical_delegation_if_subtask_eq_api -->|"p.get('subtask') == 'api'"| api_specialist
    router_hierarchical_delegation_if_subtask_eq_api -->|"else"| data_generalist
    router_hierarchical_delegation_if_subtask_eq_sql -->|"p.get('subtask') == 'sql'"| sql_specialist
    router_hierarchical_delegation_if_subtask_eq_sql -->|"else"| router_hierarchical_delegation_if_subtask_eq_api
    router_hierarchical_delegation_if_subtask_eq_edit -->|"p.get('subtask') == 'edit'"| editor
    router_hierarchical_delegation_if_subtask_eq_edit -->|"else"| content_generalist
    router_hierarchical_delegation_if_subtask_eq_write -->|"p.get('subtask') == 'write'"| writer
    router_hierarchical_delegation_if_subtask_eq_write -->|"else"| router_hierarchical_delegation_if_subtask_eq_edit
    router_hierarchical_delegation_if_domain_eq_content -->|"p.get('domain') == 'content'"| content_team_lead
    content_team_lead --> router_hierarchical_delegation_if_subtask_eq_write
    router_hierarchical_delegation_if_domain_eq_content -->|"else"| generalist
    router_hierarchical_delegation_if_domain_eq_data -->|"p.get('domain') == 'data'"| data_team_lead
    data_team_lead --> router_hierarchical_delegation_if_subtask_eq_sql
    router_hierarchical_delegation_if_domain_eq_data -->|"else"| router_hierarchical_delegation_if_domain_eq_content
    sql_specialist --> final_assembler
    generalist --> final_assembler
    api_specialist --> final_assembler
    data_generalist --> final_assembler
    writer --> final_assembler
    editor --> final_assembler
    content_generalist --> final_assembler
    final_assembler --> __end__

