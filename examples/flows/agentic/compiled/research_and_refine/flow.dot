digraph "research_and_refine" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_research_and_refine [label="end_research_and_refine", fillcolor=palegreen];
    router_research_and_refine_line_55_if_3 [label="router_research_and_refine_line_55_if_3", fillcolor=wheat];
    router_research_and_refine_line_59_if_2 [label="router_research_and_refine_line_59_if_2", fillcolor=wheat];
    write_report [label="write_report", fillcolor=lightblue];

    router_research_and_refine_line_59_if_2 -> write_report [label="p['iteration'] >= 5"];
    router_research_and_refine_line_55_if_3 -> write_report [label="not p.get('gaps') or p.get('quality_score', 0) >= 85"];
}