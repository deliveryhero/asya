digraph "research_and_refine" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_research_and_refine; }

    critic [label="critic", fillcolor=lightblue];
    refine_query [label="refine_query", fillcolor=lightblue];
    researcher [label="researcher", fillcolor=lightblue];
    router_research_and_refine_if_iteration_ge_5 [label="router_research_and_refine_if_iteration_ge_5", fillcolor=wheat];
    router_research_and_refine_if_not_gaps_or_quality_score_ge_85 [label="router_research_and_refine_if_not_gaps_or_quality_score_ge_85", fillcolor=wheat];
    router_research_and_refine_seq_set_iteration [label="router_research_and_refine_seq_set_iteration\n\np['iteration'] += 1", fillcolor=wheat];
    router_research_and_refine_while_loop [label="router_research_and_refine_while_loop", fillcolor=wheat];
    start_research_and_refine [label="start_research_and_refine\n\np['iteration'] = 0\np['search_query'] = p.get('question', '')", fillcolor=palegreen];
    write_report [label="write_report", fillcolor=lightsalmon];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_research_and_refine -> router_research_and_refine_while_loop;
    router_research_and_refine_if_iteration_ge_5 -> write_report [label="p['iteration'] >= 5", color="#2E8B57", fontcolor="#2E8B57"];
    router_research_and_refine_if_not_gaps_or_quality_score_ge_85 -> refine_query [label="else", color="#D35400", fontcolor="#D35400"];
    refine_query -> router_research_and_refine_if_iteration_ge_5;
    router_research_and_refine_if_not_gaps_or_quality_score_ge_85 -> write_report [label="not p.get('gaps') or p.get('quality_score', 0) >= 85", color="#2E8B57", fontcolor="#2E8B57"];
    router_research_and_refine_seq_set_iteration -> researcher;
    researcher -> critic;
    critic -> router_research_and_refine_if_not_gaps_or_quality_score_ge_85;
    router_research_and_refine_while_loop -> router_research_and_refine_seq_set_iteration;
    router_research_and_refine_if_iteration_ge_5 -> router_research_and_refine_while_loop [label="else", color="#D35400", fontcolor="#D35400"];
    write_report -> __end__;
}