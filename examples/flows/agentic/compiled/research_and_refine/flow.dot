digraph "research_and_refine" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_research_and_refine; }

    critic [label="critic", fillcolor=lightblue];
    refine_query [label="refine_query", fillcolor=lightblue];
    researcher [label="researcher", fillcolor=lightblue];
    router_research_and_refine_line_50_while_1 [label="router_research_and_refine_line_50_while_1", fillcolor=wheat];
    router_research_and_refine_line_51_seq_4 [label="router_research_and_refine_line_51_seq_4\n\np['iteration'] += 1", fillcolor=wheat];
    router_research_and_refine_line_55_if_3 [label="router_research_and_refine_line_55_if_3", fillcolor=wheat];
    router_research_and_refine_line_59_if_2 [label="router_research_and_refine_line_59_if_2", fillcolor=wheat];
    start_research_and_refine [label="start_research_and_refine\n\np['iteration'] = 0\np['search_query'] = p.get('question', '')", fillcolor=palegreen];
    write_report [label="write_report", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_research_and_refine -> router_research_and_refine_line_50_while_1;
    router_research_and_refine_line_59_if_2 -> write_report [label="p['iteration'] >= 5", color="#2E8B57", fontcolor="#2E8B57"];
    router_research_and_refine_line_55_if_3 -> refine_query [label="else", color="#E07040", fontcolor="#E07040"];
    refine_query -> router_research_and_refine_line_59_if_2;
    router_research_and_refine_line_55_if_3 -> write_report [label="not p.get('gaps') or p.get('quality_score', 0) >= 85", color="#2E8B57", fontcolor="#2E8B57"];
    router_research_and_refine_line_51_seq_4 -> researcher;
    researcher -> critic;
    critic -> router_research_and_refine_line_55_if_3;
    router_research_and_refine_line_50_while_1 -> router_research_and_refine_line_51_seq_4;
    router_research_and_refine_line_59_if_2 -> router_research_and_refine_line_50_while_1 [label="else", color="#E07040", fontcolor="#E07040"];
    write_report -> __end__;
}