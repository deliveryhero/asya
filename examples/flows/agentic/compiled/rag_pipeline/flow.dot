digraph "rag_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_rag_pipeline; }

    fact_checker [label="fact_checker", fillcolor=lightsalmon];
    generator [label="generator", fillcolor=lightblue];
    query_analyzer [label="query_analyzer", fillcolor=lightblue];
    query_refiner [label="query_refiner", fillcolor=lightblue];
    relevance_evaluator [label="relevance_evaluator", fillcolor=lightblue];
    retriever [label="retriever", fillcolor=lightblue];
    router_rag_pipeline_if_is_sufficient [label="router_rag_pipeline_if_is_sufficient", fillcolor=wheat];
    router_rag_pipeline_if_retrieval_attempts_ge_3 [label="router_rag_pipeline_if_retrieval_attempts_ge_3", fillcolor=wheat];
    router_rag_pipeline_seq_set_retrieval_attempts [label="router_rag_pipeline_seq_set_retrieval_attempts\n\np['retrieval_attempts'] += 1", fillcolor=wheat];
    router_rag_pipeline_while_loop [label="router_rag_pipeline_while_loop", fillcolor=wheat];
    start_rag_pipeline [label="start_rag_pipeline\n\np['retrieval_attempts'] = 0", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_rag_pipeline -> query_analyzer;
    query_analyzer -> router_rag_pipeline_while_loop;
    router_rag_pipeline_if_retrieval_attempts_ge_3 -> query_refiner [label="else", color="#D35400", fontcolor="#D35400"];
    router_rag_pipeline_if_retrieval_attempts_ge_3 -> generator [label="p['retrieval_attempts'] >= 3", color="#2E8B57", fontcolor="#2E8B57"];
    generator -> fact_checker;
    router_rag_pipeline_if_is_sufficient -> router_rag_pipeline_if_retrieval_attempts_ge_3 [label="else", color="#D35400", fontcolor="#D35400"];
    router_rag_pipeline_if_is_sufficient -> generator [label="p.get('is_sufficient')", color="#2E8B57", fontcolor="#2E8B57"];
    router_rag_pipeline_seq_set_retrieval_attempts -> retriever;
    retriever -> relevance_evaluator;
    relevance_evaluator -> router_rag_pipeline_if_is_sufficient;
    router_rag_pipeline_while_loop -> router_rag_pipeline_seq_set_retrieval_attempts;
    query_refiner -> router_rag_pipeline_while_loop;
    fact_checker -> __end__;
}