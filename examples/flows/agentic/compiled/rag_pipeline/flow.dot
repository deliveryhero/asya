digraph "rag_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_rag_pipeline [label="end_rag_pipeline", fillcolor=palegreen];
    fact_checker [label="fact_checker", fillcolor=lightblue];
    generator [label="generator", fillcolor=lightblue];
    query_analyzer [label="query_analyzer", fillcolor=lightblue];
    query_refiner [label="query_refiner", fillcolor=lightblue];
    relevance_evaluator [label="relevance_evaluator", fillcolor=lightblue];
    retriever [label="retriever", fillcolor=lightblue];
    router_rag_pipeline_line_50_seq_5 [label="router_rag_pipeline_line_50_seq_5", fillcolor=wheat];
    router_rag_pipeline_line_56_while_1 [label="router_rag_pipeline_line_56_while_1", fillcolor=wheat];
    router_rag_pipeline_line_57_seq_4 [label="router_rag_pipeline_line_57_seq_4", fillcolor=wheat];
    router_rag_pipeline_line_66_if_3 [label="router_rag_pipeline_line_66_if_3", fillcolor=wheat];
    router_rag_pipeline_line_70_if_2 [label="router_rag_pipeline_line_70_if_2", fillcolor=wheat];
    start_rag_pipeline [label="start_rag_pipeline", fillcolor=palegreen];

    start_rag_pipeline -> router_rag_pipeline_line_50_seq_5;
    router_rag_pipeline_line_70_if_2 -> query_refiner;
    router_rag_pipeline_line_70_if_2 -> generator [label="p['retrieval_attempts'] >= 3"];
    router_rag_pipeline_line_70_if_2 -> fact_checker [label="p['retrieval_attempts'] >= 3"];
    router_rag_pipeline_line_66_if_3 -> router_rag_pipeline_line_70_if_2;
    router_rag_pipeline_line_66_if_3 -> generator [label="p.get('is_sufficient')"];
    router_rag_pipeline_line_66_if_3 -> fact_checker [label="p.get('is_sufficient')"];
    router_rag_pipeline_line_57_seq_4 -> retriever;
    router_rag_pipeline_line_57_seq_4 -> relevance_evaluator;
    router_rag_pipeline_line_57_seq_4 -> router_rag_pipeline_line_66_if_3;
    router_rag_pipeline_line_56_while_1 -> router_rag_pipeline_line_57_seq_4;
    router_rag_pipeline_line_56_while_1 -> router_rag_pipeline_line_56_while_1;
    router_rag_pipeline_line_50_seq_5 -> query_analyzer;
    router_rag_pipeline_line_50_seq_5 -> router_rag_pipeline_line_56_while_1;
}