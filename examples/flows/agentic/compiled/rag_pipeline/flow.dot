digraph "rag_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_rag_pipeline [label="end_rag_pipeline", fillcolor=palegreen];
    fact_checker [label="fact_checker", fillcolor=lightblue];
    generator [label="generator", fillcolor=lightblue];
    router_rag_pipeline_line_66_if_3 [label="router_rag_pipeline_line_66_if_3", fillcolor=wheat];
    router_rag_pipeline_line_70_if_2 [label="router_rag_pipeline_line_70_if_2", fillcolor=wheat];

    router_rag_pipeline_line_70_if_2 -> generator [label="p['retrieval_attempts'] >= 3"];
    router_rag_pipeline_line_70_if_2 -> fact_checker [label="p['retrieval_attempts'] >= 3"];
    router_rag_pipeline_line_66_if_3 -> generator [label="p.get('is_sufficient')"];
    router_rag_pipeline_line_66_if_3 -> fact_checker [label="p.get('is_sufficient')"];
}