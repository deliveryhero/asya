digraph "multi_agent_debate" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_multi_agent_debate; }

    convergence_checker [label="convergence_checker", fillcolor=lightblue];
    debater_a [label="debater_a", fillcolor=lightblue];
    debater_b [label="debater_b", fillcolor=lightblue];
    debater_c [label="debater_c", fillcolor=lightblue];
    fanin_multi_agent_debate_positions [label="fanin_multi_agent_debate_positions", fillcolor=lightblue];
    fanin_multi_agent_debate_positions_2 [label="fanin_multi_agent_debate_positions_2", fillcolor=lightblue];
    final_judge [label="final_judge", fillcolor=lightsalmon];
    revise_a [label="revise_a", fillcolor=lightblue];
    revise_b [label="revise_b", fillcolor=lightblue];
    revise_c [label="revise_c", fillcolor=lightblue];
    router_multi_agent_debate_fanout_positions [label="router_multi_agent_debate_fanout_positions", fillcolor=wheat];
    router_multi_agent_debate_fanout_positions_2 [label="router_multi_agent_debate_fanout_positions_2", fillcolor=wheat];
    router_multi_agent_debate_if_converged [label="router_multi_agent_debate_if_converged", fillcolor=wheat];
    router_multi_agent_debate_if_round_ge_3 [label="router_multi_agent_debate_if_round_ge_3", fillcolor=wheat];
    router_multi_agent_debate_seq_set_round [label="router_multi_agent_debate_seq_set_round\n\np['round'] += 1", fillcolor=wheat];
    router_multi_agent_debate_while_loop [label="router_multi_agent_debate_while_loop", fillcolor=wheat];
    start_multi_agent_debate [label="start_multi_agent_debate\n\np['round'] = 0", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_multi_agent_debate -> router_multi_agent_debate_fanout_positions_2;
    router_multi_agent_debate_fanout_positions -> fanin_multi_agent_debate_positions [label="fanout", color="#6C35EA", fontcolor="#6C35EA"];
    router_multi_agent_debate_fanout_positions -> revise_a;
    revise_a -> fanin_multi_agent_debate_positions;
    router_multi_agent_debate_fanout_positions -> revise_b;
    revise_b -> fanin_multi_agent_debate_positions;
    router_multi_agent_debate_fanout_positions -> revise_c;
    revise_c -> fanin_multi_agent_debate_positions;
    router_multi_agent_debate_if_round_ge_3 -> router_multi_agent_debate_fanout_positions [label="else", color="#D35400", fontcolor="#D35400"];
    router_multi_agent_debate_if_round_ge_3 -> final_judge [label="p['round'] >= 3", color="#2E8B57", fontcolor="#2E8B57"];
    router_multi_agent_debate_if_converged -> router_multi_agent_debate_if_round_ge_3 [label="else", color="#D35400", fontcolor="#D35400"];
    router_multi_agent_debate_if_converged -> final_judge [label="p.get('converged')", color="#2E8B57", fontcolor="#2E8B57"];
    router_multi_agent_debate_seq_set_round -> convergence_checker;
    convergence_checker -> router_multi_agent_debate_if_converged;
    router_multi_agent_debate_while_loop -> router_multi_agent_debate_seq_set_round;
    router_multi_agent_debate_fanout_positions_2 -> fanin_multi_agent_debate_positions_2 [label="fanout", color="#6C35EA", fontcolor="#6C35EA"];
    fanin_multi_agent_debate_positions_2 -> router_multi_agent_debate_while_loop;
    router_multi_agent_debate_fanout_positions_2 -> debater_a;
    debater_a -> fanin_multi_agent_debate_positions_2;
    router_multi_agent_debate_fanout_positions_2 -> debater_b;
    debater_b -> fanin_multi_agent_debate_positions_2;
    router_multi_agent_debate_fanout_positions_2 -> debater_c;
    debater_c -> fanin_multi_agent_debate_positions_2;
    router_multi_agent_debate_fanout_positions -> router_multi_agent_debate_while_loop;
    fanin_multi_agent_debate_positions -> router_multi_agent_debate_while_loop;
    final_judge -> __end__;
}