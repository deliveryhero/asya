digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_multi_agent_debate [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await start_multi_agent_debate(p)</i></td></tr><tr><td bgcolor="white" align="left">p['round'] = 0</td></tr></table>>];
  fanout_multi_agent_debate_line_74 [fillcolor="lightblue", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanout_multi_agent_debate_line_74(p)</i></td></tr><tr><td bgcolor="mediumpurple2" align="center"><b>[fan-out:gather]</b></td></tr></table>>];
  router_multi_agent_debate_line_71_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_multi_agent_debate_line_71_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['round'] &gt;= 3</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  router_multi_agent_debate_line_68_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_multi_agent_debate_line_68_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p.get('converged')</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  router_multi_agent_debate_line_64_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_multi_agent_debate_line_64_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['round'] += 1</td></tr></table>>];
  router_multi_agent_debate_line_63_loop_back_0 [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_multi_agent_debate_line_63_lo…(p)</i></td></tr></table>>];
  fanout_multi_agent_debate_line_57 [fillcolor="lightblue", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanout_multi_agent_debate_line_57(p)</i></td></tr><tr><td bgcolor="mediumpurple2" align="center"><b>[fan-out:gather]</b></td></tr></table>>];
  end_multi_agent_debate [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await end_multi_agent_debate(p)</i></td></tr></table>>];
  convergence_checker [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await convergence_checker(p)</i></td></tr></table>>];
  debater_a [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await debater_a(p)</i></td></tr></table>>];
  debater_b [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await debater_b(p)</i></td></tr></table>>];
  debater_c [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await debater_c(p)</i></td></tr></table>>];
  fanin_multi_agent_debate_line_57 [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanin_multi_agent_debate_line_57(p)</i></td></tr><tr><td bgcolor="mediumpurple1" align="center"><b>[fan-in]</b></td></tr></table>>];
  fanin_multi_agent_debate_line_74 [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanin_multi_agent_debate_line_74(p)</i></td></tr><tr><td bgcolor="mediumpurple1" align="center"><b>[fan-in]</b></td></tr></table>>];
  final_judge [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await final_judge(p)</i></td></tr></table>>];
  revise_a [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await revise_a(p)</i></td></tr></table>>];
  revise_b [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await revise_b(p)</i></td></tr></table>>];
  revise_c [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await revise_c(p)</i></td></tr></table>>];

  convergence_checker -> router_multi_agent_debate_line_68_if;
  debater_a -> fanin_multi_agent_debate_line_57 [color=slateblue4, style=dashed];
  debater_b -> fanin_multi_agent_debate_line_57 [color=slateblue4, style=dashed];
  debater_c -> fanin_multi_agent_debate_line_57 [color=slateblue4, style=dashed];
  fanin_multi_agent_debate_line_57 -> router_multi_agent_debate_line_63_loop_back_0;
  fanin_multi_agent_debate_line_74 -> router_multi_agent_debate_line_63_loop_back_0;
  fanout_multi_agent_debate_line_57 -> debater_a [color=mediumpurple4, label="slice 1", style=bold];
  fanout_multi_agent_debate_line_57 -> debater_b [color=mediumpurple4, label="slice 2", style=bold];
  fanout_multi_agent_debate_line_57 -> debater_c [color=mediumpurple4, label="slice 3", style=bold];
  fanout_multi_agent_debate_line_57 -> fanin_multi_agent_debate_line_57 [color=mediumpurple4, label="slice 0\n(parent)", style=dashed];
  fanout_multi_agent_debate_line_74 -> fanin_multi_agent_debate_line_74 [color=mediumpurple4, label="slice 0\n(parent)", style=dashed];
  fanout_multi_agent_debate_line_74 -> revise_a [color=mediumpurple4, label="slice 1", style=bold];
  fanout_multi_agent_debate_line_74 -> revise_b [color=mediumpurple4, label="slice 2", style=bold];
  fanout_multi_agent_debate_line_74 -> revise_c [color=mediumpurple4, label="slice 3", style=bold];
  final_judge -> end_multi_agent_debate;
  revise_a -> fanin_multi_agent_debate_line_74 [color=slateblue4, style=dashed];
  revise_b -> fanin_multi_agent_debate_line_74 [color=slateblue4, style=dashed];
  revise_c -> fanin_multi_agent_debate_line_74 [color=slateblue4, style=dashed];
  router_multi_agent_debate_line_63_loop_back_0 -> router_multi_agent_debate_line_64_seq [constraint=false];
  router_multi_agent_debate_line_64_seq -> convergence_checker;
  router_multi_agent_debate_line_68_if -> final_judge [label="T", color=darkseagreen4];
  router_multi_agent_debate_line_68_if -> router_multi_agent_debate_line_71_if [label="F", color=indianred4];
  router_multi_agent_debate_line_71_if -> fanout_multi_agent_debate_line_74 [label="F", color=indianred4];
  router_multi_agent_debate_line_71_if -> final_judge [label="T", color=darkseagreen4];
  start_multi_agent_debate -> fanout_multi_agent_debate_line_57;
}