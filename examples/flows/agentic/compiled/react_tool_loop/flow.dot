digraph "react_tool_loop" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    calculator [label="calculator", fillcolor=lightblue];
    code_exec [label="code_exec", fillcolor=lightblue];
    end_react_tool_loop [label="end_react_tool_loop", fillcolor=palegreen];
    format_response [label="format_response", fillcolor=lightblue];
    llm_reason [label="llm_reason", fillcolor=lightblue];
    router_react_tool_loop_line_46_loop_back_0 [label="router_react_tool_loop_line_46_loop_back_0", fillcolor=wheat];
    router_react_tool_loop_line_47_seq [label="router_react_tool_loop_line_47_seq", fillcolor=wheat];
    router_react_tool_loop_line_53_if [label="router_react_tool_loop_line_53_if", fillcolor=wheat];
    router_react_tool_loop_line_59_if [label="router_react_tool_loop_line_59_if", fillcolor=wheat];
    router_react_tool_loop_line_61_if [label="router_react_tool_loop_line_61_if", fillcolor=wheat];
    router_react_tool_loop_line_63_if [label="router_react_tool_loop_line_63_if", fillcolor=wheat];
    router_react_tool_loop_line_66_seq [label="router_react_tool_loop_line_66_seq", fillcolor=wheat];
    router_react_tool_loop_line_72_if [label="router_react_tool_loop_line_72_if", fillcolor=wheat];
    start_react_tool_loop [label="start_react_tool_loop", fillcolor=palegreen];
    web_search [label="web_search", fillcolor=lightblue];

    start_react_tool_loop -> router_react_tool_loop_line_46_loop_back_0;
    router_react_tool_loop_line_66_seq -> router_react_tool_loop_line_72_if;
    router_react_tool_loop_line_63_if -> calculator [label="p['tool_name'] == 'calculator'"];
    calculator -> router_react_tool_loop_line_72_if;
    router_react_tool_loop_line_63_if -> router_react_tool_loop_line_66_seq [label="not (p['tool_name'] == 'calculator')"];
    router_react_tool_loop_line_61_if -> code_exec [label="p['tool_name'] == 'code_exec'"];
    code_exec -> router_react_tool_loop_line_72_if;
    router_react_tool_loop_line_61_if -> router_react_tool_loop_line_63_if [label="not (p['tool_name'] == 'code_exec')"];
    router_react_tool_loop_line_72_if -> format_response [label="p['iteration'] >= 10"];
    router_react_tool_loop_line_59_if -> web_search [label="p['tool_name'] == 'web_search'"];
    web_search -> router_react_tool_loop_line_72_if;
    router_react_tool_loop_line_59_if -> router_react_tool_loop_line_61_if [label="not (p['tool_name'] == 'web_search')"];
    router_react_tool_loop_line_53_if -> format_response [label="not p.get('tool_calls')"];
    router_react_tool_loop_line_53_if -> router_react_tool_loop_line_59_if [label="not (not p.get('tool_calls'))"];
    router_react_tool_loop_line_47_seq -> llm_reason;
    llm_reason -> router_react_tool_loop_line_53_if;
    router_react_tool_loop_line_46_loop_back_0 -> router_react_tool_loop_line_47_seq;
    router_react_tool_loop_line_53_if -> router_react_tool_loop_line_46_loop_back_0;
    format_response -> end_react_tool_loop;
}