digraph "react_tool_loop" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_react_tool_loop; }

    calculator [label="calculator", fillcolor=lightblue];
    code_exec [label="code_exec", fillcolor=lightblue];
    format_response [label="format_response", fillcolor=lightsalmon];
    llm_reason [label="llm_reason", fillcolor=lightblue];
    router_react_tool_loop_line_49_while_1 [label="router_react_tool_loop_line_49_while_1", fillcolor=wheat];
    router_react_tool_loop_line_50_seq_8 [label="router_react_tool_loop_line_50_seq_8\n\np['iteration'] += 1", fillcolor=wheat];
    router_react_tool_loop_line_56_if_7 [label="router_react_tool_loop_line_56_if_7", fillcolor=wheat];
    router_react_tool_loop_line_62_if_6 [label="router_react_tool_loop_line_62_if_6\n\np['tool_name'] = p['tool_calls'][0]['name']", fillcolor=wheat];
    router_react_tool_loop_line_64_if_5 [label="router_react_tool_loop_line_64_if_5", fillcolor=wheat];
    router_react_tool_loop_line_66_if_4 [label="router_react_tool_loop_line_66_if_4", fillcolor=wheat];
    router_react_tool_loop_line_69_seq_3 [label="router_react_tool_loop_line_69_seq_3\n\np['observation'] = 'Unknown tool'", fillcolor=wheat];
    router_react_tool_loop_line_75_if_2 [label="router_react_tool_loop_line_75_if_2\n\np['messages'] = p.get('messages', [])", fillcolor=wheat];
    start_react_tool_loop [label="start_react_tool_loop\n\np['messages'] = p.get('messages', [])\np['iteration'] = 0", fillcolor=palegreen];
    web_search [label="web_search", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_react_tool_loop -> router_react_tool_loop_line_49_while_1;
    router_react_tool_loop_line_75_if_2 -> format_response [label="p['iteration'] >= 10", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_tool_loop_line_66_if_4 -> calculator [label="p['tool_name'] == 'calculator'", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_tool_loop_line_66_if_4 -> router_react_tool_loop_line_69_seq_3 [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_tool_loop_line_64_if_5 -> code_exec [label="p['tool_name'] == 'code_exec'", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_tool_loop_line_64_if_5 -> router_react_tool_loop_line_66_if_4 [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_tool_loop_line_62_if_6 -> web_search [label="p['tool_name'] == 'web_search'", color="#2E8B57", fontcolor="#2E8B57"];
    web_search -> router_react_tool_loop_line_75_if_2;
    router_react_tool_loop_line_62_if_6 -> router_react_tool_loop_line_64_if_5 [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_tool_loop_line_56_if_7 -> router_react_tool_loop_line_62_if_6 [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_tool_loop_line_56_if_7 -> format_response [label="not p.get('tool_calls')", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_tool_loop_line_50_seq_8 -> llm_reason;
    llm_reason -> router_react_tool_loop_line_56_if_7;
    router_react_tool_loop_line_49_while_1 -> router_react_tool_loop_line_50_seq_8;
    code_exec -> router_react_tool_loop_line_75_if_2;
    calculator -> router_react_tool_loop_line_75_if_2;
    router_react_tool_loop_line_69_seq_3 -> router_react_tool_loop_line_75_if_2;
    router_react_tool_loop_line_75_if_2 -> router_react_tool_loop_line_49_while_1 [label="else", color="#D35400", fontcolor="#D35400"];
    format_response -> __end__;
}