digraph "react_tool_loop" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_react_tool_loop; }

    calculator [label="calculator", fillcolor=lightblue];
    code_exec [label="code_exec", fillcolor=lightblue];
    format_response [label="format_response", fillcolor=lightsalmon];
    llm_reason [label="llm_reason", fillcolor=lightblue];
    router_react_tool_loop_if_iteration_ge_10 [label="router_react_tool_loop_if_iteration_ge_10\n\np['messages'] = p.get('messages', [])", fillcolor=wheat];
    router_react_tool_loop_if_not_tool_calls [label="router_react_tool_loop_if_not_tool_calls", fillcolor=wheat];
    router_react_tool_loop_if_tool_name_eq_calculator [label="router_react_tool_loop_if_tool_name_eq_calculator", fillcolor=wheat];
    router_react_tool_loop_if_tool_name_eq_code_exec [label="router_react_tool_loop_if_tool_name_eq_code_exec", fillcolor=wheat];
    router_react_tool_loop_if_tool_name_eq_web_search [label="router_react_tool_loop_if_tool_name_eq_web_search\n\np['tool_name'] = p['tool_calls'][0]['name']", fillcolor=wheat];
    router_react_tool_loop_seq_set_iteration [label="router_react_tool_loop_seq_set_iteration\n\np['iteration'] += 1", fillcolor=wheat];
    router_react_tool_loop_seq_set_observation [label="router_react_tool_loop_seq_set_observation\n\np['observation'] = 'Unknown tool'", fillcolor=wheat];
    router_react_tool_loop_while_loop [label="router_react_tool_loop_while_loop", fillcolor=wheat];
    start_react_tool_loop [label="start_react_tool_loop\n\np['messages'] = p.get('messages', [])\np['iteration'] = 0", fillcolor=palegreen];
    web_search [label="web_search", fillcolor=lightblue];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_react_tool_loop -> router_react_tool_loop_while_loop;
    router_react_tool_loop_if_iteration_ge_10 -> format_response [label="p['iteration'] >= 10", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_tool_loop_if_tool_name_eq_calculator -> calculator [label="p['tool_name'] == 'calculator'", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_tool_loop_if_tool_name_eq_calculator -> router_react_tool_loop_seq_set_observation [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_tool_loop_if_tool_name_eq_code_exec -> code_exec [label="p['tool_name'] == 'code_exec'", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_tool_loop_if_tool_name_eq_code_exec -> router_react_tool_loop_if_tool_name_eq_calculator [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_tool_loop_if_tool_name_eq_web_search -> web_search [label="p['tool_name'] == 'web_search'", color="#2E8B57", fontcolor="#2E8B57"];
    web_search -> router_react_tool_loop_if_iteration_ge_10;
    router_react_tool_loop_if_tool_name_eq_web_search -> router_react_tool_loop_if_tool_name_eq_code_exec [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_tool_loop_if_not_tool_calls -> router_react_tool_loop_if_tool_name_eq_web_search [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_tool_loop_if_not_tool_calls -> format_response [label="not p.get('tool_calls')", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_tool_loop_seq_set_iteration -> llm_reason;
    llm_reason -> router_react_tool_loop_if_not_tool_calls;
    router_react_tool_loop_while_loop -> router_react_tool_loop_seq_set_iteration;
    code_exec -> router_react_tool_loop_if_iteration_ge_10;
    calculator -> router_react_tool_loop_if_iteration_ge_10;
    router_react_tool_loop_seq_set_observation -> router_react_tool_loop_if_iteration_ge_10;
    router_react_tool_loop_if_iteration_ge_10 -> router_react_tool_loop_while_loop [label="else", color="#D35400", fontcolor="#D35400"];
    format_response -> __end__;
}