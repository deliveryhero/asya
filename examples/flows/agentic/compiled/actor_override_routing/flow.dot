digraph "actor_override_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_actor_override_flow; }

    audit_logger [label="audit_logger", fillcolor=lightblue];
    classify [label="classify", fillcolor=lightblue];
    escalate [label="escalate", fillcolor=lightsalmon];
    format_output [label="format_output", fillcolor=lightsalmon];
    router_actor_override_flow_if_needs_tool [label="router_actor_override_flow_if_needs_tool", fillcolor=wheat];
    start_actor_override_flow [label="start_actor_override_flow", fillcolor=palegreen];
    tool_executor [label="tool_executor", fillcolor=lightblue];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_actor_override_flow -> classify;
    router_actor_override_flow_if_needs_tool -> tool_executor [label="p.get('needs_tool')", color="#2E8B57", fontcolor="#2E8B57"];
    tool_executor -> format_output;
    router_actor_override_flow_if_needs_tool -> format_output [label="else", color="#D35400", fontcolor="#D35400"];
    classify -> escalate [label="p.get('urgent')\n[ABORT]", color="#00B84D", fontcolor="#00B84D"];
    classify -> audit_logger [label="else", color="#FF5500", fontcolor="#FF5500"];
    audit_logger -> router_actor_override_flow_if_needs_tool;
    escalate -> __end__;
    format_output -> __end__;
}