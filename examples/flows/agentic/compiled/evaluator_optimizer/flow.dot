digraph "evaluator_optimizer" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_evaluator_optimizer [label="end_evaluator_optimizer", fillcolor=palegreen];
    evaluator [label="evaluator", fillcolor=lightblue];
    generator [label="generator", fillcolor=lightblue];
    polisher [label="polisher", fillcolor=lightblue];
    router_evaluator_optimizer_line_56_seq_5 [label="router_evaluator_optimizer_line_56_seq_5", fillcolor=wheat];
    router_evaluator_optimizer_line_58_while_1 [label="router_evaluator_optimizer_line_58_while_1", fillcolor=wheat];
    router_evaluator_optimizer_line_59_seq_4 [label="router_evaluator_optimizer_line_59_seq_4", fillcolor=wheat];
    router_evaluator_optimizer_line_68_if_3 [label="router_evaluator_optimizer_line_68_if_3", fillcolor=wheat];
    router_evaluator_optimizer_line_72_if_2 [label="router_evaluator_optimizer_line_72_if_2", fillcolor=wheat];
    start_evaluator_optimizer [label="start_evaluator_optimizer", fillcolor=palegreen];

    start_evaluator_optimizer -> router_evaluator_optimizer_line_56_seq_5;
    router_evaluator_optimizer_line_72_if_2 -> polisher [label="p['iteration'] >= MAX_ITERATIONS"];
    router_evaluator_optimizer_line_68_if_3 -> router_evaluator_optimizer_line_72_if_2 [label="not (p.get('score', 0) >= SCORE_THRESHOLD)"];
    router_evaluator_optimizer_line_68_if_3 -> polisher [label="p.get('score', 0) >= SCORE_THRESHOLD"];
    router_evaluator_optimizer_line_59_seq_4 -> generator;
    router_evaluator_optimizer_line_59_seq_4 -> evaluator;
    router_evaluator_optimizer_line_59_seq_4 -> router_evaluator_optimizer_line_68_if_3;
    router_evaluator_optimizer_line_58_while_1 -> router_evaluator_optimizer_line_59_seq_4;
    router_evaluator_optimizer_line_58_while_1 -> router_evaluator_optimizer_line_58_while_1;
    router_evaluator_optimizer_line_56_seq_5 -> router_evaluator_optimizer_line_58_while_1;
}