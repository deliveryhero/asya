digraph "evaluator_optimizer" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_evaluator_optimizer; }

    evaluator [label="evaluator", fillcolor=lightblue];
    generator [label="generator", fillcolor=lightblue];
    polisher [label="polisher", fillcolor=lightsalmon];
    router_evaluator_optimizer_if_iteration_ge_max_iterations [label="router_evaluator_optimizer_if_iteration_ge_max_iterations", fillcolor=wheat];
    router_evaluator_optimizer_if_score_ge_score_threshold [label="router_evaluator_optimizer_if_score_ge_score_threshold", fillcolor=wheat];
    router_evaluator_optimizer_seq_set_iteration [label="router_evaluator_optimizer_seq_set_iteration\n\np['iteration'] += 1", fillcolor=wheat];
    router_evaluator_optimizer_while_loop [label="router_evaluator_optimizer_while_loop", fillcolor=wheat];
    start_evaluator_optimizer [label="start_evaluator_optimizer\n\np['iteration'] = 0", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_evaluator_optimizer -> router_evaluator_optimizer_while_loop;
    router_evaluator_optimizer_if_iteration_ge_max_iterations -> polisher [label="p['iteration'] >= MAX_ITERATIONS", color="#2E8B57", fontcolor="#2E8B57"];
    router_evaluator_optimizer_if_score_ge_score_threshold -> router_evaluator_optimizer_if_iteration_ge_max_iterations [label="else", color="#D35400", fontcolor="#D35400"];
    router_evaluator_optimizer_if_score_ge_score_threshold -> polisher [label="p.get('score', 0) >= SCORE_THRESHOLD", color="#2E8B57", fontcolor="#2E8B57"];
    router_evaluator_optimizer_seq_set_iteration -> generator;
    generator -> evaluator;
    evaluator -> router_evaluator_optimizer_if_score_ge_score_threshold;
    router_evaluator_optimizer_while_loop -> router_evaluator_optimizer_seq_set_iteration;
    router_evaluator_optimizer_if_iteration_ge_max_iterations -> router_evaluator_optimizer_while_loop [label="else", color="#D35400", fontcolor="#D35400"];
    polisher -> __end__;
}