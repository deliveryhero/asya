digraph "evaluator_optimizer" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_evaluator_optimizer [label="end_evaluator_optimizer", fillcolor=palegreen];
    polisher [label="polisher", fillcolor=lightblue];
    router_evaluator_optimizer_line_68_if_3 [label="router_evaluator_optimizer_line_68_if_3", fillcolor=wheat];
    router_evaluator_optimizer_line_72_if_2 [label="router_evaluator_optimizer_line_72_if_2", fillcolor=wheat];

    router_evaluator_optimizer_line_72_if_2 -> polisher [label="p['iteration'] >= MAX_ITERATIONS"];
    router_evaluator_optimizer_line_68_if_3 -> polisher [label="p.get('score', 0) >= SCORE_THRESHOLD"];
}