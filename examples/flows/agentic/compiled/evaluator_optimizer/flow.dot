digraph "evaluator_optimizer" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_evaluator_optimizer; }

    evaluator [label="evaluator", fillcolor=lightblue];
    generator [label="generator", fillcolor=lightblue];
    polisher [label="polisher", fillcolor=lightblue];
    router_evaluator_optimizer_line_58_while_1 [label="router_evaluator_optimizer_line_58_while_1", fillcolor=wheat];
    router_evaluator_optimizer_line_59_seq_4 [label="router_evaluator_optimizer_line_59_seq_4\n\np['iteration'] += 1", fillcolor=wheat];
    router_evaluator_optimizer_line_68_if_3 [label="router_evaluator_optimizer_line_68_if_3", fillcolor=wheat];
    router_evaluator_optimizer_line_72_if_2 [label="router_evaluator_optimizer_line_72_if_2", fillcolor=wheat];
    start_evaluator_optimizer [label="start_evaluator_optimizer\n\np['iteration'] = 0", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_evaluator_optimizer -> router_evaluator_optimizer_line_58_while_1;
    router_evaluator_optimizer_line_72_if_2 -> polisher [label="p['iteration'] >= MAX_ITERATIONS", color="#2E8B57", fontcolor="#2E8B57"];
    router_evaluator_optimizer_line_68_if_3 -> router_evaluator_optimizer_line_72_if_2 [label="else", color="#E07040", fontcolor="#E07040"];
    router_evaluator_optimizer_line_68_if_3 -> polisher [label="p.get('score', 0) >= SCORE_THRESHOLD", color="#2E8B57", fontcolor="#2E8B57"];
    router_evaluator_optimizer_line_59_seq_4 -> generator;
    generator -> evaluator;
    evaluator -> router_evaluator_optimizer_line_68_if_3;
    router_evaluator_optimizer_line_58_while_1 -> router_evaluator_optimizer_line_59_seq_4;
    router_evaluator_optimizer_line_72_if_2 -> router_evaluator_optimizer_line_58_while_1;
    polisher -> __end__;
}