digraph "orchestrator_workers" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    analysis_worker [label="analysis_worker", fillcolor=lightblue];
    data_worker [label="data_worker", fillcolor=lightblue];
    end_orchestrator_workers [label="end_orchestrator_workers", fillcolor=palegreen];
    orchestrator [label="orchestrator", fillcolor=lightblue];
    router_orchestrator_workers_line_54_seq_8 [label="router_orchestrator_workers_line_54_seq_8", fillcolor=wheat];
    router_orchestrator_workers_line_57_while_1 [label="router_orchestrator_workers_line_57_while_1", fillcolor=wheat];
    router_orchestrator_workers_line_58_seq_7 [label="router_orchestrator_workers_line_58_seq_7", fillcolor=wheat];
    router_orchestrator_workers_line_62_if_6 [label="router_orchestrator_workers_line_62_if_6", fillcolor=wheat];
    router_orchestrator_workers_line_65_if_5 [label="router_orchestrator_workers_line_65_if_5", fillcolor=wheat];
    router_orchestrator_workers_line_67_if_4 [label="router_orchestrator_workers_line_67_if_4", fillcolor=wheat];
    router_orchestrator_workers_line_69_if_3 [label="router_orchestrator_workers_line_69_if_3", fillcolor=wheat];
    router_orchestrator_workers_line_72_if_2 [label="router_orchestrator_workers_line_72_if_2", fillcolor=wheat];
    start_orchestrator_workers [label="start_orchestrator_workers", fillcolor=palegreen];
    synthesizer [label="synthesizer", fillcolor=lightblue];
    writing_worker [label="writing_worker", fillcolor=lightblue];

    start_orchestrator_workers -> router_orchestrator_workers_line_54_seq_8;
    router_orchestrator_workers_line_72_if_2 -> synthesizer [label="p['iteration'] >= 10"];
    router_orchestrator_workers_line_69_if_3 -> writing_worker [label="p.get('next_action') == 'write'"];
    router_orchestrator_workers_line_67_if_4 -> analysis_worker [label="p.get('next_action') == 'analyze'"];
    router_orchestrator_workers_line_67_if_4 -> router_orchestrator_workers_line_69_if_3 [label="not (p.get('next_action') == 'analyze')"];
    router_orchestrator_workers_line_65_if_5 -> data_worker [label="p.get('next_action') == 'research'"];
    router_orchestrator_workers_line_65_if_5 -> router_orchestrator_workers_line_72_if_2 [label="p.get('next_action') == 'research'"];
    router_orchestrator_workers_line_65_if_5 -> router_orchestrator_workers_line_67_if_4 [label="not (p.get('next_action') == 'research')"];
    router_orchestrator_workers_line_65_if_5 -> router_orchestrator_workers_line_72_if_2 [label="not (p.get('next_action') == 'research')"];
    router_orchestrator_workers_line_62_if_6 -> router_orchestrator_workers_line_65_if_5 [label="not (p.get('is_complete'))"];
    router_orchestrator_workers_line_62_if_6 -> synthesizer [label="p.get('is_complete')"];
    router_orchestrator_workers_line_58_seq_7 -> orchestrator;
    router_orchestrator_workers_line_58_seq_7 -> router_orchestrator_workers_line_62_if_6;
    router_orchestrator_workers_line_57_while_1 -> router_orchestrator_workers_line_58_seq_7;
    router_orchestrator_workers_line_57_while_1 -> router_orchestrator_workers_line_57_while_1;
    router_orchestrator_workers_line_54_seq_8 -> router_orchestrator_workers_line_57_while_1;
}