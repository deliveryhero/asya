digraph "orchestrator_workers" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_orchestrator_workers; }

    analysis_worker [label="analysis_worker", fillcolor=lightblue];
    data_worker [label="data_worker", fillcolor=lightblue];
    orchestrator [label="orchestrator", fillcolor=lightblue];
    router_orchestrator_workers_line_57_while_1 [label="router_orchestrator_workers_line_57_while_1", fillcolor=wheat];
    router_orchestrator_workers_line_58_seq_7 [label="router_orchestrator_workers_line_58_seq_7\n\np['iteration'] += 1", fillcolor=wheat];
    router_orchestrator_workers_line_62_if_6 [label="router_orchestrator_workers_line_62_if_6", fillcolor=wheat];
    router_orchestrator_workers_line_65_if_5 [label="router_orchestrator_workers_line_65_if_5", fillcolor=wheat];
    router_orchestrator_workers_line_67_if_4 [label="router_orchestrator_workers_line_67_if_4", fillcolor=wheat];
    router_orchestrator_workers_line_69_if_3 [label="router_orchestrator_workers_line_69_if_3", fillcolor=wheat];
    router_orchestrator_workers_line_72_if_2 [label="router_orchestrator_workers_line_72_if_2", fillcolor=wheat];
    start_orchestrator_workers [label="start_orchestrator_workers\n\np['iteration'] = 0\np['worker_results'] = []", fillcolor=palegreen];
    synthesizer [label="synthesizer", fillcolor=lightblue];
    writing_worker [label="writing_worker", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_orchestrator_workers -> router_orchestrator_workers_line_57_while_1;
    router_orchestrator_workers_line_72_if_2 -> synthesizer [label="p['iteration'] >= 10", color="#2E8B57", fontcolor="#2E8B57"];
    router_orchestrator_workers_line_69_if_3 -> writing_worker [label="p.get('next_action') == 'write'", color="#2E8B57", fontcolor="#2E8B57"];
    router_orchestrator_workers_line_67_if_4 -> analysis_worker [label="p.get('next_action') == 'analyze'", color="#2E8B57", fontcolor="#2E8B57"];
    router_orchestrator_workers_line_67_if_4 -> router_orchestrator_workers_line_69_if_3 [label="else", color="#E07040", fontcolor="#E07040"];
    router_orchestrator_workers_line_65_if_5 -> data_worker [label="p.get('next_action') == 'research'", color="#2E8B57", fontcolor="#2E8B57"];
    data_worker -> router_orchestrator_workers_line_72_if_2;
    router_orchestrator_workers_line_65_if_5 -> router_orchestrator_workers_line_67_if_4 [label="else", color="#E07040", fontcolor="#E07040"];
    router_orchestrator_workers_line_62_if_6 -> router_orchestrator_workers_line_65_if_5 [label="else", color="#E07040", fontcolor="#E07040"];
    router_orchestrator_workers_line_62_if_6 -> synthesizer [label="p.get('is_complete')", color="#2E8B57", fontcolor="#2E8B57"];
    router_orchestrator_workers_line_58_seq_7 -> orchestrator;
    orchestrator -> router_orchestrator_workers_line_62_if_6;
    router_orchestrator_workers_line_57_while_1 -> router_orchestrator_workers_line_58_seq_7;
    analysis_worker -> router_orchestrator_workers_line_72_if_2;
    writing_worker -> router_orchestrator_workers_line_72_if_2;
    router_orchestrator_workers_line_72_if_2 -> router_orchestrator_workers_line_57_while_1 [label="else", color="#E07040", fontcolor="#E07040"];
    router_orchestrator_workers_line_69_if_3 -> router_orchestrator_workers_line_57_while_1 [label="else", color="#E07040", fontcolor="#E07040"];
    synthesizer -> __end__;
}