digraph "orchestrator_workers" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_orchestrator_workers; }

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];
    analysis_worker [label="analysis_worker", fillcolor=lightblue];
    data_worker [label="data_worker", fillcolor=lightblue];
    orchestrator [label="orchestrator", fillcolor=lightblue];
    router_orchestrator_workers_if_is_complete [label="router_orchestrator_workers_if_is_complete", fillcolor=wheat];
    router_orchestrator_workers_if_iteration_ge_10 [label="router_orchestrator_workers_if_iteration_ge_10", fillcolor=wheat];
    router_orchestrator_workers_if_next_action_eq_analyze [label="router_orchestrator_workers_if_next_action_eq_analyze", fillcolor=wheat];
    router_orchestrator_workers_if_next_action_eq_research [label="router_orchestrator_workers_if_next_action_eq_research", fillcolor=wheat];
    router_orchestrator_workers_if_next_action_eq_write [label="router_orchestrator_workers_if_next_action_eq_write", fillcolor=wheat];
    router_orchestrator_workers_seq_set_iteration [label="router_orchestrator_workers_seq_set_iteration\n\np['iteration'] += 1", fillcolor=wheat];
    router_orchestrator_workers_while_loop [label="router_orchestrator_workers_while_loop", fillcolor=wheat];
    start_orchestrator_workers [label="start_orchestrator_workers\n\np['iteration'] = 0\np['worker_results'] = []", fillcolor=palegreen];
    synthesizer [label="synthesizer", fillcolor=lightsalmon];
    writing_worker [label="writing_worker", fillcolor=lightblue];

    start_orchestrator_workers -> router_orchestrator_workers_while_loop;
    router_orchestrator_workers_if_iteration_ge_10 -> synthesizer [label="p['iteration'] >= 10", color="#2E8B57", fontcolor="#2E8B57"];
    router_orchestrator_workers_if_next_action_eq_write -> writing_worker [label="p.get('next_action') == 'write'", color="#2E8B57", fontcolor="#2E8B57"];
    router_orchestrator_workers_if_next_action_eq_analyze -> analysis_worker [label="p.get('next_action') == 'analyze'", color="#2E8B57", fontcolor="#2E8B57"];
    router_orchestrator_workers_if_next_action_eq_analyze -> router_orchestrator_workers_if_next_action_eq_write [label="else", color="#D35400", fontcolor="#D35400"];
    router_orchestrator_workers_if_next_action_eq_research -> data_worker [label="p.get('next_action') == 'research'", color="#2E8B57", fontcolor="#2E8B57"];
    data_worker -> router_orchestrator_workers_if_iteration_ge_10;
    router_orchestrator_workers_if_next_action_eq_research -> router_orchestrator_workers_if_next_action_eq_analyze [label="else", color="#D35400", fontcolor="#D35400"];
    router_orchestrator_workers_if_is_complete -> router_orchestrator_workers_if_next_action_eq_research [label="else", color="#D35400", fontcolor="#D35400"];
    router_orchestrator_workers_if_is_complete -> synthesizer [label="p.get('is_complete')", color="#2E8B57", fontcolor="#2E8B57"];
    router_orchestrator_workers_seq_set_iteration -> orchestrator;
    orchestrator -> router_orchestrator_workers_if_is_complete;
    router_orchestrator_workers_while_loop -> router_orchestrator_workers_seq_set_iteration;
    analysis_worker -> router_orchestrator_workers_if_iteration_ge_10;
    writing_worker -> router_orchestrator_workers_if_iteration_ge_10;
    router_orchestrator_workers_if_iteration_ge_10 -> router_orchestrator_workers_while_loop [label="else", color="#D35400", fontcolor="#D35400"];
    router_orchestrator_workers_if_next_action_eq_write -> __end__ [label="else", color="#D35400", fontcolor="#D35400"];
    synthesizer -> __end__;
}