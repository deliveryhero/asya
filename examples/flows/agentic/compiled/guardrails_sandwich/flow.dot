digraph "guardrails_sandwich" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_guardrails_sandwich; }

    core_agent [label="core_agent", fillcolor=lightblue];
    input_validator [label="input_validator", fillcolor=lightblue];
    output_validator [label="output_validator", fillcolor=lightblue];
    router_guardrails_sandwich_except_exception [label="router_guardrails_sandwich_except_exception", fillcolor=wheat];
    safe_fallback [label="safe_fallback", fillcolor=lightsalmon];
    start_guardrails_sandwich [label="start_guardrails_sandwich", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_guardrails_sandwich -> input_validator;
    input_validator -> core_agent;
    core_agent -> output_validator;
    router_guardrails_sandwich_except_exception -> safe_fallback;
    input_validator -> router_guardrails_sandwich_except_exception [label="Exception", color="#DC143C", fontcolor="#DC143C"];
    core_agent -> router_guardrails_sandwich_except_exception [label="Exception", color="#DC143C", fontcolor="#DC143C"];
    output_validator -> router_guardrails_sandwich_except_exception [label="Exception", color="#DC143C", fontcolor="#DC143C"];
    safe_fallback -> __end__;
}