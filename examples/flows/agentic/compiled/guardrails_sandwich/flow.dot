digraph "guardrails_sandwich" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    core_agent [label="core_agent", fillcolor=lightblue];
    end_guardrails_sandwich [label="end_guardrails_sandwich", fillcolor=palegreen];
    input_validator [label="input_validator", fillcolor=lightblue];
    output_validator [label="output_validator", fillcolor=lightblue];
    router_guardrails_sandwich_line_47_except_dispatch_0 [label="router_guardrails_sandwich_line_47_except_dispatch_0", fillcolor=wheat];
    router_guardrails_sandwich_line_47_reraise_0 [label="router_guardrails_sandwich_line_47_reraise_0", fillcolor=wheat];
    router_guardrails_sandwich_line_47_try_enter_0 [label="router_guardrails_sandwich_line_47_try_enter_0", fillcolor=wheat];
    router_guardrails_sandwich_line_47_try_exit_0 [label="router_guardrails_sandwich_line_47_try_exit_0", fillcolor=wheat];
    safe_fallback [label="safe_fallback", fillcolor=lightblue];
    start_guardrails_sandwich [label="start_guardrails_sandwich", fillcolor=palegreen];

    start_guardrails_sandwich -> router_guardrails_sandwich_line_47_try_enter_0;
    router_guardrails_sandwich_line_47_try_enter_0 -> input_validator;
    input_validator -> core_agent;
    core_agent -> output_validator;
    output_validator -> router_guardrails_sandwich_line_47_try_exit_0;
    router_guardrails_sandwich_line_47_except_dispatch_0 -> safe_fallback [label="'Exception' in _all_types"];
    router_guardrails_sandwich_line_47_except_dispatch_0 -> router_guardrails_sandwich_line_47_reraise_0 [label="not ('Exception' in _all_types)"];
    router_guardrails_sandwich_line_47_reraise_0 -> end_guardrails_sandwich;
    router_guardrails_sandwich_line_47_try_exit_0 -> end_guardrails_sandwich;
    safe_fallback -> end_guardrails_sandwich;
}