digraph "map_reduce" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_map_reduce; }

    chunk_processor [label="chunk_processor", fillcolor=lightblue];
    fanin_map_reduce_chunk_results [label="fanin_map_reduce_chunk_results", fillcolor=lightblue];
    reducer [label="reducer", fillcolor=lightsalmon];
    router_map_reduce_fanout_chunk_results [label="router_map_reduce_fanout_chunk_results", fillcolor=wheat];
    splitter [label="splitter", fillcolor=lightblue];
    start_map_reduce [label="start_map_reduce", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_map_reduce -> splitter;
    splitter -> router_map_reduce_fanout_chunk_results;
    router_map_reduce_fanout_chunk_results -> fanin_map_reduce_chunk_results [label="fanout: p['chunks']", color="#6C35EA", fontcolor="#6C35EA"];
    fanin_map_reduce_chunk_results -> reducer;
    router_map_reduce_fanout_chunk_results -> chunk_processor;
    chunk_processor -> fanin_map_reduce_chunk_results;
    reducer -> __end__;
}