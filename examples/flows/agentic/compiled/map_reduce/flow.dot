digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_map_reduce [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await start_map_reduce(p)</i></td></tr></table>>];
  fanout_map_reduce_line_51 [fillcolor="lightblue", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanout_map_reduce_line_51(p)</i></td></tr><tr><td bgcolor="mediumpurple2" align="center"><b>[fan-out:gather]</b></td></tr><tr><td bgcolor="mediumpurple3" align="left">for chunk in p['chunks']</td></tr></table>>];
  end_map_reduce [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await end_map_reduce(p)</i></td></tr></table>>];
  chunk_processor [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await chunk_processor(p)</i></td></tr></table>>];
  fanin_map_reduce_line_51 [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanin_map_reduce_line_51(p)</i></td></tr><tr><td bgcolor="mediumpurple1" align="center"><b>[fan-in]</b></td></tr></table>>];
  reducer [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await reducer(p)</i></td></tr></table>>];
  splitter [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await splitter(p)</i></td></tr></table>>];

  chunk_processor -> fanin_map_reduce_line_51 [color=slateblue4, style=dashed];
  fanin_map_reduce_line_51 -> reducer;
  fanout_map_reduce_line_51 -> chunk_processor [color=mediumpurple4, label="slice 1..N\n(per chunk)", style=bold];
  fanout_map_reduce_line_51 -> fanin_map_reduce_line_51 [color=mediumpurple4, label="slice 0\n(parent)", style=dashed];
  reducer -> end_map_reduce;
  splitter -> fanout_map_reduce_line_51;
  start_map_reduce -> splitter;
}