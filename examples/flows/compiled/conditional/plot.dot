digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_conditional_flow [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = start_conditional_flow(p)</i></td></tr></table>>];
  router_conditional_flow_line_13_seq [fillcolor="wheat", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_conditional_flow_line_13_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['mut'] = 'A'</td></tr></table>>];
  router_conditional_flow_line_16_seq [fillcolor="wheat", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_conditional_flow_line_16_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['mut'] = 'B'</td></tr></table>>];
  router_conditional_flow_line_19_seq [fillcolor="wheat", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_conditional_flow_line_19_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['mut'] = 'default'</td></tr></table>>];
  router_conditional_flow_line_14_if [fillcolor="wheat", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_conditional_flow_line_14_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['type'] == 'B'</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkgreen"><font color="white"><b>TRUE</b></font></td><td bgcolor="darkred"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  router_conditional_flow_line_11_if [fillcolor="wheat", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_conditional_flow_line_11_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['type'] == 'A'</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkgreen"><font color="white"><b>TRUE</b></font></td><td bgcolor="darkred"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  end_conditional_flow [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = end_conditional_flow(p)</i></td></tr></table>>];
  handler_finalize [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = handler_finalize(p)</i></td></tr></table>>];
  handler_type_a [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = handler_type_a(p)</i></td></tr></table>>];
  handler_type_b [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = handler_type_b(p)</i></td></tr></table>>];
  handler_type_default [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = handler_type_default(p)</i></td></tr></table>>];
  handler_validate_input [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = handler_validate_input(p)</i></td></tr></table>>];

  handler_finalize -> end_conditional_flow;
  handler_type_a -> router_conditional_flow_line_13_seq;
  handler_type_b -> router_conditional_flow_line_16_seq;
  handler_type_default -> router_conditional_flow_line_19_seq;
  handler_validate_input -> router_conditional_flow_line_11_if;
  router_conditional_flow_line_11_if -> handler_type_a [color=darkgreen];
  router_conditional_flow_line_11_if -> router_conditional_flow_line_14_if [color=darkred];
  router_conditional_flow_line_13_seq -> handler_finalize;
  router_conditional_flow_line_14_if -> handler_type_b [color=darkgreen];
  router_conditional_flow_line_14_if -> handler_type_default [color=darkred];
  router_conditional_flow_line_16_seq -> handler_finalize;
  router_conditional_flow_line_19_seq -> handler_finalize;
  start_conditional_flow -> handler_validate_input;
}