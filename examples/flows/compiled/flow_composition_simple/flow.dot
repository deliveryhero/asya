digraph "outer_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_outer_pipeline; }

    enrich [label="enrich", fillcolor=lightblue];
    preprocess [label="preprocess", fillcolor=lightblue];
    start_outer_pipeline [label="start_outer_pipeline", fillcolor=palegreen];
    store [label="store", fillcolor=lightsalmon];
    validate [label="validate", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_outer_pipeline -> preprocess;
    preprocess -> validate;
    validate -> enrich;
    enrich -> store;
    store -> __end__;
    subgraph cluster_validation_stage {
        label="validation_stage";
        style=dashed;
        validate;
        enrich;
    }
}