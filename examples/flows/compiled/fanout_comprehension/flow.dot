digraph "research_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_research_flow [label="end_research_flow", fillcolor=palegreen];
    fanin_research_flow_line_15 [label="fanin_research_flow_line_15", fillcolor=lightblue];
    post_processor [label="post_processor", fillcolor=lightblue];
    preprocessor [label="preprocessor", fillcolor=lightblue];
    research_agent [label="research_agent", fillcolor=lightblue];
    router_research_flow_line_15_fanout_1 [label="router_research_flow_line_15_fanout_1", fillcolor=wheat];
    start_research_flow [label="start_research_flow", fillcolor=palegreen];

    start_research_flow -> preprocessor;
    preprocessor -> router_research_flow_line_15_fanout_1;
    router_research_flow_line_15_fanout_1 -> fanin_research_flow_line_15;
    fanin_research_flow_line_15 -> post_processor;
    router_research_flow_line_15_fanout_1 -> research_agent;
    research_agent -> fanin_research_flow_line_15;
    post_processor -> end_research_flow;
}