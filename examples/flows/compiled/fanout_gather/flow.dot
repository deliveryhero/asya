digraph "async_research_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_async_research_flow; }

    fanin_async_research_flow_results [label="fanin_async_research_flow_results", fillcolor=lightblue];
    research_agent [label="research_agent", fillcolor=lightblue];
    router_async_research_flow_fanout_results [label="router_async_research_flow_fanout_results", fillcolor=wheat];
    start_async_research_flow [label="start_async_research_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_async_research_flow -> router_async_research_flow_fanout_results;
    router_async_research_flow_fanout_results -> fanin_async_research_flow_results [label="fanout: p['topics']", color="#6C35EA", fontcolor="#6C35EA"];
    router_async_research_flow_fanout_results -> research_agent;
    research_agent -> fanin_async_research_flow_results;
    fanin_async_research_flow_results -> __end__;
}