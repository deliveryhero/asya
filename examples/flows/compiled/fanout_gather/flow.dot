digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_async_research_flow [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await start_async_research_flow(p)</i></td></tr></table>>];
  fanout_async_research_flow_L11 [fillcolor="plum1", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanout_async_research_flow_L11(p)</i></td></tr><tr><td bgcolor="plum2" align="center"><b>[fan-out:gather]</b></td></tr><tr><td bgcolor="plum3" align="left">for t in p['topics']</td></tr></table>>, shape=diamond];
  end_async_research_flow [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await end_async_research_flow(p)</i></td></tr></table>>];
  post_processor [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await post_processor(p)</i></td></tr></table>>];
  preprocessor [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await preprocessor(p)</i></td></tr></table>>];
  research_agent [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await research_agent(p)</i></td></tr></table>>];

  fanout_async_research_flow_L11 -> post_processor [color=mediumpurple4, label="slice 0\n(parent)", style=dashed];
  fanout_async_research_flow_L11 -> research_agent [color=mediumpurple4, label="slice 1..N\n(per t)", style=bold];
  post_processor -> end_async_research_flow;
  preprocessor -> fanout_async_research_flow_L11;
  research_agent -> post_processor [color=slateblue4, style=dashed];
  start_async_research_flow -> preprocessor;
}