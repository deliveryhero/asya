digraph "async_research_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_async_research_flow; }

    fanin_async_research_flow_line_16 [label="fanin_async_research_flow_line_16", fillcolor=lightblue];
    postprocessor [label="postprocessor", fillcolor=lightblue];
    preprocessor [label="preprocessor", fillcolor=lightblue];
    research_agent [label="research_agent", fillcolor=lightblue];
    router_async_research_flow_line_16_fanout_1 [label="router_async_research_flow_line_16_fanout_1", fillcolor=wheat];
    start_async_research_flow [label="start_async_research_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_async_research_flow -> preprocessor;
    preprocessor -> router_async_research_flow_line_16_fanout_1;
    router_async_research_flow_line_16_fanout_1 -> fanin_async_research_flow_line_16 [label="fanout: p['topics']", color="#6C35EA", fontcolor="#6C35EA"];
    fanin_async_research_flow_line_16 -> postprocessor;
    router_async_research_flow_line_16_fanout_1 -> research_agent;
    research_agent -> fanin_async_research_flow_line_16;
    postprocessor -> __end__;
}