digraph "if_empty_branches_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_if_empty_branches_flow; }

    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_process [label="handler_process", fillcolor=lightblue];
    handler_setup [label="handler_setup", fillcolor=lightblue];
    router_if_empty_branches_flow_if_skip_processing [label="router_if_empty_branches_flow_if_skip_processing", fillcolor=wheat];
    start_if_empty_branches_flow [label="start_if_empty_branches_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_if_empty_branches_flow -> handler_setup;
    handler_setup -> router_if_empty_branches_flow_if_skip_processing;
    router_if_empty_branches_flow_if_skip_processing -> handler_finalize [label="p['skip_processing']", color="#2E8B57", fontcolor="#2E8B57"];
    router_if_empty_branches_flow_if_skip_processing -> handler_process [label="else", color="#D35400", fontcolor="#D35400"];
    handler_process -> handler_finalize;
    handler_finalize -> __end__;
}