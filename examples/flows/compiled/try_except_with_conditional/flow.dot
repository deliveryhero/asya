digraph "payment_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_payment_flow; }

    audit_log [label="audit_log", fillcolor=lightblue];
    charge_card [label="charge_card", fillcolor=lightblue];
    notify_payment_failure [label="notify_payment_failure", fillcolor=lightblue];
    process_bank_transfer [label="process_bank_transfer", fillcolor=lightblue];
    record_transaction [label="record_transaction", fillcolor=lightblue];
    router_payment_flow_except_valueerror [label="router_payment_flow_except_valueerror\n\np['status'] = 'payment_failed'", fillcolor=wheat];
    router_payment_flow_if_method_eq_card [label="router_payment_flow_if_method_eq_card", fillcolor=wheat];
    send_receipt [label="send_receipt", fillcolor=lightsalmon];
    start_payment_flow [label="start_payment_flow", fillcolor=palegreen];
    validate_payment [label="validate_payment", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_payment_flow -> validate_payment;
    validate_payment -> router_payment_flow_if_method_eq_card;
    audit_log -> send_receipt;
    router_payment_flow_except_valueerror -> notify_payment_failure;
    notify_payment_failure -> audit_log;
    router_payment_flow_if_method_eq_card -> charge_card [label="p['method'] == 'card'", color="#2E8B57", fontcolor="#2E8B57"];
    charge_card -> record_transaction;
    router_payment_flow_if_method_eq_card -> process_bank_transfer [label="else", color="#D35400", fontcolor="#D35400"];
    process_bank_transfer -> record_transaction;
    charge_card -> router_payment_flow_except_valueerror [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    process_bank_transfer -> router_payment_flow_except_valueerror [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    record_transaction -> router_payment_flow_except_valueerror [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    record_transaction -> audit_log;
    send_receipt -> __end__;
}