flowchart TD
    %% Flow: payment_flow

    audit_log[audit_log]
    charge_card[charge_card]
    notify_payment_failure[notify_payment_failure]
    process_bank_transfer[process_bank_transfer]
    record_transaction[record_transaction]
    router_payment_flow_except_valueerror{{"router_payment_flow_except_valueerror<br/><br/>p['status'] = 'payment_failed'"}}
    router_payment_flow_if_method_eq_card{{router_payment_flow_if_method_eq_card}}
    send_receipt[send_receipt]
    start_payment_flow([start_payment_flow])
    validate_payment[validate_payment]
    __end__((( )))

    start_payment_flow --> validate_payment
    validate_payment --> router_payment_flow_if_method_eq_card
    audit_log --> send_receipt
    router_payment_flow_except_valueerror --> notify_payment_failure
    notify_payment_failure --> audit_log
    router_payment_flow_if_method_eq_card -->|"p['method'] == 'card'"| charge_card
    charge_card --> record_transaction
    router_payment_flow_if_method_eq_card -->|"else"| process_bank_transfer
    process_bank_transfer --> record_transaction
    charge_card -->|"ValueError"| router_payment_flow_except_valueerror
    process_bank_transfer -->|"ValueError"| router_payment_flow_except_valueerror
    record_transaction -->|"ValueError"| router_payment_flow_except_valueerror
    record_transaction --> audit_log
    send_receipt --> __end__

    classDef start fill:#98FB98,stroke:#333
    classDef endnode fill:#FFA07A,stroke:#333
    classDef router fill:#F5DEB3,stroke:#333
    classDef handler fill:#ADD8E6,stroke:#333
    classDef endpoint fill:#000,stroke:#333,color:#fff
    class start_payment_flow start
    class send_receipt,__end__ endnode
    class router_payment_flow_except_valueerror,router_payment_flow_if_method_eq_card router
    class audit_log,charge_card,notify_payment_failure,process_bank_transfer,record_transaction,validate_payment handler
    linkStyle 5 stroke:#2E8B57
    linkStyle 7 stroke:#E07040
    linkStyle 9,10,11 stroke:#DC143C