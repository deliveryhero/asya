digraph "while_with_continue_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_while_with_continue_flow; }

    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_init [label="handler_init", fillcolor=lightblue];
    handler_process [label="handler_process", fillcolor=lightblue];
    router_while_with_continue_flow_if_skip_iteration [label="router_while_with_continue_flow_if_skip_iteration\n\np['i'] += 1", fillcolor=wheat];
    router_while_with_continue_flow_seq_set_i [label="router_while_with_continue_flow_seq_set_i\n\np['i'] = 0", fillcolor=wheat];
    router_while_with_continue_flow_while_i_lt_max_iterations [label="router_while_with_continue_flow_while_i_lt_max_iterations", fillcolor=wheat];
    start_while_with_continue_flow [label="start_while_with_continue_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_while_with_continue_flow -> handler_init;
    handler_init -> router_while_with_continue_flow_seq_set_i;
    router_while_with_continue_flow_if_skip_iteration -> router_while_with_continue_flow_while_i_lt_max_iterations [label="p['skip_iteration']", color="#2E8B57", fontcolor="#2E8B57"];
    router_while_with_continue_flow_if_skip_iteration -> handler_process [label="else", color="#D35400", fontcolor="#D35400"];
    router_while_with_continue_flow_while_i_lt_max_iterations -> router_while_with_continue_flow_if_skip_iteration [label="p['i'] < p['max_iterations']", color="#2E8B57", fontcolor="#2E8B57"];
    router_while_with_continue_flow_while_i_lt_max_iterations -> handler_finalize [label="else", color="#D35400", fontcolor="#D35400"];
    router_while_with_continue_flow_seq_set_i -> router_while_with_continue_flow_while_i_lt_max_iterations;
    handler_process -> router_while_with_continue_flow_while_i_lt_max_iterations;
    handler_finalize -> __end__;
}