digraph "complex_combined_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_complex_combined_flow; }

    handler_default [label="handler_default", fillcolor=lightblue];
    handler_error [label="handler_error", fillcolor=lightsalmon];
    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_init [label="handler_init", fillcolor=lightblue];
    handler_process [label="handler_process", fillcolor=lightblue];
    handler_type_a [label="handler_type_a", fillcolor=lightblue];
    handler_type_b [label="handler_type_b", fillcolor=lightblue];
    router_complex_combined_flow_line_15_if_8 [label="router_complex_combined_flow_line_15_if_8", fillcolor=wheat];
    router_complex_combined_flow_line_19_if_7 [label="router_complex_combined_flow_line_19_if_7", fillcolor=wheat];
    router_complex_combined_flow_line_20_seq_4 [label="router_complex_combined_flow_line_20_seq_4\n\np['i'] = 0", fillcolor=wheat];
    router_complex_combined_flow_line_21_while_1 [label="router_complex_combined_flow_line_21_while_1", fillcolor=wheat];
    router_complex_combined_flow_line_24_if_3 [label="router_complex_combined_flow_line_24_if_3\n\np['i'] += 1", fillcolor=wheat];
    router_complex_combined_flow_line_29_if_2 [label="router_complex_combined_flow_line_29_if_2", fillcolor=wheat];
    router_complex_combined_flow_line_32_if_6 [label="router_complex_combined_flow_line_32_if_6", fillcolor=wheat];
    router_complex_combined_flow_line_34_if_5 [label="router_complex_combined_flow_line_34_if_5", fillcolor=wheat];
    start_complex_combined_flow [label="start_complex_combined_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_complex_combined_flow -> handler_init;
    handler_init -> router_complex_combined_flow_line_15_if_8;
    router_complex_combined_flow_line_29_if_2 -> handler_finalize [label="p['stop_early']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_line_24_if_3 -> router_complex_combined_flow_line_21_while_1 [label="p['skip_even'] and p['i'] % 2 == 0", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_line_24_if_3 -> handler_process [label="else", color="#D35400", fontcolor="#D35400"];
    handler_process -> router_complex_combined_flow_line_29_if_2;
    router_complex_combined_flow_line_21_while_1 -> router_complex_combined_flow_line_24_if_3 [label="p['i'] < p['max_iterations']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_line_21_while_1 -> handler_finalize [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_line_20_seq_4 -> router_complex_combined_flow_line_21_while_1;
    router_complex_combined_flow_line_34_if_5 -> handler_type_b [label="p['type'] == 'B'", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_line_34_if_5 -> handler_default [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_line_32_if_6 -> handler_type_a [label="p['type'] == 'A'", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_line_32_if_6 -> router_complex_combined_flow_line_34_if_5 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_line_19_if_7 -> router_complex_combined_flow_line_20_seq_4 [label="p['needs_loop']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_line_19_if_7 -> router_complex_combined_flow_line_32_if_6 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_line_15_if_8 -> router_complex_combined_flow_line_19_if_7 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_line_15_if_8 -> handler_error [label="not p['valid']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_line_29_if_2 -> router_complex_combined_flow_line_21_while_1 [label="else", color="#D35400", fontcolor="#D35400"];
    handler_type_a -> handler_finalize;
    handler_type_b -> handler_finalize;
    handler_default -> handler_finalize;
    router_complex_combined_flow_line_24_if_3 -> handler_finalize;
    handler_error -> __end__;
    handler_finalize -> __end__;
}