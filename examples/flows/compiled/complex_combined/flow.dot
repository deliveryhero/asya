digraph "complex_combined_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_complex_combined_flow; }

    handler_default [label="handler_default", fillcolor=lightblue];
    handler_error [label="handler_error", fillcolor=lightsalmon];
    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_init [label="handler_init", fillcolor=lightblue];
    handler_process [label="handler_process", fillcolor=lightblue];
    handler_type_a [label="handler_type_a", fillcolor=lightblue];
    handler_type_b [label="handler_type_b", fillcolor=lightblue];
    router_complex_combined_flow_if_needs_loop [label="router_complex_combined_flow_if_needs_loop", fillcolor=wheat];
    router_complex_combined_flow_if_not_valid [label="router_complex_combined_flow_if_not_valid", fillcolor=wheat];
    router_complex_combined_flow_if_skip_even_and_p_i_2_eq_0 [label="router_complex_combined_flow_if_skip_even_and_p_i_2_eq_0\n\np['i'] += 1", fillcolor=wheat];
    router_complex_combined_flow_if_stop_early [label="router_complex_combined_flow_if_stop_early", fillcolor=wheat];
    router_complex_combined_flow_if_type_eq_a [label="router_complex_combined_flow_if_type_eq_a", fillcolor=wheat];
    router_complex_combined_flow_if_type_eq_b [label="router_complex_combined_flow_if_type_eq_b", fillcolor=wheat];
    router_complex_combined_flow_seq_set_i [label="router_complex_combined_flow_seq_set_i\n\np['i'] = 0", fillcolor=wheat];
    router_complex_combined_flow_while_i_lt_max_iterations [label="router_complex_combined_flow_while_i_lt_max_iterations", fillcolor=wheat];
    start_complex_combined_flow [label="start_complex_combined_flow", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_complex_combined_flow -> handler_init;
    handler_init -> router_complex_combined_flow_if_not_valid;
    router_complex_combined_flow_if_stop_early -> handler_finalize [label="p['stop_early']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_if_skip_even_and_p_i_2_eq_0 -> router_complex_combined_flow_while_i_lt_max_iterations [label="p['skip_even'] and p['i'] % 2 == 0", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_if_skip_even_and_p_i_2_eq_0 -> handler_process [label="else", color="#D35400", fontcolor="#D35400"];
    handler_process -> router_complex_combined_flow_if_stop_early;
    router_complex_combined_flow_while_i_lt_max_iterations -> router_complex_combined_flow_if_skip_even_and_p_i_2_eq_0 [label="p['i'] < p['max_iterations']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_while_i_lt_max_iterations -> handler_finalize [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_seq_set_i -> router_complex_combined_flow_while_i_lt_max_iterations;
    router_complex_combined_flow_if_type_eq_b -> handler_type_b [label="p['type'] == 'B'", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_if_type_eq_b -> handler_default [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_if_type_eq_a -> handler_type_a [label="p['type'] == 'A'", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_if_type_eq_a -> router_complex_combined_flow_if_type_eq_b [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_if_needs_loop -> router_complex_combined_flow_seq_set_i [label="p['needs_loop']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_if_needs_loop -> router_complex_combined_flow_if_type_eq_a [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_if_not_valid -> router_complex_combined_flow_if_needs_loop [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_combined_flow_if_not_valid -> handler_error [label="not p['valid']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_combined_flow_if_stop_early -> router_complex_combined_flow_while_i_lt_max_iterations [label="else", color="#D35400", fontcolor="#D35400"];
    handler_type_a -> handler_finalize;
    handler_type_b -> handler_finalize;
    handler_default -> handler_finalize;
    router_complex_combined_flow_if_skip_even_and_p_i_2_eq_0 -> handler_finalize;
    handler_error -> __end__;
    handler_finalize -> __end__;
}