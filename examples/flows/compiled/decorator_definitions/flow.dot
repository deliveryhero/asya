digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_decorator_definitions_flow [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = start_decorator_definitions_flow(p)</i></td></tr><tr><td bgcolor="white" align="left">p = inject_trace(p)</td></tr></table>>];
  end_decorator_definitions_flow [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = end_decorator_definitions_flow(p)</i></td></tr></table>>];
  enrich [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = enrich(p)</i></td></tr></table>>];
  validate [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = validate(p)</i></td></tr></table>>];

  enrich -> end_decorator_definitions_flow;
  start_decorator_definitions_flow -> validate;
  validate -> enrich;
}