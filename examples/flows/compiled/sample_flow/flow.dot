digraph "sample_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_sample_flow; }

    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_setup [label="handler_setup", fillcolor=lightblue];
    handler_type_a [label="handler_type_a", fillcolor=lightblue];
    handler_type_b [label="handler_type_b", fillcolor=lightblue];
    router_sample_flow_line_11_seq_2 [label="router_sample_flow_line_11_seq_2\n\np['branch'] = 'B'", fillcolor=wheat];
    router_sample_flow_line_6_if_3 [label="router_sample_flow_line_6_if_3", fillcolor=wheat];
    router_sample_flow_line_7_seq_1 [label="router_sample_flow_line_7_seq_1\n\np['branch'] = 'A'", fillcolor=wheat];
    start_sample_flow [label="start_sample_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_sample_flow -> handler_setup;
    handler_setup -> router_sample_flow_line_6_if_3;
    router_sample_flow_line_7_seq_1 -> handler_type_a;
    router_sample_flow_line_6_if_3 -> router_sample_flow_line_7_seq_1 [label="p['type'] == 'A'", color="#2E8B57", fontcolor="#2E8B57"];
    router_sample_flow_line_6_if_3 -> handler_type_b [label="else", color="#D35400", fontcolor="#D35400"];
    handler_type_b -> router_sample_flow_line_11_seq_2;
    router_sample_flow_line_11_seq_2 -> handler_finalize;
    handler_type_a -> handler_finalize;
    handler_finalize -> __end__;
}