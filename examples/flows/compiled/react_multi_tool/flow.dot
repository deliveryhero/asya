digraph "research_agent" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_research_agent; }

    router_research_agent_line_15_while_1 [label="router_research_agent_line_15_while_1", fillcolor=wheat];
    router_research_agent_line_17_if_4 [label="router_research_agent_line_17_if_4", fillcolor=wheat];
    router_research_agent_line_19_if_3 [label="router_research_agent_line_19_if_3", fillcolor=wheat];
    router_research_agent_line_21_if_2 [label="router_research_agent_line_21_if_2", fillcolor=wheat];
    start_research_agent [label="start_research_agent\n\np['messages'] = p.get('messages', [])", fillcolor=palegreen];

    start_research_agent -> router_research_agent_line_15_while_1;
    router_research_agent_line_19_if_3 -> router_research_agent_line_21_if_2 [label="else", color="#D35400", fontcolor="#D35400"];
    router_research_agent_line_17_if_4 -> router_research_agent_line_19_if_3 [label="else", color="#D35400", fontcolor="#D35400"];
    router_research_agent_line_15_while_1 -> router_research_agent_line_17_if_4;
    router_research_agent_line_21_if_2 -> router_research_agent_line_15_while_1;
}