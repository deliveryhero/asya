digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_document_pipeline [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await start_document_pipeline(p)</i></td></tr><tr><td bgcolor="white" align="left">p['status'] = 'processing'</td></tr></table>>];
  router_document_pipeline_line_24_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_document_pipeline_line_24_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['status'] = 'done'</td></tr></table>>];
  router_document_pipeline_line_20_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_document_pipeline_line_20_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p.get('language') != 'en'</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  end_document_pipeline [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await end_document_pipeline(p)</i></td></tr></table>>];
  language_detector [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await language_detector(p)</i></td></tr></table>>];
  ocr_extractor [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await ocr_extractor(p)</i></td></tr></table>>];
  sentiment_analyzer [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await sentiment_analyzer(p)</i></td></tr></table>>];
  translator [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await translator(p)</i></td></tr></table>>];

  language_detector -> router_document_pipeline_line_20_if;
  ocr_extractor -> language_detector;
  router_document_pipeline_line_20_if -> sentiment_analyzer [label="F", color=indianred4];
  router_document_pipeline_line_20_if -> translator [label="T", color=darkseagreen4];
  router_document_pipeline_line_24_seq -> end_document_pipeline;
  sentiment_analyzer -> router_document_pipeline_line_24_seq;
  start_document_pipeline -> ocr_extractor;
  translator -> sentiment_analyzer;
}