digraph "document_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_document_pipeline; }

    language_detector [label="language_detector", fillcolor=lightblue];
    ocr_extractor [label="ocr_extractor", fillcolor=lightblue];
    router_document_pipeline_line_24_if_2 [label="router_document_pipeline_line_24_if_2", fillcolor=wheat];
    router_document_pipeline_line_28_seq_1 [label="router_document_pipeline_line_28_seq_1\n\np['status'] = 'done'", fillcolor=wheat];
    sentiment_analyzer [label="sentiment_analyzer", fillcolor=lightblue];
    start_document_pipeline [label="start_document_pipeline\n\np['status'] = 'processing'", fillcolor=palegreen];
    translator [label="translator", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_document_pipeline -> ocr_extractor;
    ocr_extractor -> language_detector;
    language_detector -> router_document_pipeline_line_24_if_2;
    router_document_pipeline_line_24_if_2 -> translator [label="p.get('language') != 'en'", color="#2E8B57", fontcolor="#2E8B57"];
    translator -> sentiment_analyzer;
    sentiment_analyzer -> router_document_pipeline_line_28_seq_1;
    router_document_pipeline_line_24_if_2 -> sentiment_analyzer [label="else", color="#D35400", fontcolor="#D35400"];
    router_document_pipeline_line_28_seq_1 -> __end__;
}