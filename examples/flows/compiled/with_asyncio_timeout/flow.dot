digraph "document_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_document_pipeline; }

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];
    language_detector [label="language_detector", fillcolor=lightblue];
    ocr_extractor [label="ocr_extractor", fillcolor=lightblue];
    router_document_pipeline_if_language_ne_en [label="router_document_pipeline_if_language_ne_en", fillcolor=wheat];
    router_document_pipeline_seq_set_status [label="router_document_pipeline_seq_set_status\n\np['status'] = 'done'", fillcolor=wheat];
    sentiment_analyzer [label="sentiment_analyzer", fillcolor=lightblue];
    start_document_pipeline [label="start_document_pipeline\n\np['status'] = 'processing'", fillcolor=palegreen];
    translator [label="translator", fillcolor=lightblue];

    start_document_pipeline -> ocr_extractor;
    ocr_extractor -> language_detector;
    language_detector -> router_document_pipeline_if_language_ne_en;
    router_document_pipeline_seq_set_status -> __end__;
    router_document_pipeline_if_language_ne_en -> translator [label="p.get('language') != 'en'", color="#2E8B57", fontcolor="#2E8B57"];
    translator -> sentiment_analyzer;
    sentiment_analyzer -> router_document_pipeline_seq_set_status;
    router_document_pipeline_if_language_ne_en -> sentiment_analyzer [label="else", color="#D35400", fontcolor="#D35400"];
    subgraph cluster_asyncio_timeout_30_ {
        label="asyncio.timeout(30)";
        style=dashed;
        ocr_extractor;
        language_detector;
    }
}