digraph "while_true_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_while_true_flow [label="end_while_true_flow", fillcolor=palegreen];
    handler_finalize [label="handler_finalize", fillcolor=lightblue];
    handler_init [label="handler_init", fillcolor=lightblue];
    handler_process [label="handler_process", fillcolor=lightblue];
    router_while_true_flow_line_14_while_1 [label="router_while_true_flow_line_14_while_1", fillcolor=wheat];
    router_while_true_flow_line_16_if_2 [label="router_while_true_flow_line_16_if_2", fillcolor=wheat];
    start_while_true_flow [label="start_while_true_flow", fillcolor=palegreen];

    start_while_true_flow -> handler_init;
    handler_init -> router_while_true_flow_line_14_while_1;
    router_while_true_flow_line_16_if_2 -> handler_finalize [label="p.get('done', False)"];
    router_while_true_flow_line_14_while_1 -> handler_process;
    handler_process -> router_while_true_flow_line_16_if_2;
    router_while_true_flow_line_16_if_2 -> router_while_true_flow_line_14_while_1;
    handler_finalize -> end_while_true_flow;
}