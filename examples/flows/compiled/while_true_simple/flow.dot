digraph "while_true_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_while_true_flow; }

    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_init [label="handler_init", fillcolor=lightblue];
    handler_process [label="handler_process", fillcolor=lightblue];
    router_while_true_flow_if_done [label="router_while_true_flow_if_done", fillcolor=wheat];
    router_while_true_flow_while_loop [label="router_while_true_flow_while_loop", fillcolor=wheat];
    start_while_true_flow [label="start_while_true_flow", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_while_true_flow -> handler_init;
    handler_init -> router_while_true_flow_while_loop;
    router_while_true_flow_if_done -> handler_finalize [label="p.get('done', False)", color="#2E8B57", fontcolor="#2E8B57"];
    router_while_true_flow_while_loop -> handler_process;
    handler_process -> router_while_true_flow_if_done;
    router_while_true_flow_if_done -> router_while_true_flow_while_loop [label="else", color="#D35400", fontcolor="#D35400"];
    handler_finalize -> __end__;
}