digraph "typed_pydantic_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_typed_pydantic_pipeline; }

    ranker [label="ranker", fillcolor=lightblue];
    responder [label="responder", fillcolor=lightsalmon];
    scorer [label="scorer", fillcolor=lightblue];
    start_typed_pydantic_pipeline [label="start_typed_pydantic_pipeline\n\np['candidates'] = retrieve(p['query'], p.get('top_k', 10))", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_typed_pydantic_pipeline -> scorer;
    scorer -> ranker;
    ranker -> responder;
    responder -> __end__;
    subgraph cluster_ingester {
        label="ingester";
        style=dashed;
    }
}