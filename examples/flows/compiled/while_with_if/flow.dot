digraph "if_inside_while_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_if_inside_while_flow; }

    handler_even [label="handler_even", fillcolor=lightblue];
    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_init [label="handler_init", fillcolor=lightblue];
    handler_odd [label="handler_odd", fillcolor=lightblue];
    router_if_inside_while_flow_if_p_i_2_eq_0 [label="router_if_inside_while_flow_if_p_i_2_eq_0\n\np['i'] += 1", fillcolor=wheat];
    router_if_inside_while_flow_seq_set_i [label="router_if_inside_while_flow_seq_set_i\n\np['i'] = 0", fillcolor=wheat];
    router_if_inside_while_flow_while_i_lt_max_iterations [label="router_if_inside_while_flow_while_i_lt_max_iterations", fillcolor=wheat];
    start_if_inside_while_flow [label="start_if_inside_while_flow", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_if_inside_while_flow -> handler_init;
    handler_init -> router_if_inside_while_flow_seq_set_i;
    router_if_inside_while_flow_if_p_i_2_eq_0 -> handler_even [label="p['i'] % 2 == 0", color="#2E8B57", fontcolor="#2E8B57"];
    router_if_inside_while_flow_if_p_i_2_eq_0 -> handler_odd [label="else", color="#D35400", fontcolor="#D35400"];
    router_if_inside_while_flow_while_i_lt_max_iterations -> router_if_inside_while_flow_if_p_i_2_eq_0 [label="p['i'] < p['max_iterations']", color="#2E8B57", fontcolor="#2E8B57"];
    router_if_inside_while_flow_while_i_lt_max_iterations -> handler_finalize [label="else", color="#D35400", fontcolor="#D35400"];
    router_if_inside_while_flow_seq_set_i -> router_if_inside_while_flow_while_i_lt_max_iterations;
    handler_even -> router_if_inside_while_flow_while_i_lt_max_iterations;
    handler_odd -> router_if_inside_while_flow_while_i_lt_max_iterations;
    handler_finalize -> __end__;
}