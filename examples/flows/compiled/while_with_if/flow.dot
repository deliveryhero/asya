digraph "if_inside_while_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_if_inside_while_flow [label="end_if_inside_while_flow", fillcolor=palegreen];
    handler_even [label="handler_even", fillcolor=lightblue];
    handler_finalize [label="handler_finalize", fillcolor=lightblue];
    handler_init [label="handler_init", fillcolor=lightblue];
    handler_odd [label="handler_odd", fillcolor=lightblue];
    router_if_inside_while_flow_line_13_seq_3 [label="router_if_inside_while_flow_line_13_seq_3", fillcolor=wheat];
    router_if_inside_while_flow_line_14_while_1 [label="router_if_inside_while_flow_line_14_while_1", fillcolor=wheat];
    router_if_inside_while_flow_line_16_if_2 [label="router_if_inside_while_flow_line_16_if_2", fillcolor=wheat];
    start_if_inside_while_flow [label="start_if_inside_while_flow", fillcolor=palegreen];

    start_if_inside_while_flow -> handler_init;
    start_if_inside_while_flow -> router_if_inside_while_flow_line_13_seq_3;
    router_if_inside_while_flow_line_16_if_2 -> handler_even;
    router_if_inside_while_flow_line_16_if_2 -> handler_odd;
    router_if_inside_while_flow_line_14_while_1 -> router_if_inside_while_flow_line_16_if_2;
    router_if_inside_while_flow_line_14_while_1 -> router_if_inside_while_flow_line_14_while_1;
    router_if_inside_while_flow_line_14_while_1 -> handler_finalize [label="p['i'] < p['max_iterations']"];
    router_if_inside_while_flow_line_13_seq_3 -> router_if_inside_while_flow_line_14_while_1;
}