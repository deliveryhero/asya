digraph "mutations_only_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_mutations_only_flow; }

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];
    router_mutations_only_flow_seq_set_step [label="router_mutations_only_flow_seq_set_step\n\np['step'] = 1\np['x'] = 10\np['y'] = 20\np['x'] += p['y']\np['z'] = p['x'] + 30", fillcolor=wheat];
    start_mutations_only_flow [label="start_mutations_only_flow", fillcolor=palegreen];

    start_mutations_only_flow -> router_mutations_only_flow_seq_set_step;
    router_mutations_only_flow_seq_set_step -> __end__;
}