digraph "order_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_order_pipeline [label="end_order_pipeline", fillcolor=palegreen];
    router_order_pipeline_line_32_if_2 [label="router_order_pipeline_line_32_if_2", fillcolor=wheat];
    router_order_pipeline_line_33_seq_1 [label="router_order_pipeline_line_33_seq_1", fillcolor=wheat];

    router_order_pipeline_line_32_if_2 -> router_order_pipeline_line_33_seq_1 [label="p.get('fraud_score', 0) > 0.8"];
}