digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_decorator_inline_comments_flow [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = start_decorator_inline_comments_flow(p)</i></td></tr><tr><td bgcolor="white" align="left">p = inject_id(p)</td></tr></table>>];
  router_decorator_inline_comments_flow_line_18_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_decorator_inline_comments_flow_line…(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['category'] == 'priority'</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  end_decorator_inline_comments_flow [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = end_decorator_inline_comments_flow(p)</i></td></tr></table>>];
  classifier [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = classifier(p)</i></td></tr></table>>];
  fast_handler [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = fast_handler(p)</i></td></tr></table>>];
  standard_handler [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = standard_handler(p)</i></td></tr></table>>];

  classifier -> router_decorator_inline_comments_flow_line_18_if;
  fast_handler -> end_decorator_inline_comments_flow;
  router_decorator_inline_comments_flow_line_18_if -> fast_handler [label="T", color=darkseagreen4];
  router_decorator_inline_comments_flow_line_18_if -> standard_handler [label="F", color=indianred4];
  standard_handler -> end_decorator_inline_comments_flow;
  start_decorator_inline_comments_flow -> classifier;
}