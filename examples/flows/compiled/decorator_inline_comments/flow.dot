digraph "decorator_inline_comments_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_decorator_inline_comments_flow; }

    classifier [label="classifier", fillcolor=lightblue];
    router_decorator_inline_comments_flow_line_18_if_3 [label="router_decorator_inline_comments_flow_line_18_if_3", fillcolor=wheat];
    router_decorator_inline_comments_flow_line_39_seq_1 [label="router_decorator_inline_comments_flow_line_39_seq_1\n\np['handled_by'] = 'fast'", fillcolor=wheat];
    router_decorator_inline_comments_flow_line_45_seq_2 [label="router_decorator_inline_comments_flow_line_45_seq_2\n\np['handled_by'] = 'standard'", fillcolor=wheat];
    start_decorator_inline_comments_flow [label="start_decorator_inline_comments_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_decorator_inline_comments_flow -> classifier;
    classifier -> router_decorator_inline_comments_flow_line_18_if_3;
    router_decorator_inline_comments_flow_line_18_if_3 -> router_decorator_inline_comments_flow_line_39_seq_1 [label="p['category'] == 'priority'", color="#2E8B57", fontcolor="#2E8B57"];
    router_decorator_inline_comments_flow_line_18_if_3 -> router_decorator_inline_comments_flow_line_45_seq_2 [label="else", color="#D35400", fontcolor="#D35400"];
    router_decorator_inline_comments_flow_line_39_seq_1 -> __end__;
    router_decorator_inline_comments_flow_line_45_seq_2 -> __end__;
}