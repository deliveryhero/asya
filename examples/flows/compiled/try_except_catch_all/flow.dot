digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_resilient_pipeline [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = start_resilient_pipeline(p)</i></td></tr></table>>];
  router_resilient_pipeline_line_5_seq [fillcolor="wheat", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_resilient_pipeline_line_5_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['error_type'] = 'known'</td></tr></table>>];
  router_resilient_pipeline_line_8_seq [fillcolor="wheat", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_resilient_pipeline_line_8_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['error_type'] = 'unknown'</td></tr></table>>];
  router_resilient_pipeline_line_2_try_enter_0 [fillcolor="lightcyan", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_resilient_pipeline_line_2_try_enter…(p)</i></td></tr><tr><td bgcolor="lightcyan"><b>try</b></td></tr></table>>];
  router_resilient_pipeline_line_2_try_exit_0 [fillcolor="lightcyan", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_resilient_pipeline_line_2_try_exit_0(p)</i></td></tr><tr><td bgcolor="lightcyan"><b>try-exit</b> (success)</td></tr></table>>];
  router_resilient_pipeline_line_2_except_dispatch_0 [fillcolor="lightyellow", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_resilient_pipeline_line_2_except_di…(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>except ValueError</b></td></tr><tr><td bgcolor="lightyellow"><b>except (catch-all)</b></td></tr></table>>];
  end_resilient_pipeline [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = end_resilient_pipeline(p)</i></td></tr></table>>];
  handle_known_error [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = handle_known_error(p)</i></td></tr></table>>];
  handle_unknown_error [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = handle_unknown_error(p)</i></td></tr></table>>];
  risky_operation [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = risky_operation(p)</i></td></tr></table>>];

  risky_operation -> router_resilient_pipeline_line_2_try_exit_0;
  router_resilient_pipeline_line_2_except_dispatch_0 -> router_resilient_pipeline_line_5_seq [color=orange, label="ValueError"];
  router_resilient_pipeline_line_2_except_dispatch_0 -> router_resilient_pipeline_line_8_seq [color=orange, label="catch-all"];
  router_resilient_pipeline_line_2_try_enter_0 -> risky_operation;
  router_resilient_pipeline_line_2_try_enter_0 -> router_resilient_pipeline_line_2_except_dispatch_0 [color=orange, style=dashed, label="error"];
  router_resilient_pipeline_line_2_try_exit_0 -> end_resilient_pipeline;
  router_resilient_pipeline_line_5_seq -> handle_known_error;
  router_resilient_pipeline_line_8_seq -> handle_unknown_error;
  start_resilient_pipeline -> router_resilient_pipeline_line_2_try_enter_0;
}