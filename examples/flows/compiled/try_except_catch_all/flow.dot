digraph "resilient_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_resilient_pipeline; }

    handle_known_error [label="handle_known_error", fillcolor=lightsalmon];
    handle_unknown_error [label="handle_unknown_error", fillcolor=lightsalmon];
    risky_operation [label="risky_operation", fillcolor=lightblue];
    router_resilient_pipeline_line_11_except_4 [label="router_resilient_pipeline_line_11_except_4", fillcolor=wheat];
    router_resilient_pipeline_line_12_seq_3 [label="router_resilient_pipeline_line_12_seq_3\n\np['error_type'] = 'unknown'", fillcolor=wheat];
    router_resilient_pipeline_line_8_except_2 [label="router_resilient_pipeline_line_8_except_2", fillcolor=wheat];
    router_resilient_pipeline_line_9_seq_1 [label="router_resilient_pipeline_line_9_seq_1\n\np['error_type'] = 'known'", fillcolor=wheat];
    start_resilient_pipeline [label="start_resilient_pipeline", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_resilient_pipeline -> risky_operation;
    router_resilient_pipeline_line_9_seq_1 -> handle_known_error;
    router_resilient_pipeline_line_8_except_2 -> router_resilient_pipeline_line_9_seq_1;
    router_resilient_pipeline_line_12_seq_3 -> handle_unknown_error;
    router_resilient_pipeline_line_11_except_4 -> router_resilient_pipeline_line_12_seq_3;
    risky_operation -> router_resilient_pipeline_line_8_except_2 [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    risky_operation -> router_resilient_pipeline_line_11_except_4 [label="except *", color="#DC143C", fontcolor="#DC143C"];
    handle_known_error -> __end__;
    handle_unknown_error -> __end__;
}