digraph "try_except_catch_all" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_try_except_catch_all; }

    handle_known_error [label="handle_known_error", fillcolor=lightsalmon];
    handle_unknown_error [label="handle_unknown_error", fillcolor=lightsalmon];
    risky_operation [label="risky_operation", fillcolor=lightblue];
    router_try_except_catch_all_except_all [label="router_try_except_catch_all_except_all\n\np['error_type'] = 'unknown'", fillcolor=wheat];
    router_try_except_catch_all_except_valueerror [label="router_try_except_catch_all_except_valueerror\n\np['error_type'] = 'known'", fillcolor=wheat];
    start_try_except_catch_all [label="start_try_except_catch_all", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_try_except_catch_all -> risky_operation;
    router_try_except_catch_all_except_valueerror -> handle_known_error;
    router_try_except_catch_all_except_all -> handle_unknown_error;
    risky_operation -> router_try_except_catch_all_except_valueerror [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    risky_operation -> router_try_except_catch_all_except_all [label="except *", color="#DC143C", fontcolor="#DC143C"];
    handle_known_error -> __end__;
    handle_unknown_error -> __end__;
}