digraph "llm_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_llm_pipeline; }

    call_fallback_llm [label="call_fallback_llm", fillcolor=lightsalmon];
    call_llm [label="call_llm", fillcolor=lightblue];
    notify_admin [label="notify_admin", fillcolor=lightsalmon];
    router_llm_pipeline_except_authenticationerror [label="router_llm_pipeline_except_authenticationerror\n\np['status'] = 'auth_failed'", fillcolor=wheat];
    router_llm_pipeline_except_ratelimiterror [label="router_llm_pipeline_except_ratelimiterror\n\np['fallback'] = True", fillcolor=wheat];
    start_llm_pipeline [label="start_llm_pipeline\n\np['model'] = 'gpt-4'", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_llm_pipeline -> call_llm;
    router_llm_pipeline_except_ratelimiterror -> call_fallback_llm;
    router_llm_pipeline_except_authenticationerror -> notify_admin;
    call_llm -> router_llm_pipeline_except_ratelimiterror [label="openai.RateLimitError", color="#DC143C", fontcolor="#DC143C"];
    call_llm -> router_llm_pipeline_except_authenticationerror [label="openai.AuthenticationError", color="#DC143C", fontcolor="#DC143C"];
    call_fallback_llm -> __end__;
    notify_admin -> __end__;
}