digraph "try_except_tuple_types" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_try_except_tuple_types; }

    fetch_data [label="fetch_data", fillcolor=lightblue];
    parse_data [label="parse_data", fillcolor=lightblue];
    queue_for_retry [label="queue_for_retry", fillcolor=lightsalmon];
    reject_input [label="reject_input", fillcolor=lightsalmon];
    router_try_except_tuple_types_except_connectionerror_timeouterror [label="router_try_except_tuple_types_except_connectionerror_timeouterror\n\np['retry_reason'] = 'transient'", fillcolor=wheat];
    router_try_except_tuple_types_except_valueerror_keyerror [label="router_try_except_tuple_types_except_valueerror_keyerror\n\np['status'] = 'bad_input'", fillcolor=wheat];
    start_try_except_tuple_types [label="start_try_except_tuple_types", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_try_except_tuple_types -> fetch_data;
    fetch_data -> parse_data;
    router_try_except_tuple_types_except_connectionerror_timeouterror -> queue_for_retry;
    router_try_except_tuple_types_except_valueerror_keyerror -> reject_input;
    fetch_data -> router_try_except_tuple_types_except_connectionerror_timeouterror [label="ConnectionError, TimeoutError", color="#DC143C", fontcolor="#DC143C"];
    fetch_data -> router_try_except_tuple_types_except_valueerror_keyerror [label="ValueError, KeyError", color="#DC143C", fontcolor="#DC143C"];
    parse_data -> router_try_except_tuple_types_except_connectionerror_timeouterror [label="ConnectionError, TimeoutError", color="#DC143C", fontcolor="#DC143C"];
    parse_data -> router_try_except_tuple_types_except_valueerror_keyerror [label="ValueError, KeyError", color="#DC143C", fontcolor="#DC143C"];
    queue_for_retry -> __end__;
    reject_input -> __end__;
}