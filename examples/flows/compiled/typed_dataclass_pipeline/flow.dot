digraph "typed_dataclass_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    classifier [label="classifier", fillcolor=lightblue];
    enricher [label="enricher", fillcolor=lightblue];
    extractor [label="extractor", fillcolor=lightblue];
    formatter [label="formatter", fillcolor=palegreen];
    start_typed_dataclass_pipeline [label="start_typed_dataclass_pipeline", fillcolor=palegreen];

    start_typed_dataclass_pipeline -> extractor;
    extractor -> classifier;
    classifier -> enricher;
    enricher -> formatter;
}