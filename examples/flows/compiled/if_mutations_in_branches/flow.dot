digraph "if_mutations_in_branches_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_if_mutations_in_branches_flow [label="end_if_mutations_in_branches_flow", fillcolor=palegreen];
    handler_finalize [label="handler_finalize", fillcolor=lightblue];
    handler_setup [label="handler_setup", fillcolor=lightblue];
    handler_type_a [label="handler_type_a", fillcolor=lightblue];
    handler_type_b [label="handler_type_b", fillcolor=lightblue];
    router_if_mutations_in_branches_flow_line_14_if_3 [label="router_if_mutations_in_branches_flow_line_14_if_3", fillcolor=wheat];
    router_if_mutations_in_branches_flow_line_15_seq_1 [label="router_if_mutations_in_branches_flow_line_15_seq_1", fillcolor=wheat];
    router_if_mutations_in_branches_flow_line_20_seq_2 [label="router_if_mutations_in_branches_flow_line_20_seq_2", fillcolor=wheat];
    start_if_mutations_in_branches_flow [label="start_if_mutations_in_branches_flow", fillcolor=palegreen];

    start_if_mutations_in_branches_flow -> handler_setup;
    start_if_mutations_in_branches_flow -> router_if_mutations_in_branches_flow_line_14_if_3;
    router_if_mutations_in_branches_flow_line_15_seq_1 -> handler_type_a;
    router_if_mutations_in_branches_flow_line_14_if_3 -> router_if_mutations_in_branches_flow_line_15_seq_1 [label="p['type'] == 'A'"];
    router_if_mutations_in_branches_flow_line_14_if_3 -> handler_finalize [label="p['type'] == 'A'"];
    router_if_mutations_in_branches_flow_line_14_if_3 -> handler_type_b [label="not (p['type'] == 'A')"];
    router_if_mutations_in_branches_flow_line_14_if_3 -> router_if_mutations_in_branches_flow_line_20_seq_2 [label="not (p['type'] == 'A')"];
    router_if_mutations_in_branches_flow_line_14_if_3 -> handler_finalize [label="not (p['type'] == 'A')"];
}