digraph "llm_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_llm_pipeline; }

    call_llm [label="call_llm", fillcolor=lightblue];
    parse_response [label="parse_response", fillcolor=lightblue];
    start_llm_pipeline [label="start_llm_pipeline\n\np['status'] = 'started'", fillcolor=palegreen];
    store_result [label="store_result", fillcolor=lightsalmon];
    validate_input [label="validate_input", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_llm_pipeline -> validate_input;
    validate_input -> call_llm;
    call_llm -> parse_response;
    parse_response -> store_result;
    store_result -> __end__;
    subgraph cluster_asyncio_timeout_120_ {
        label="asyncio.timeout(120)";
        style=dashed;
        call_llm;
        parse_response;
    }
}