digraph "content_pipeline_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_content_pipeline_flow; }

    router_content_pipeline_flow_line_15_if_2 [label="router_content_pipeline_flow_line_15_if_2", fillcolor=wheat];
    router_content_pipeline_flow_line_17_if_1 [label="router_content_pipeline_flow_line_17_if_1", fillcolor=wheat];
    start_content_pipeline_flow [label="start_content_pipeline_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_content_pipeline_flow -> router_content_pipeline_flow_line_15_if_2;
    router_content_pipeline_flow_line_15_if_2 -> router_content_pipeline_flow_line_17_if_1 [label="else", color="#D35400", fontcolor="#D35400"];
    router_content_pipeline_flow_line_17_if_1 -> __end__;
}