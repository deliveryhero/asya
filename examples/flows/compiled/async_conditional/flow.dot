digraph "content_pipeline_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_content_pipeline_flow; }

    router_content_pipeline_flow_if_content_type_eq_image [label="router_content_pipeline_flow_if_content_type_eq_image", fillcolor=wheat];
    router_content_pipeline_flow_if_content_type_eq_text [label="router_content_pipeline_flow_if_content_type_eq_text", fillcolor=wheat];
    start_content_pipeline_flow [label="start_content_pipeline_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_content_pipeline_flow -> router_content_pipeline_flow_if_content_type_eq_text;
    router_content_pipeline_flow_if_content_type_eq_text -> router_content_pipeline_flow_if_content_type_eq_image [label="else", color="#D35400", fontcolor="#D35400"];
    router_content_pipeline_flow_if_content_type_eq_image -> __end__;
}