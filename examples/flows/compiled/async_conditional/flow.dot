digraph "async_conditional" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_content_pipeline_flow; }

    classifier [label="classifier", fillcolor=lightblue];
    generic_processor [label="generic_processor", fillcolor=lightblue];
    image_processor [label="image_processor", fillcolor=lightblue];
    quality_check [label="quality_check", fillcolor=lightblue];
    router_content_pipeline_flow_line_16_if_2 [label="router_content_pipeline_flow_line_16_if_2", fillcolor=wheat];
    router_content_pipeline_flow_line_18_if_1 [label="router_content_pipeline_flow_line_18_if_1", fillcolor=wheat];
    start_content_pipeline_flow [label="start_content_pipeline_flow", fillcolor=palegreen];
    text_processor [label="text_processor", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_content_pipeline_flow -> classifier;
    classifier -> router_content_pipeline_flow_line_16_if_2;
    router_content_pipeline_flow_line_18_if_1 -> image_processor [label="p['content_type'] == 'image'"];
    router_content_pipeline_flow_line_18_if_1 -> generic_processor [label="not (p['content_type'] == 'image')"];
    router_content_pipeline_flow_line_16_if_2 -> text_processor [label="p['content_type'] == 'text'"];
    text_processor -> quality_check;
    router_content_pipeline_flow_line_16_if_2 -> router_content_pipeline_flow_line_18_if_1 [label="not (p['content_type'] == 'text')"];
    image_processor -> quality_check;
    generic_processor -> quality_check;
    quality_check -> __end__;
}