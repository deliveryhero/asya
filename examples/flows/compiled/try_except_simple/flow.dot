digraph "order_processing" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_order_processing [label="end_order_processing", fillcolor=palegreen];
    notify_rejection [label="notify_rejection", fillcolor=lightblue];
    router_order_processing_line_4_except_dispatch_0 [label="router_order_processing_line_4_except_dispatch_0", fillcolor=wheat];
    router_order_processing_line_4_reraise_0 [label="router_order_processing_line_4_reraise_0", fillcolor=wheat];
    router_order_processing_line_4_try_enter_0 [label="router_order_processing_line_4_try_enter_0", fillcolor=wheat];
    router_order_processing_line_4_try_exit_0 [label="router_order_processing_line_4_try_exit_0", fillcolor=wheat];
    router_order_processing_line_7_seq [label="router_order_processing_line_7_seq", fillcolor=wheat];
    start_order_processing [label="start_order_processing", fillcolor=palegreen];
    validate_order [label="validate_order", fillcolor=lightblue];

    start_order_processing -> router_order_processing_line_4_try_enter_0;
    router_order_processing_line_7_seq -> notify_rejection;
    router_order_processing_line_4_try_enter_0 -> validate_order;
    validate_order -> router_order_processing_line_4_try_exit_0;
    router_order_processing_line_4_except_dispatch_0 -> router_order_processing_line_7_seq [label="'ValueError' in _all_types"];
    router_order_processing_line_4_except_dispatch_0 -> router_order_processing_line_4_reraise_0 [label="not ('ValueError' in _all_types)"];
    notify_rejection -> end_order_processing;
    router_order_processing_line_4_reraise_0 -> end_order_processing;
    router_order_processing_line_4_try_exit_0 -> end_order_processing;
}