digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_order_processing [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = start_order_processing(p)</i></td></tr></table>>];
  router_order_processing_line_5_seq [fillcolor="wheat", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_order_processing_line_5_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['status'] = 'invalid'</td></tr></table>>];
  router_order_processing_line_2_try_enter_0 [fillcolor="lightcyan", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_order_processing_line_2_try_enter_0(p)</i></td></tr><tr><td bgcolor="lightcyan"><b>try</b></td></tr></table>>];
  router_order_processing_line_2_try_exit_0 [fillcolor="lightcyan", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_order_processing_line_2_try_exit_0(p)</i></td></tr><tr><td bgcolor="lightcyan"><b>try-exit</b> (success)</td></tr></table>>];
  router_order_processing_line_2_except_dispatch_0 [fillcolor="lightyellow", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_order_processing_line_2_except_disp…(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>except ValueError</b></td></tr></table>>];
  router_order_processing_line_2_reraise_0 [fillcolor="salmon", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = router_order_processing_line_2_reraise_0(p)</i></td></tr><tr><td bgcolor="salmon"><b>reraise</b></td></tr></table>>];
  end_order_processing [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = end_order_processing(p)</i></td></tr></table>>];
  notify_rejection [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = notify_rejection(p)</i></td></tr></table>>];
  validate_order [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = validate_order(p)</i></td></tr></table>>];

  router_order_processing_line_2_except_dispatch_0 -> router_order_processing_line_2_reraise_0 [color=red, label="unhandled"];
  router_order_processing_line_2_except_dispatch_0 -> router_order_processing_line_5_seq [color=orange, label="ValueError"];
  router_order_processing_line_2_try_enter_0 -> router_order_processing_line_2_except_dispatch_0 [color=orange, style=dashed, label="error"];
  router_order_processing_line_2_try_enter_0 -> validate_order;
  router_order_processing_line_2_try_exit_0 -> end_order_processing;
  router_order_processing_line_5_seq -> notify_rejection;
  start_order_processing -> router_order_processing_line_2_try_enter_0;
  validate_order -> router_order_processing_line_2_try_exit_0;
}