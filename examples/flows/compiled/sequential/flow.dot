digraph "sequential_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_sequential_flow; }

    handler_a [label="handler_a", fillcolor=lightblue];
    handler_b [label="handler_b", fillcolor=lightblue];
    handler_c [label="handler_c", fillcolor=lightblue];
    start_sequential_flow [label="start_sequential_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_sequential_flow -> handler_a;
    handler_a -> handler_b;
    handler_b -> handler_c;
    handler_c -> __end__;
}