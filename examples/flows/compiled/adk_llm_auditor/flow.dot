digraph flow {
  rankdir=TB;
  compound=true;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_llm_auditor [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await start_llm_auditor(p)</i></td></tr><tr><td bgcolor="white" align="left">p['iteration'] = 0</td></tr><tr><td bgcolor="white" align="left">p['status'] = 'started'</td></tr><tr><td bgcolor="white" align="left">p['partial'] = True</td></tr></table>>];
  router_llm_auditor_line_42_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_42_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['status'] = 'no_claims'</td></tr></table>>];
  router_llm_auditor_line_90_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_90_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['partial'] = False</td></tr></table>>];
  router_llm_auditor_line_66_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_66_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['prev_score'] = p['aggregate_score']</td></tr></table>>];
  router_llm_auditor_line_71_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_71_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['status'] = 'approved'</td></tr></table>>];
  router_llm_auditor_line_73_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_73_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['aggregate_score'] &gt;= 70</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  router_llm_auditor_line_84_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_84_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['status'] = 'max_iterations'</td></tr></table>>];
  router_llm_auditor_line_87_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_87_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['prev_score'] = p['aggregate_score']</td></tr></table>>];
  router_llm_auditor_line_83_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_83_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['iteration'] &gt;= p.get('max_iterations', 5)</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  router_llm_auditor_line_70_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_70_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['aggregate_score'] &gt;= 90</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  router_llm_auditor_line_65_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_65_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> p['aggregate_score'] &gt; p.get('prev_sc…score'] &lt; 70</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  fanout_llm_auditor_line_56 [fillcolor="lightblue", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanout_llm_auditor_line_56(p)</i></td></tr><tr><td bgcolor="mediumpurple2" align="center"><b>[fan-out:literal]</b></td></tr></table>>];
  router_llm_auditor_line_47_seq [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_47_seq(p)</i></td></tr><tr><td bgcolor="white" align="left">p['iteration'] += 1</td></tr></table>>];
  router_llm_auditor_line_46_loop_back_0 [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_46_loop_back…(p)</i></td></tr></table>>];
  router_llm_auditor_line_41_if [fillcolor="wheat", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await router_llm_auditor_line_41_if(p)</i></td></tr><tr><td bgcolor="lightyellow"><b>if</b> not p.get('claims')</td></tr><tr><td><table border="0" cellspacing="0" cellpadding="4"><tr><td bgcolor="darkseagreen4"><font color="white"><b>TRUE</b></font></td><td bgcolor="indianred4"><font color="white"><b>FALSE</b></font></td></tr></table></td></tr></table>>];
  end_llm_auditor [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await end_llm_auditor(p)</i></td></tr></table>>];
  accuracy_scorer [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await accuracy_scorer(p)</i></td></tr></table>>];
  adk_llm_auditor_QualityScorer_aggregate [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await QualityScorer.aggregate(p)</i></td></tr></table>>];
  completeness_scorer [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await completeness_scorer(p)</i></td></tr></table>>];
  critique [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await critique(p)</i></td></tr></table>>];
  deep_reviser [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await deep_reviser(p)</i></td></tr></table>>];
  extract_claims [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await extract_claims(p)</i></td></tr></table>>];
  fallback_generate [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fallback_generate(p)</i></td></tr></table>>];
  fanin_llm_auditor_line_56 [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await fanin_llm_auditor_line_56(p)</i></td></tr><tr><td bgcolor="mediumpurple1" align="center"><b>[fan-in]</b></td></tr></table>>];
  finalize [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await finalize(p)</i></td></tr></table>>];
  reviser [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await reviser(p)</i></td></tr></table>>];
  subgraph cluster_try_0 {
    style=dashed;
    color="snow4";
    fontname="Courier";
    fontsize=10;
    label="try";
    llm_generate [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = await llm_generate(p)</i></td></tr></table>>];
  }

  accuracy_scorer -> fanin_llm_auditor_line_56 [color=slateblue4, style=dashed];
  adk_llm_auditor_QualityScorer_aggregate -> router_llm_auditor_line_65_if;
  completeness_scorer -> fanin_llm_auditor_line_56 [color=slateblue4, style=dashed];
  critique -> deep_reviser;
  critique -> reviser;
  deep_reviser -> router_llm_auditor_line_83_if;
  extract_claims -> router_llm_auditor_line_41_if;
  fallback_generate -> fanout_llm_auditor_line_56;
  fanin_llm_auditor_line_56 -> adk_llm_auditor_QualityScorer_aggregate;
  fanout_llm_auditor_line_56 -> accuracy_scorer [color=mediumpurple4, label="slice 1", style=bold];
  fanout_llm_auditor_line_56 -> completeness_scorer [color=mediumpurple4, label="slice 2", style=bold];
  fanout_llm_auditor_line_56 -> fanin_llm_auditor_line_56 [color=mediumpurple4, label="slice 0\n(parent)", style=dashed];
  finalize -> end_llm_auditor;
  llm_generate -> fallback_generate [ltail=cluster_try_0, color=snow4, style=dashed, label="except", constraint=false];
  llm_generate -> fanout_llm_auditor_line_56;
  reviser -> router_llm_auditor_line_83_if;
  router_llm_auditor_line_41_if -> router_llm_auditor_line_42_seq [label="T", color=darkseagreen4];
  router_llm_auditor_line_41_if -> router_llm_auditor_line_46_loop_back_0 [label="F", color=indianred4];
  router_llm_auditor_line_42_seq -> end_llm_auditor;
  router_llm_auditor_line_46_loop_back_0 -> router_llm_auditor_line_47_seq [constraint=false];
  router_llm_auditor_line_47_seq -> llm_generate;
  router_llm_auditor_line_65_if -> router_llm_auditor_line_66_seq [label="T", color=darkseagreen4];
  router_llm_auditor_line_65_if -> router_llm_auditor_line_70_if [label="F", color=indianred4];
  router_llm_auditor_line_66_seq -> router_llm_auditor_line_46_loop_back_0;
  router_llm_auditor_line_70_if -> router_llm_auditor_line_71_seq [label="T", color=darkseagreen4];
  router_llm_auditor_line_70_if -> router_llm_auditor_line_73_if [label="F", color=indianred4];
  router_llm_auditor_line_71_seq -> end_llm_auditor;
  router_llm_auditor_line_73_if -> critique [label="F", color=indianred4];
  router_llm_auditor_line_73_if -> critique [label="T", color=darkseagreen4];
  router_llm_auditor_line_83_if -> router_llm_auditor_line_84_seq [label="T", color=darkseagreen4];
  router_llm_auditor_line_83_if -> router_llm_auditor_line_87_seq [label="F", color=indianred4];
  router_llm_auditor_line_84_seq -> router_llm_auditor_line_90_seq;
  router_llm_auditor_line_87_seq -> router_llm_auditor_line_46_loop_back_0;
  router_llm_auditor_line_90_seq -> finalize;
  start_llm_auditor -> extract_claims;
}