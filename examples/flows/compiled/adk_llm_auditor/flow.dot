digraph "llm_auditor" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    accuracy_scorer [label="accuracy_scorer", fillcolor=lightblue];
    adk_llm_auditor_QualityScorer_aggregate [label="QualityScorer.aggregate", fillcolor=lightblue];
    completeness_scorer [label="completeness_scorer", fillcolor=lightblue];
    critique [label="critique", fillcolor=lightblue];
    deep_reviser [label="deep_reviser", fillcolor=lightblue];
    extract_claims [label="extract_claims", fillcolor=lightblue];
    fallback_generate [label="fallback_generate", fillcolor=palegreen];
    fanin_llm_auditor_line_56 [label="fanin_llm_auditor_line_56", fillcolor=lightblue];
    fanout_llm_auditor_line_56 [label="fanout_llm_auditor_line_56", fillcolor=wheat];
    finalize [label="finalize", fillcolor=palegreen];
    llm_generate [label="llm_generate", fillcolor=lightblue];
    reviser [label="reviser", fillcolor=lightblue];
    router_llm_auditor_line_41_if [label="router_llm_auditor_line_41_if", fillcolor=wheat];
    router_llm_auditor_line_42_seq [label="router_llm_auditor_line_42_seq", fillcolor=palegreen];
    router_llm_auditor_line_46_loop_back_0 [label="router_llm_auditor_line_46_loop_back_0", fillcolor=wheat];
    router_llm_auditor_line_47_seq [label="router_llm_auditor_line_47_seq", fillcolor=wheat];
    router_llm_auditor_line_50_except_dispatch_0 [label="router_llm_auditor_line_50_except_dispatch_0", fillcolor=wheat];
    router_llm_auditor_line_50_try_enter_0 [label="router_llm_auditor_line_50_try_enter_0", fillcolor=wheat];
    router_llm_auditor_line_50_try_exit_0 [label="router_llm_auditor_line_50_try_exit_0", fillcolor=wheat];
    router_llm_auditor_line_65_if [label="router_llm_auditor_line_65_if", fillcolor=wheat];
    router_llm_auditor_line_66_seq [label="router_llm_auditor_line_66_seq", fillcolor=wheat];
    router_llm_auditor_line_70_if [label="router_llm_auditor_line_70_if", fillcolor=wheat];
    router_llm_auditor_line_71_seq [label="router_llm_auditor_line_71_seq", fillcolor=palegreen];
    router_llm_auditor_line_73_if [label="router_llm_auditor_line_73_if", fillcolor=wheat];
    router_llm_auditor_line_83_if [label="router_llm_auditor_line_83_if", fillcolor=wheat];
    router_llm_auditor_line_84_seq [label="router_llm_auditor_line_84_seq", fillcolor=wheat];
    router_llm_auditor_line_87_seq [label="router_llm_auditor_line_87_seq", fillcolor=palegreen];
    router_llm_auditor_line_90_seq [label="router_llm_auditor_line_90_seq", fillcolor=wheat];
    start_llm_auditor [label="start_llm_auditor", fillcolor=palegreen];

    start_llm_auditor -> extract_claims;
    extract_claims -> router_llm_auditor_line_41_if;
    router_llm_auditor_line_90_seq -> finalize;
    router_llm_auditor_line_66_seq -> router_llm_auditor_line_46_loop_back_0;
    router_llm_auditor_line_73_if -> critique [label="p['aggregate_score'] >= 70"];
    critique -> reviser;
    reviser -> router_llm_auditor_line_83_if;
    router_llm_auditor_line_73_if -> critique [label="not (p['aggregate_score'] >= 70)"];
    critique -> deep_reviser;
    deep_reviser -> router_llm_auditor_line_83_if;
    router_llm_auditor_line_84_seq -> router_llm_auditor_line_90_seq;
    router_llm_auditor_line_83_if -> router_llm_auditor_line_84_seq [label="p['iteration'] >= p.get('max_iterations', 5)"];
    router_llm_auditor_line_83_if -> router_llm_auditor_line_87_seq [label="not (p['iteration'] >= p.get('max_iterations', 5))"];
    router_llm_auditor_line_70_if -> router_llm_auditor_line_71_seq [label="p['aggregate_score'] >= 90"];
    router_llm_auditor_line_70_if -> router_llm_auditor_line_73_if [label="not (p['aggregate_score'] >= 90)"];
    router_llm_auditor_line_65_if -> router_llm_auditor_line_66_seq [label="p['aggregate_score'] > p.get('prev_score', 0) and p['aggregate_score'] < 70"];
    router_llm_auditor_line_65_if -> router_llm_auditor_line_70_if [label="not (p['aggregate_score'] > p.get('prev_score', 0) and p['aggregate_score'] < 70)"];
    fanout_llm_auditor_line_56 -> fanin_llm_auditor_line_56 [label="fanout"];
    fanin_llm_auditor_line_56 -> adk_llm_auditor_QualityScorer_aggregate;
    adk_llm_auditor_QualityScorer_aggregate -> router_llm_auditor_line_65_if;
    fanout_llm_auditor_line_56 -> accuracy_scorer;
    accuracy_scorer -> fanin_llm_auditor_line_56;
    fanout_llm_auditor_line_56 -> completeness_scorer;
    completeness_scorer -> fanin_llm_auditor_line_56;
    router_llm_auditor_line_50_try_enter_0 -> llm_generate;
    llm_generate -> router_llm_auditor_line_50_try_exit_0;
    router_llm_auditor_line_50_try_exit_0 -> fanout_llm_auditor_line_56;
    router_llm_auditor_line_50_except_dispatch_0 -> fanout_llm_auditor_line_56;
    router_llm_auditor_line_50_except_dispatch_0 -> fallback_generate [label="True"];
    router_llm_auditor_line_47_seq -> router_llm_auditor_line_50_try_enter_0;
    router_llm_auditor_line_46_loop_back_0 -> router_llm_auditor_line_47_seq;
    router_llm_auditor_line_41_if -> router_llm_auditor_line_42_seq [label="not p.get('claims')"];
    router_llm_auditor_line_41_if -> router_llm_auditor_line_46_loop_back_0 [label="not (not p.get('claims'))"];
    router_llm_auditor_line_50_try_enter_0 -> router_llm_auditor_line_46_loop_back_0;
}