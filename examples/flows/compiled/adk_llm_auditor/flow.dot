digraph "llm_auditor" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_llm_auditor; }

    accuracy_scorer [label="accuracy_scorer", fillcolor=lightblue];
    adk_llm_auditor_QualityScorer_aggregate [label="QualityScorer.aggregate", fillcolor=lightblue];
    completeness_scorer [label="completeness_scorer", fillcolor=lightblue];
    fanin_llm_auditor_scores [label="fanin_llm_auditor_scores", fillcolor=lightblue];
    router_llm_auditor_except_all [label="router_llm_auditor_except_all", fillcolor=wheat];
    router_llm_auditor_fanout_scores [label="router_llm_auditor_fanout_scores", fillcolor=wheat];
    router_llm_auditor_if_aggregate_score_ge_70 [label="router_llm_auditor_if_aggregate_score_ge_70", fillcolor=wheat];
    router_llm_auditor_if_aggregate_score_ge_90 [label="router_llm_auditor_if_aggregate_score_ge_90", fillcolor=wheat];
    router_llm_auditor_if_aggregate_score_gt_prev_score_and_7a47b9 [label="router_llm_auditor_if_aggregate_score_gt_prev_score_and_7a47b9", fillcolor=wheat];
    router_llm_auditor_if_iteration_ge_max_iterations [label="router_llm_auditor_if_iteration_ge_max_iterations", fillcolor=wheat];
    router_llm_auditor_if_not_claims [label="router_llm_auditor_if_not_claims\n\np['iteration'] = 0\np['status'] = 'started'\np['partial'] = True", fillcolor=wheat];
    router_llm_auditor_seq_set_iteration [label="router_llm_auditor_seq_set_iteration\n\np['iteration'] += 1", fillcolor=wheat];
    router_llm_auditor_seq_set_partial [label="router_llm_auditor_seq_set_partial\n\np['partial'] = False", fillcolor=wheat];
    router_llm_auditor_seq_set_prev_score [label="router_llm_auditor_seq_set_prev_score\n\np['prev_score'] = p['aggregate_score']", fillcolor=wheat];
    router_llm_auditor_seq_set_prev_score_2 [label="router_llm_auditor_seq_set_prev_score_2\n\np['prev_score'] = p['aggregate_score']", fillcolor=wheat];
    router_llm_auditor_seq_set_status [label="router_llm_auditor_seq_set_status\n\np['status'] = 'max_iterations'", fillcolor=wheat];
    router_llm_auditor_seq_set_status_2 [label="router_llm_auditor_seq_set_status_2\n\np['status'] = 'approved'", fillcolor=wheat];
    router_llm_auditor_seq_set_status_3 [label="router_llm_auditor_seq_set_status_3\n\np['status'] = 'no_claims'", fillcolor=wheat];
    router_llm_auditor_while_loop [label="router_llm_auditor_while_loop", fillcolor=wheat];
    start_llm_auditor [label="start_llm_auditor", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_llm_auditor -> router_llm_auditor_if_not_claims;
    router_llm_auditor_seq_set_status -> router_llm_auditor_seq_set_partial;
    router_llm_auditor_if_iteration_ge_max_iterations -> router_llm_auditor_seq_set_prev_score [label="else", color="#D35400", fontcolor="#D35400"];
    router_llm_auditor_if_iteration_ge_max_iterations -> router_llm_auditor_seq_set_status [label="p['iteration'] >= p.get('max_iterations', 5)", color="#2E8B57", fontcolor="#2E8B57"];
    router_llm_auditor_if_aggregate_score_ge_90 -> router_llm_auditor_if_aggregate_score_ge_70 [label="else", color="#D35400", fontcolor="#D35400"];
    router_llm_auditor_if_aggregate_score_ge_70 -> router_llm_auditor_if_iteration_ge_max_iterations;
    router_llm_auditor_if_aggregate_score_ge_90 -> router_llm_auditor_seq_set_status_2 [label="p['aggregate_score'] >= 90", color="#2E8B57", fontcolor="#2E8B57"];
    router_llm_auditor_seq_set_prev_score_2 -> router_llm_auditor_while_loop;
    router_llm_auditor_if_aggregate_score_gt_prev_score_and_7a47b9 -> router_llm_auditor_seq_set_prev_score_2 [label="p['aggregate_score'] > p.get('prev_score', 0) and p['aggregate_score'] < 70", color="#2E8B57", fontcolor="#2E8B57"];
    router_llm_auditor_if_aggregate_score_gt_prev_score_and_7a47b9 -> router_llm_auditor_if_aggregate_score_ge_90 [label="else", color="#D35400", fontcolor="#D35400"];
    router_llm_auditor_fanout_scores -> fanin_llm_auditor_scores [label="fanout", color="#6C35EA", fontcolor="#6C35EA"];
    fanin_llm_auditor_scores -> adk_llm_auditor_QualityScorer_aggregate;
    adk_llm_auditor_QualityScorer_aggregate -> router_llm_auditor_if_aggregate_score_gt_prev_score_and_7a47b9;
    router_llm_auditor_fanout_scores -> accuracy_scorer;
    accuracy_scorer -> fanin_llm_auditor_scores;
    router_llm_auditor_fanout_scores -> completeness_scorer;
    completeness_scorer -> fanin_llm_auditor_scores;
    router_llm_auditor_except_all -> router_llm_auditor_fanout_scores;
    router_llm_auditor_seq_set_iteration -> router_llm_auditor_fanout_scores;
    router_llm_auditor_while_loop -> router_llm_auditor_seq_set_iteration;
    router_llm_auditor_if_not_claims -> router_llm_auditor_while_loop [label="else", color="#D35400", fontcolor="#D35400"];
    router_llm_auditor_if_not_claims -> router_llm_auditor_seq_set_status_3 [label="not p.get('claims')", color="#2E8B57", fontcolor="#2E8B57"];
    router_llm_auditor_fanout_scores -> router_llm_auditor_while_loop;
    router_llm_auditor_seq_set_partial -> __end__;
    router_llm_auditor_seq_set_prev_score -> __end__;
    router_llm_auditor_seq_set_status_2 -> __end__;
    router_llm_auditor_seq_set_status_3 -> __end__;
}