digraph "conditional_nested_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_conditional_nested_flow; }

    handler_a [label="handler_a", fillcolor=lightblue];
    handler_b [label="handler_b", fillcolor=lightblue];
    handler_c [label="handler_c", fillcolor=lightsalmon];
    handler_d [label="handler_d", fillcolor=lightblue];
    handler_finalize [label="handler_finalize", fillcolor=lightblue];
    handler_validate_input [label="handler_validate_input", fillcolor=lightblue];
    router_conditional_nested_flow_if_a_eq_a [label="router_conditional_nested_flow_if_a_eq_a\n\np['x'] = 1", fillcolor=wheat];
    router_conditional_nested_flow_if_x_gt_2 [label="router_conditional_nested_flow_if_x_gt_2\n\np['x'] += 2", fillcolor=wheat];
    router_conditional_nested_flow_if_x_gt_2_2 [label="router_conditional_nested_flow_if_x_gt_2_2", fillcolor=wheat];
    router_conditional_nested_flow_seq_set_x [label="router_conditional_nested_flow_seq_set_x\n\np['x'] += 9\np['x'] *= 10", fillcolor=wheat];
    router_conditional_nested_flow_seq_set_x_2 [label="router_conditional_nested_flow_seq_set_x_2\n\np['x'] += 8", fillcolor=wheat];
    router_conditional_nested_flow_seq_set_x_3 [label="router_conditional_nested_flow_seq_set_x_3\n\np['x'] += 4", fillcolor=wheat];
    router_conditional_nested_flow_seq_set_x_4 [label="router_conditional_nested_flow_seq_set_x_4\n\np['x'] += 3", fillcolor=wheat];
    router_conditional_nested_flow_seq_set_x_5 [label="router_conditional_nested_flow_seq_set_x_5\n\np['x'] += 5", fillcolor=wheat];
    router_conditional_nested_flow_seq_set_x_6 [label="router_conditional_nested_flow_seq_set_x_6\n\np['x'] += 7", fillcolor=wheat];
    router_conditional_nested_flow_seq_set_x_7 [label="router_conditional_nested_flow_seq_set_x_7\n\np['x'] += 6", fillcolor=wheat];
    router_conditional_nested_flow_seq_set_x_8 [label="router_conditional_nested_flow_seq_set_x_8\n\np['x'] += 1", fillcolor=wheat];
    start_conditional_nested_flow [label="start_conditional_nested_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_conditional_nested_flow -> handler_validate_input;
    handler_validate_input -> router_conditional_nested_flow_if_a_eq_a;
    router_conditional_nested_flow_seq_set_x_2 -> handler_finalize;
    handler_finalize -> router_conditional_nested_flow_seq_set_x;
    router_conditional_nested_flow_seq_set_x_4 -> handler_b;
    handler_b -> router_conditional_nested_flow_seq_set_x_3;
    router_conditional_nested_flow_seq_set_x_5 -> handler_c;
    router_conditional_nested_flow_if_x_gt_2 -> router_conditional_nested_flow_seq_set_x_4 [label="p['x'] > 2", color="#2E8B57", fontcolor="#2E8B57"];
    router_conditional_nested_flow_if_x_gt_2 -> router_conditional_nested_flow_seq_set_x_5 [label="else", color="#D35400", fontcolor="#D35400"];
    router_conditional_nested_flow_seq_set_x_7 -> handler_d;
    handler_d -> router_conditional_nested_flow_seq_set_x_6;
    router_conditional_nested_flow_if_x_gt_2_2 -> handler_b [label="p['x'] > 2", color="#2E8B57", fontcolor="#2E8B57"];
    handler_b -> router_conditional_nested_flow_if_x_gt_2;
    router_conditional_nested_flow_if_x_gt_2_2 -> router_conditional_nested_flow_seq_set_x_7 [label="else", color="#D35400", fontcolor="#D35400"];
    router_conditional_nested_flow_seq_set_x_8 -> handler_a;
    handler_a -> router_conditional_nested_flow_if_x_gt_2_2;
    router_conditional_nested_flow_if_a_eq_a -> router_conditional_nested_flow_seq_set_x_8 [label="p['a'] == 'A'", color="#2E8B57", fontcolor="#2E8B57"];
    router_conditional_nested_flow_if_a_eq_a -> router_conditional_nested_flow_seq_set_x_2 [label="else", color="#D35400", fontcolor="#D35400"];
    router_conditional_nested_flow_seq_set_x_3 -> router_conditional_nested_flow_seq_set_x_2;
    router_conditional_nested_flow_seq_set_x_6 -> router_conditional_nested_flow_seq_set_x_2;
    handler_c -> __end__;
    router_conditional_nested_flow_seq_set_x -> __end__;
}