digraph "ingestion_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_ingestion_pipeline; }

    data_fetcher [label="data_fetcher", fillcolor=lightblue];
    data_parser [label="data_parser", fillcolor=lightblue];
    data_validator [label="data_validator", fillcolor=lightblue];
    data_writer [label="data_writer", fillcolor=lightsalmon];
    start_ingestion_pipeline [label="start_ingestion_pipeline", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_ingestion_pipeline -> data_fetcher;
    data_fetcher -> data_parser;
    data_parser -> data_validator;
    data_validator -> data_writer;
    data_writer -> __end__;
}