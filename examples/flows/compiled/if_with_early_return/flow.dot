digraph "early_return_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    handler_error [label="handler_error", fillcolor=palegreen];
    handler_finalize [label="handler_finalize", fillcolor=palegreen];
    handler_process [label="handler_process", fillcolor=lightblue];
    handler_validate [label="handler_validate", fillcolor=lightblue];
    router_early_return_flow_line_14_if_1 [label="router_early_return_flow_line_14_if_1", fillcolor=wheat];
    start_early_return_flow [label="start_early_return_flow", fillcolor=palegreen];

    start_early_return_flow -> handler_validate;
    handler_validate -> router_early_return_flow_line_14_if_1;
    router_early_return_flow_line_14_if_1 -> handler_process [label="not (not p['valid'])"];
    handler_process -> handler_finalize;
    router_early_return_flow_line_14_if_1 -> handler_error [label="not p['valid']"];
}