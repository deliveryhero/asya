digraph "review_pipeline_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_review_pipeline_flow; }

    router_review_pipeline_flow_line_16_if_1 [label="router_review_pipeline_flow_line_16_if_1", fillcolor=wheat];
    start_review_pipeline_flow [label="start_review_pipeline_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_review_pipeline_flow -> router_review_pipeline_flow_line_16_if_1;
    router_review_pipeline_flow_line_16_if_1 -> __end__;
}