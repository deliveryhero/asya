digraph "data_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_data_pipeline; }

    handle_runtime_error [label="handle_runtime_error", fillcolor=lightsalmon];
    handle_type_error [label="handle_type_error", fillcolor=lightsalmon];
    handle_validation_error [label="handle_validation_error", fillcolor=lightsalmon];
    parse_input [label="parse_input", fillcolor=lightblue];
    router_data_pipeline_line_10_except_4 [label="router_data_pipeline_line_10_except_4", fillcolor=wheat];
    router_data_pipeline_line_11_seq_3 [label="router_data_pipeline_line_11_seq_3\n\np['error_type'] = 'type_mismatch'", fillcolor=wheat];
    router_data_pipeline_line_13_except_6 [label="router_data_pipeline_line_13_except_6", fillcolor=wheat];
    router_data_pipeline_line_14_seq_5 [label="router_data_pipeline_line_14_seq_5\n\np['error_type'] = 'runtime'", fillcolor=wheat];
    router_data_pipeline_line_7_except_2 [label="router_data_pipeline_line_7_except_2", fillcolor=wheat];
    router_data_pipeline_line_8_seq_1 [label="router_data_pipeline_line_8_seq_1\n\np['error_type'] = 'validation'", fillcolor=wheat];
    start_data_pipeline [label="start_data_pipeline", fillcolor=palegreen];
    transform_data [label="transform_data", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_data_pipeline -> parse_input;
    parse_input -> transform_data;
    router_data_pipeline_line_8_seq_1 -> handle_validation_error;
    router_data_pipeline_line_7_except_2 -> router_data_pipeline_line_8_seq_1;
    router_data_pipeline_line_11_seq_3 -> handle_type_error;
    router_data_pipeline_line_10_except_4 -> router_data_pipeline_line_11_seq_3;
    router_data_pipeline_line_14_seq_5 -> handle_runtime_error;
    router_data_pipeline_line_13_except_6 -> router_data_pipeline_line_14_seq_5;
    parse_input -> router_data_pipeline_line_7_except_2 [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    parse_input -> router_data_pipeline_line_10_except_4 [label="TypeError", color="#DC143C", fontcolor="#DC143C"];
    parse_input -> router_data_pipeline_line_13_except_6 [label="RuntimeError", color="#DC143C", fontcolor="#DC143C"];
    transform_data -> router_data_pipeline_line_7_except_2 [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    transform_data -> router_data_pipeline_line_10_except_4 [label="TypeError", color="#DC143C", fontcolor="#DC143C"];
    transform_data -> router_data_pipeline_line_13_except_6 [label="RuntimeError", color="#DC143C", fontcolor="#DC143C"];
    handle_runtime_error -> __end__;
    handle_type_error -> __end__;
    handle_validation_error -> __end__;
}