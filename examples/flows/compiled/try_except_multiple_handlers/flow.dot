digraph "data_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    handle_runtime_error [label="handle_runtime_error", fillcolor=palegreen];
    handle_type_error [label="handle_type_error", fillcolor=palegreen];
    handle_validation_error [label="handle_validation_error", fillcolor=palegreen];
    parse_input [label="parse_input", fillcolor=lightblue];
    router_data_pipeline_line_11_seq [label="router_data_pipeline_line_11_seq", fillcolor=wheat];
    router_data_pipeline_line_14_seq [label="router_data_pipeline_line_14_seq", fillcolor=wheat];
    router_data_pipeline_line_4_except_dispatch_0 [label="router_data_pipeline_line_4_except_dispatch_0", fillcolor=wheat];
    router_data_pipeline_line_4_reraise_0 [label="router_data_pipeline_line_4_reraise_0", fillcolor=palegreen];
    router_data_pipeline_line_4_try_enter_0 [label="router_data_pipeline_line_4_try_enter_0", fillcolor=wheat];
    router_data_pipeline_line_4_try_exit_0 [label="router_data_pipeline_line_4_try_exit_0", fillcolor=palegreen];
    router_data_pipeline_line_8_seq [label="router_data_pipeline_line_8_seq", fillcolor=wheat];
    start_data_pipeline [label="start_data_pipeline", fillcolor=palegreen];
    transform_data [label="transform_data", fillcolor=lightblue];

    start_data_pipeline -> router_data_pipeline_line_4_try_enter_0;
    router_data_pipeline_line_8_seq -> handle_validation_error;
    router_data_pipeline_line_11_seq -> handle_type_error;
    router_data_pipeline_line_14_seq -> handle_runtime_error;
    router_data_pipeline_line_4_try_enter_0 -> parse_input;
    parse_input -> transform_data;
    transform_data -> router_data_pipeline_line_4_try_exit_0;
    router_data_pipeline_line_4_except_dispatch_0 -> router_data_pipeline_line_8_seq [label="'ValueError' in _all_types"];
    router_data_pipeline_line_4_except_dispatch_0 -> router_data_pipeline_line_11_seq [label="'TypeError' in _all_types"];
    router_data_pipeline_line_4_except_dispatch_0 -> router_data_pipeline_line_14_seq [label="'RuntimeError' in _all_types"];
    router_data_pipeline_line_4_except_dispatch_0 -> router_data_pipeline_line_4_reraise_0 [label="not ('RuntimeError' in _all_types)"];
}