digraph "try_except_multiple_handlers" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_try_except_multiple_handlers; }

    handle_runtime_error [label="handle_runtime_error", fillcolor=lightsalmon];
    handle_type_error [label="handle_type_error", fillcolor=lightsalmon];
    handle_validation_error [label="handle_validation_error", fillcolor=lightsalmon];
    parse_input [label="parse_input", fillcolor=lightblue];
    router_try_except_multiple_handlers_except_runtimeerror [label="router_try_except_multiple_handlers_except_runtimeerror\n\np['error_type'] = 'runtime'", fillcolor=wheat];
    router_try_except_multiple_handlers_except_typeerror [label="router_try_except_multiple_handlers_except_typeerror\n\np['error_type'] = 'type_mismatch'", fillcolor=wheat];
    router_try_except_multiple_handlers_except_valueerror [label="router_try_except_multiple_handlers_except_valueerror\n\np['error_type'] = 'validation'", fillcolor=wheat];
    start_try_except_multiple_handlers [label="start_try_except_multiple_handlers", fillcolor=palegreen];
    transform_data [label="transform_data", fillcolor=lightblue];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_try_except_multiple_handlers -> parse_input;
    parse_input -> transform_data;
    router_try_except_multiple_handlers_except_valueerror -> handle_validation_error;
    router_try_except_multiple_handlers_except_typeerror -> handle_type_error;
    router_try_except_multiple_handlers_except_runtimeerror -> handle_runtime_error;
    parse_input -> router_try_except_multiple_handlers_except_valueerror [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    parse_input -> router_try_except_multiple_handlers_except_typeerror [label="TypeError", color="#DC143C", fontcolor="#DC143C"];
    parse_input -> router_try_except_multiple_handlers_except_runtimeerror [label="RuntimeError", color="#DC143C", fontcolor="#DC143C"];
    transform_data -> router_try_except_multiple_handlers_except_valueerror [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    transform_data -> router_try_except_multiple_handlers_except_typeerror [label="TypeError", color="#DC143C", fontcolor="#DC143C"];
    transform_data -> router_try_except_multiple_handlers_except_runtimeerror [label="RuntimeError", color="#DC143C", fontcolor="#DC143C"];
    handle_runtime_error -> __end__;
    handle_type_error -> __end__;
    handle_validation_error -> __end__;
}