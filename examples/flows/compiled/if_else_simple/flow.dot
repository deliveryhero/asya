digraph "if_else_simple_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_if_else_simple_flow; }

    handler_finalize [label="handler_finalize", fillcolor=lightblue];
    handler_setup [label="handler_setup", fillcolor=lightblue];
    handler_type_a [label="handler_type_a", fillcolor=lightblue];
    handler_type_b [label="handler_type_b", fillcolor=lightblue];
    router_if_else_simple_flow_line_14_if_1 [label="router_if_else_simple_flow_line_14_if_1", fillcolor=wheat];
    start_if_else_simple_flow [label="start_if_else_simple_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_if_else_simple_flow -> handler_setup;
    handler_setup -> router_if_else_simple_flow_line_14_if_1;
    router_if_else_simple_flow_line_14_if_1 -> handler_type_a [label="p['type'] == 'A'", color="#2E8B57", fontcolor="#2E8B57"];
    handler_type_a -> handler_finalize;
    router_if_else_simple_flow_line_14_if_1 -> handler_type_b [label="else", color="#D35400", fontcolor="#D35400"];
    handler_type_b -> handler_finalize;
    handler_finalize -> __end__;
}