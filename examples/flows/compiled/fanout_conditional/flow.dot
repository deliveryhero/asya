digraph "adaptive_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_adaptive_flow; }

    deep_analyzer [label="deep_analyzer", fillcolor=lightblue];
    fanin_adaptive_flow_line_16 [label="fanin_adaptive_flow_line_16", fillcolor=lightblue];
    fast_analyzer [label="fast_analyzer", fillcolor=lightblue];
    router_adaptive_flow_line_15_if_2 [label="router_adaptive_flow_line_15_if_2", fillcolor=wheat];
    router_adaptive_flow_line_16_fanout_1 [label="router_adaptive_flow_line_16_fanout_1", fillcolor=wheat];
    start_adaptive_flow [label="start_adaptive_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_adaptive_flow -> router_adaptive_flow_line_15_if_2;
    router_adaptive_flow_line_16_fanout_1 -> fanin_adaptive_flow_line_16 [label="fanout", color="#6C35EA", fontcolor="#6C35EA"];
    router_adaptive_flow_line_16_fanout_1 -> fast_analyzer;
    fast_analyzer -> fanin_adaptive_flow_line_16;
    router_adaptive_flow_line_16_fanout_1 -> deep_analyzer;
    deep_analyzer -> fanin_adaptive_flow_line_16;
    router_adaptive_flow_line_15_if_2 -> router_adaptive_flow_line_16_fanout_1 [label="p['parallel']", color="#2E8B57", fontcolor="#2E8B57"];
    router_adaptive_flow_line_15_if_2 -> router_adaptive_flow_line_16_fanout_1 [label="else", color="#D35400", fontcolor="#D35400"];
    fanin_adaptive_flow_line_16 -> __end__;
}