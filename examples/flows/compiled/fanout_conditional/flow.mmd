flowchart TD
    %% Flow: adaptive_flow

    classifier[classifier]
    deep_analyzer[deep_analyzer]
    fanin_adaptive_flow_results[fanin_adaptive_flow_results]
    fast_analyzer[fast_analyzer]
    formatter[formatter]
    router_adaptive_flow_fanout_results{{router_adaptive_flow_fanout_results}}
    router_adaptive_flow_if_parallel{{router_adaptive_flow_if_parallel}}
    sequential_analyzer[sequential_analyzer]
    start_adaptive_flow([start_adaptive_flow])
    __end__((( )))

    start_adaptive_flow --> classifier
    classifier --> router_adaptive_flow_if_parallel
    router_adaptive_flow_fanout_results -->|"fanout"| fanin_adaptive_flow_results
    router_adaptive_flow_fanout_results --> fast_analyzer
    fast_analyzer --> fanin_adaptive_flow_results
    router_adaptive_flow_fanout_results --> deep_analyzer
    deep_analyzer --> fanin_adaptive_flow_results
    router_adaptive_flow_if_parallel -->|"p['parallel']"| router_adaptive_flow_fanout_results
    router_adaptive_flow_fanout_results --> formatter
    router_adaptive_flow_if_parallel -->|"else"| sequential_analyzer
    sequential_analyzer --> formatter
    fanin_adaptive_flow_results --> formatter
    formatter --> __end__

    classDef start fill:#98FB98,stroke:#333
    classDef endnode fill:#FFA07A,stroke:#333
    classDef router fill:#F5DEB3,stroke:#333
    classDef handler fill:#ADD8E6,stroke:#333
    classDef endpoint fill:#000,stroke:#333,color:#fff
    class start_adaptive_flow start
    class formatter endnode
    class router_adaptive_flow_fanout_results,router_adaptive_flow_if_parallel router
    class classifier,deep_analyzer,fanin_adaptive_flow_results,fast_analyzer,sequential_analyzer handler
    class __end__ endpoint
    linkStyle 7 stroke:#2E8B57
    linkStyle 2 stroke:#7B68EE
    linkStyle 9 stroke:#E07040