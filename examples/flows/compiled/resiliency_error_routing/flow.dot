digraph "failover_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_failover_pipeline; }

    call_fallback [label="call_fallback", fillcolor=lightblue];
    call_primary [label="call_primary", fillcolor=lightblue];
    finalize [label="finalize", fillcolor=lightsalmon];
    handle_validation_error [label="handle_validation_error", fillcolor=lightblue];
    router_failover_pipeline_line_26_except_2 [label="router_failover_pipeline_line_26_except_2", fillcolor=wheat];
    router_failover_pipeline_line_27_seq_1 [label="router_failover_pipeline_line_27_seq_1\n\np['fallback'] = True", fillcolor=wheat];
    router_failover_pipeline_line_29_except_4 [label="router_failover_pipeline_line_29_except_4", fillcolor=wheat];
    router_failover_pipeline_line_30_seq_3 [label="router_failover_pipeline_line_30_seq_3\n\np['error_type'] = 'validation'", fillcolor=wheat];
    start_failover_pipeline [label="start_failover_pipeline\n\np['status'] = 'started'", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_failover_pipeline -> call_primary;
    call_primary -> finalize;
    router_failover_pipeline_line_27_seq_1 -> call_fallback;
    router_failover_pipeline_line_26_except_2 -> router_failover_pipeline_line_27_seq_1;
    router_failover_pipeline_line_30_seq_3 -> handle_validation_error;
    router_failover_pipeline_line_29_except_4 -> router_failover_pipeline_line_30_seq_3;
    call_primary -> router_failover_pipeline_line_26_except_2 [label="ConnectionError", color="#DC143C", fontcolor="#DC143C"];
    call_primary -> router_failover_pipeline_line_29_except_4 [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    call_fallback -> finalize;
    handle_validation_error -> finalize;
    finalize -> __end__;
}