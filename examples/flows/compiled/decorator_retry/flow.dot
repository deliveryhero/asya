digraph "resilient_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_resilient_pipeline; }

    fetch_data [label="fetch_data", fillcolor=lightblue];
    start_resilient_pipeline [label="start_resilient_pipeline\n\np['status'] = 'processing'", fillcolor=palegreen];
    store_results [label="store_results", fillcolor=lightsalmon];
    transform_data [label="transform_data", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_resilient_pipeline -> fetch_data;
    fetch_data -> transform_data;
    transform_data -> store_results;
    store_results -> __end__;
    subgraph cluster_asyncio_timeout_30_ {
        label="asyncio.timeout(30)";
        style=dashed;
        fetch_data;
        transform_data;
    }
}