digraph "nested_loop_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_nested_loop_flow; }

    finalize_loop_i [label="finalize_loop_i", fillcolor=lightsalmon];
    finalize_loop_j [label="finalize_loop_j", fillcolor=lightsalmon];
    initialize [label="initialize", fillcolor=lightblue];
    process_item [label="process_item", fillcolor=lightblue];
    router_nested_loop_flow_seq_set_i [label="router_nested_loop_flow_seq_set_i\n\np['i'] += 1\np['j'] = 0", fillcolor=wheat];
    router_nested_loop_flow_seq_set_i_2 [label="router_nested_loop_flow_seq_set_i_2\n\np['i'] = 0", fillcolor=wheat];
    router_nested_loop_flow_seq_set_j [label="router_nested_loop_flow_seq_set_j\n\np['j'] += 1", fillcolor=wheat];
    router_nested_loop_flow_while_i_lt_max_i [label="router_nested_loop_flow_while_i_lt_max_i", fillcolor=wheat];
    router_nested_loop_flow_while_j_lt_max_j [label="router_nested_loop_flow_while_j_lt_max_j", fillcolor=wheat];
    start_nested_loop_flow [label="start_nested_loop_flow", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_nested_loop_flow -> initialize;
    initialize -> router_nested_loop_flow_seq_set_i_2;
    router_nested_loop_flow_seq_set_j -> process_item;
    router_nested_loop_flow_while_j_lt_max_j -> router_nested_loop_flow_seq_set_j [label="p['j'] < p['max_j']", color="#2E8B57", fontcolor="#2E8B57"];
    router_nested_loop_flow_while_j_lt_max_j -> finalize_loop_j [label="else", color="#D35400", fontcolor="#D35400"];
    router_nested_loop_flow_seq_set_i -> router_nested_loop_flow_while_j_lt_max_j;
    router_nested_loop_flow_while_i_lt_max_i -> router_nested_loop_flow_seq_set_i [label="p['i'] < p['max_i']", color="#2E8B57", fontcolor="#2E8B57"];
    router_nested_loop_flow_while_i_lt_max_i -> finalize_loop_i [label="else", color="#D35400", fontcolor="#D35400"];
    router_nested_loop_flow_seq_set_i_2 -> router_nested_loop_flow_while_i_lt_max_i;
    process_item -> router_nested_loop_flow_while_j_lt_max_j;
    router_nested_loop_flow_seq_set_j -> router_nested_loop_flow_while_i_lt_max_i;
    finalize_loop_i -> __end__;
    finalize_loop_j -> __end__;
}