digraph "complex_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_complex_flow; }

    router_complex_flow_line_15_if_14 [label="router_complex_flow_line_15_if_14\n\np['stage'] = 'preprocessed'\np['valid'] = p.get('data') is not None", fillcolor=wheat];
    router_complex_flow_line_19_if_12 [label="router_complex_flow_line_19_if_12", fillcolor=wheat];
    router_complex_flow_line_22_while_2 [label="router_complex_flow_line_22_while_2", fillcolor=wheat];
    router_complex_flow_line_26_if_4 [label="router_complex_flow_line_26_if_4\n\np['batch_count'] += 1\np['quality_checked'] = True\np['quality_score'] = p.get('batch_count', 0) * 10", fillcolor=wheat];
    router_complex_flow_line_29_if_3 [label="router_complex_flow_line_29_if_3", fillcolor=wheat];
    router_complex_flow_line_32_if_11 [label="router_complex_flow_line_32_if_11", fillcolor=wheat];
    router_complex_flow_line_53_seq_7 [label="router_complex_flow_line_53_seq_7\n\np['enriched'] = True", fillcolor=wheat];
    router_complex_flow_line_59_if_6 [label="router_complex_flow_line_59_if_6", fillcolor=wheat];
    router_complex_flow_line_60_seq_5 [label="router_complex_flow_line_60_seq_5\n\np['batch_count'] = 0", fillcolor=wheat];
    router_complex_flow_line_75_if_10 [label="router_complex_flow_line_75_if_10\n\np['retried'] = True", fillcolor=wheat];
    router_complex_flow_line_76_seq_9 [label="router_complex_flow_line_76_seq_9\n\np['retry_count'] = 0", fillcolor=wheat];
    router_complex_flow_line_77_seq_8 [label="router_complex_flow_line_77_seq_8\n\np['retry_count'] += 1", fillcolor=wheat];
    router_complex_flow_line_83_seq_13 [label="router_complex_flow_line_83_seq_13\n\np['error_handled'] = True", fillcolor=wheat];
    router_complex_flow_line_89_seq_1 [label="router_complex_flow_line_89_seq_1\n\np['finalized'] = True", fillcolor=wheat];
    start_complex_flow [label="start_complex_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_complex_flow -> router_complex_flow_line_15_if_14;
    router_complex_flow_line_29_if_3 -> router_complex_flow_line_89_seq_1 [label="p['quality_score'] >= 50", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_26_if_4 -> router_complex_flow_line_22_while_2 [label="p['quality_score'] < 20", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_26_if_4 -> router_complex_flow_line_29_if_3 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_59_if_6 -> router_complex_flow_line_60_seq_5 [label="'batch_count' not in p", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_60_seq_5 -> router_complex_flow_line_26_if_4;
    router_complex_flow_line_59_if_6 -> router_complex_flow_line_26_if_4 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_22_while_2 -> router_complex_flow_line_59_if_6 [label="p.get('batch_count', 0) < p.get('max_batches', 3)", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_22_while_2 -> router_complex_flow_line_89_seq_1 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_53_seq_7 -> router_complex_flow_line_22_while_2;
    router_complex_flow_line_75_if_10 -> router_complex_flow_line_76_seq_9 [label="'retry_count' not in p", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_76_seq_9 -> router_complex_flow_line_77_seq_8;
    router_complex_flow_line_75_if_10 -> router_complex_flow_line_77_seq_8 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_32_if_11 -> router_complex_flow_line_75_if_10 [label="p.get('requires_retry')", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_19_if_12 -> router_complex_flow_line_53_seq_7 [label="p.get('needs_enrichment')", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_19_if_12 -> router_complex_flow_line_32_if_11 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_15_if_14 -> router_complex_flow_line_19_if_12 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_15_if_14 -> router_complex_flow_line_83_seq_13 [label="not p['valid']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_29_if_3 -> router_complex_flow_line_22_while_2 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_77_seq_8 -> router_complex_flow_line_89_seq_1;
    router_complex_flow_line_59_if_6 -> router_complex_flow_line_89_seq_1;
    router_complex_flow_line_32_if_11 -> router_complex_flow_line_75_if_10 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_83_seq_13 -> __end__;
    router_complex_flow_line_89_seq_1 -> __end__;
}