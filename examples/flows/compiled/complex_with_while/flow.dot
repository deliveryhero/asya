digraph "complex_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_complex_flow; }

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];
    handler_check_quality [label="handler_check_quality", fillcolor=lightblue];
    handler_enrich_data [label="handler_enrich_data", fillcolor=lightblue];
    handler_error [label="handler_error", fillcolor=lightsalmon];
    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_preprocess [label="handler_preprocess", fillcolor=lightblue];
    handler_retry_handler [label="handler_retry_handler", fillcolor=lightblue];
    handler_transform_batch [label="handler_transform_batch", fillcolor=lightblue];
    handler_validate [label="handler_validate", fillcolor=lightblue];
    router_complex_flow_if_needs_enrichment [label="router_complex_flow_if_needs_enrichment", fillcolor=wheat];
    router_complex_flow_if_not_valid [label="router_complex_flow_if_not_valid", fillcolor=wheat];
    router_complex_flow_if_quality_score_ge_50 [label="router_complex_flow_if_quality_score_ge_50", fillcolor=wheat];
    router_complex_flow_if_quality_score_lt_20 [label="router_complex_flow_if_quality_score_lt_20", fillcolor=wheat];
    router_complex_flow_if_requires_retry [label="router_complex_flow_if_requires_retry", fillcolor=wheat];
    router_complex_flow_while_batch_count_lt_max_batches [label="router_complex_flow_while_batch_count_lt_max_batches", fillcolor=wheat];
    start_complex_flow [label="start_complex_flow", fillcolor=palegreen];

    start_complex_flow -> handler_preprocess;
    handler_preprocess -> handler_validate;
    handler_validate -> router_complex_flow_if_not_valid;
    router_complex_flow_if_quality_score_ge_50 -> handler_finalize [label="p['quality_score'] >= 50", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_if_quality_score_lt_20 -> router_complex_flow_while_batch_count_lt_max_batches [label="p['quality_score'] < 20", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_if_quality_score_lt_20 -> router_complex_flow_if_quality_score_ge_50 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_while_batch_count_lt_max_batches -> handler_transform_batch [label="p.get('batch_count', 0) < p.get('max_batches', 3)", color="#2E8B57", fontcolor="#2E8B57"];
    handler_transform_batch -> handler_check_quality;
    handler_check_quality -> router_complex_flow_if_quality_score_lt_20;
    router_complex_flow_while_batch_count_lt_max_batches -> handler_finalize [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_if_requires_retry -> handler_retry_handler [label="p.get('requires_retry')", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_if_needs_enrichment -> handler_enrich_data [label="p.get('needs_enrichment')", color="#2E8B57", fontcolor="#2E8B57"];
    handler_enrich_data -> router_complex_flow_while_batch_count_lt_max_batches;
    router_complex_flow_if_needs_enrichment -> router_complex_flow_if_requires_retry [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_if_not_valid -> router_complex_flow_if_needs_enrichment [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_if_not_valid -> handler_error [label="not p['valid']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_if_quality_score_ge_50 -> router_complex_flow_while_batch_count_lt_max_batches [label="else", color="#D35400", fontcolor="#D35400"];
    handler_retry_handler -> handler_finalize;
    router_complex_flow_if_requires_retry -> __end__ [label="else", color="#D35400", fontcolor="#D35400"];
    handler_error -> __end__;
    handler_finalize -> __end__;
}