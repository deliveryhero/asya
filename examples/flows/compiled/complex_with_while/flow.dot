digraph "complex_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_complex_flow; }

    handler_check_quality [label="handler_check_quality", fillcolor=lightblue];
    handler_enrich_data [label="handler_enrich_data", fillcolor=lightblue];
    handler_error [label="handler_error", fillcolor=lightsalmon];
    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_preprocess [label="handler_preprocess", fillcolor=lightblue];
    handler_retry_handler [label="handler_retry_handler", fillcolor=lightblue];
    handler_transform_batch [label="handler_transform_batch", fillcolor=lightblue];
    handler_validate [label="handler_validate", fillcolor=lightblue];
    router_complex_flow_line_15_if_6 [label="router_complex_flow_line_15_if_6", fillcolor=wheat];
    router_complex_flow_line_19_if_5 [label="router_complex_flow_line_19_if_5", fillcolor=wheat];
    router_complex_flow_line_22_while_1 [label="router_complex_flow_line_22_while_1", fillcolor=wheat];
    router_complex_flow_line_26_if_3 [label="router_complex_flow_line_26_if_3", fillcolor=wheat];
    router_complex_flow_line_29_if_2 [label="router_complex_flow_line_29_if_2", fillcolor=wheat];
    router_complex_flow_line_32_if_4 [label="router_complex_flow_line_32_if_4", fillcolor=wheat];
    start_complex_flow [label="start_complex_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_complex_flow -> handler_preprocess;
    handler_preprocess -> handler_validate;
    handler_validate -> router_complex_flow_line_15_if_6;
    router_complex_flow_line_29_if_2 -> handler_finalize [label="p['quality_score'] >= 50", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_26_if_3 -> router_complex_flow_line_22_while_1 [label="p['quality_score'] < 20", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_26_if_3 -> router_complex_flow_line_29_if_2 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_22_while_1 -> handler_transform_batch [label="p.get('batch_count', 0) < p.get('max_batches', 3)", color="#2E8B57", fontcolor="#2E8B57"];
    handler_transform_batch -> handler_check_quality;
    handler_check_quality -> router_complex_flow_line_26_if_3;
    router_complex_flow_line_22_while_1 -> handler_finalize [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_32_if_4 -> handler_retry_handler [label="p.get('requires_retry')", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_19_if_5 -> handler_enrich_data [label="p.get('needs_enrichment')", color="#2E8B57", fontcolor="#2E8B57"];
    handler_enrich_data -> router_complex_flow_line_22_while_1;
    router_complex_flow_line_19_if_5 -> router_complex_flow_line_32_if_4 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_15_if_6 -> router_complex_flow_line_19_if_5 [label="else", color="#D35400", fontcolor="#D35400"];
    router_complex_flow_line_15_if_6 -> handler_error [label="not p['valid']", color="#2E8B57", fontcolor="#2E8B57"];
    router_complex_flow_line_29_if_2 -> router_complex_flow_line_22_while_1 [label="else", color="#D35400", fontcolor="#D35400"];
    handler_retry_handler -> handler_finalize;
    router_complex_flow_line_32_if_4 -> handler_finalize [label="else", color="#D35400", fontcolor="#D35400"];
    handler_error -> __end__;
    handler_finalize -> __end__;
}