digraph "react_agent" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_react_agent; }

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];
    execute_tool [label="execute_tool", fillcolor=lightblue];
    llm_call [label="llm_call", fillcolor=lightblue];
    router_react_agent_if_tool_calls [label="router_react_agent_if_tool_calls", fillcolor=wheat];
    router_react_agent_while_loop [label="router_react_agent_while_loop", fillcolor=wheat];
    start_react_agent [label="start_react_agent", fillcolor=palegreen];

    start_react_agent -> router_react_agent_while_loop;
    router_react_agent_if_tool_calls -> execute_tool [label="p.get('tool_calls')", color="#2E8B57", fontcolor="#2E8B57"];
    router_react_agent_if_tool_calls -> __end__ [label="else", color="#D35400", fontcolor="#D35400"];
    router_react_agent_while_loop -> llm_call;
    llm_call -> router_react_agent_if_tool_calls;
    execute_tool -> router_react_agent_while_loop;
}