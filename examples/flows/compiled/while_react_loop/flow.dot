digraph "react_agent" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_react_agent; }

    router_react_agent_line_13_while_1 [label="router_react_agent_line_13_while_1", fillcolor=wheat];
    router_react_agent_line_15_if_2 [label="router_react_agent_line_15_if_2", fillcolor=wheat];
    start_react_agent [label="start_react_agent", fillcolor=palegreen];

    start_react_agent -> router_react_agent_line_13_while_1;
    router_react_agent_line_13_while_1 -> router_react_agent_line_15_if_2;
    router_react_agent_line_15_if_2 -> router_react_agent_line_13_while_1;
}