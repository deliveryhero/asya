digraph "react_agent" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_react_agent [label="end_react_agent", fillcolor=palegreen];
    execute_tool [label="execute_tool", fillcolor=lightblue];
    llm_call [label="llm_call", fillcolor=lightblue];
    router_react_agent_line_14_while_1 [label="router_react_agent_line_14_while_1", fillcolor=wheat];
    router_react_agent_line_16_if_2 [label="router_react_agent_line_16_if_2", fillcolor=wheat];
    start_react_agent [label="start_react_agent", fillcolor=palegreen];

    start_react_agent -> router_react_agent_line_14_while_1;
    router_react_agent_line_16_if_2 -> execute_tool [label="p.get('tool_calls')"];
    router_react_agent_line_16_if_2 -> end_react_agent [label="not (p.get('tool_calls'))", style=dashed];
    router_react_agent_line_14_while_1 -> llm_call;
    llm_call -> router_react_agent_line_16_if_2;
    execute_tool -> router_react_agent_line_14_while_1;
}