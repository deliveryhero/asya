digraph "decorator_callsite_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_decorator_callsite_flow; }

    enricher [label="enricher", fillcolor=lightsalmon];
    start_decorator_callsite_flow [label="start_decorator_callsite_flow", fillcolor=palegreen];
    validator [label="validator", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_decorator_callsite_flow -> validator;
    validator -> enricher;
    enricher -> __end__;
}