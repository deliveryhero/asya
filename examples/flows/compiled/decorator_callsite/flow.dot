digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_decorator_callsite_flow [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = start_decorator_callsite_flow(p)</i></td></tr><tr><td bgcolor="white" align="left">p = stamp_timestamp(p)</td></tr></table>>];
  end_decorator_callsite_flow [fillcolor="lightgreen", group="main", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = end_decorator_callsite_flow(p)</i></td></tr></table>>];
  enricher [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = enricher(p)</i></td></tr></table>>];
  validator [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = validator(p)</i></td></tr></table>>];

  enricher -> end_decorator_callsite_flow;
  start_decorator_callsite_flow -> validator;
  validator -> enricher;
}