digraph "llm_auditor_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    critic [label="critic", fillcolor=lightblue];
    reviser [label="reviser", fillcolor=palegreen];
    start_llm_auditor_flow [label="start_llm_auditor_flow", fillcolor=palegreen];

    start_llm_auditor_flow -> critic;
    critic -> reviser;
}