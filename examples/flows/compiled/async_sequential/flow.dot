digraph "llm_auditor_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_llm_auditor_flow; }

    critic [label="critic", fillcolor=lightblue];
    reviser [label="reviser", fillcolor=lightsalmon];
    start_llm_auditor_flow [label="start_llm_auditor_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_llm_auditor_flow -> critic;
    critic -> reviser;
    reviser -> __end__;
}