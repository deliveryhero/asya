digraph "with_inline_ctx" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_order_processing; }

    fulfillment_handler [label="fulfillment_handler", fillcolor=lightblue];
    payment_processor [label="payment_processor", fillcolor=lightblue];
    router_order_processing_line_27_with [label="router_order_processing_line_27_with", fillcolor=wheat];
    router_order_processing_line_30_if [label="router_order_processing_line_30_if", fillcolor=wheat];
    router_order_processing_line_33_seq [label="router_order_processing_line_33_seq\n\np['status'] = 'rejected'", fillcolor=wheat];
    router_order_processing_line_36_seq [label="router_order_processing_line_36_seq\n\np['stage'] = 'fulfillment'", fillcolor=wheat];
    start_order_processing [label="start_order_processing\n\np['stage'] = 'validation'", fillcolor=palegreen];
    validate_order [label="validate_order", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_order_processing -> router_order_processing_line_27_with;
    router_order_processing_line_36_seq -> fulfillment_handler;
    router_order_processing_line_30_if -> payment_processor [label="p.get('valid')"];
    payment_processor -> router_order_processing_line_36_seq;
    router_order_processing_line_30_if -> router_order_processing_line_33_seq [label="not (p.get('valid'))"];
    router_order_processing_line_27_with -> validate_order;
    validate_order -> router_order_processing_line_30_if;
    fulfillment_handler -> __end__;
    router_order_processing_line_33_seq -> __end__;
}