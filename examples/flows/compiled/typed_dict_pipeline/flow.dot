digraph "typeddict_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_typeddict_pipeline [label="end_typeddict_pipeline", fillcolor=palegreen];
    error_handler [label="error_handler", fillcolor=lightblue];
    router_typeddict_pipeline_line_77_if_1 [label="router_typeddict_pipeline_line_77_if_1", fillcolor=wheat];

    router_typeddict_pipeline_line_77_if_1 -> error_handler [label="not p.get('valid', True)"];
}