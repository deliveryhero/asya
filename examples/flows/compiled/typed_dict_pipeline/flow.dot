digraph "typed_dict_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_typeddict_pipeline; }

    error_handler [label="error_handler", fillcolor=lightblue];
    parser [label="parser", fillcolor=lightblue];
    router_typeddict_pipeline_line_77_if_1 [label="router_typeddict_pipeline_line_77_if_1", fillcolor=wheat];
    sink_adapter [label="sink_adapter", fillcolor=lightblue];
    start_typeddict_pipeline [label="start_typeddict_pipeline", fillcolor=palegreen];
    transformer [label="transformer", fillcolor=lightblue];
    validator [label="validator", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_typeddict_pipeline -> parser;
    parser -> validator;
    validator -> router_typeddict_pipeline_line_77_if_1;
    router_typeddict_pipeline_line_77_if_1 -> transformer [label="not (not p.get('valid', True))"];
    transformer -> sink_adapter;
    router_typeddict_pipeline_line_77_if_1 -> error_handler [label="not p.get('valid', True)"];
    error_handler -> __end__;
    sink_adapter -> __end__;
}