digraph "typeddict_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_typeddict_pipeline; }

    error_handler [label="error_handler", fillcolor=lightsalmon];
    parser [label="parser", fillcolor=lightblue];
    router_typeddict_pipeline_if_not_valid [label="router_typeddict_pipeline_if_not_valid", fillcolor=wheat];
    sink_adapter [label="sink_adapter", fillcolor=lightsalmon];
    start_typeddict_pipeline [label="start_typeddict_pipeline", fillcolor=palegreen];
    transformer [label="transformer", fillcolor=lightblue];
    validator [label="validator", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_typeddict_pipeline -> parser;
    parser -> validator;
    validator -> router_typeddict_pipeline_if_not_valid;
    router_typeddict_pipeline_if_not_valid -> transformer [label="else", color="#D35400", fontcolor="#D35400"];
    transformer -> sink_adapter;
    router_typeddict_pipeline_if_not_valid -> error_handler [label="not p.get('valid', True)", color="#2E8B57", fontcolor="#2E8B57"];
    error_handler -> __end__;
    sink_adapter -> __end__;
}