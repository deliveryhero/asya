digraph "api_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_api_pipeline; }

    fetch_from_api [label="fetch_from_api", fillcolor=lightblue];
    process_response [label="process_response", fillcolor=lightblue];
    start_api_pipeline [label="start_api_pipeline\n\np['status'] = 'started'", fillcolor=palegreen];
    store_results [label="store_results", fillcolor=lightsalmon];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_api_pipeline -> fetch_from_api;
    fetch_from_api -> process_response;
    process_response -> store_results;
    store_results -> __end__;
    subgraph cluster_asyncio_timeout_120_ {
        label="asyncio.timeout(120)";
        style=dashed;
        fetch_from_api;
        process_response;
    }
}