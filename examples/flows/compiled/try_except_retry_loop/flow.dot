digraph "retry_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_retry_pipeline; }

    call_another_api [label="call_another_api", fillcolor=lightblue];
    call_external_api [label="call_external_api", fillcolor=lightblue];
    log_retry [label="log_retry", fillcolor=lightsalmon];
    prepare_request [label="prepare_request", fillcolor=lightblue];
    router_retry_pipeline_line_16_while_1 [label="router_retry_pipeline_line_16_while_1", fillcolor=wheat];
    router_retry_pipeline_line_17_seq_4 [label="router_retry_pipeline_line_17_seq_4\n\np['attempt'] += 1", fillcolor=wheat];
    router_retry_pipeline_line_21_except_2 [label="router_retry_pipeline_line_21_except_2", fillcolor=wheat];
    router_retry_pipeline_line_23_except_3 [label="router_retry_pipeline_line_23_except_3", fillcolor=wheat];
    start_retry_pipeline [label="start_retry_pipeline\n\np['attempt'] = 0", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_retry_pipeline -> prepare_request;
    prepare_request -> router_retry_pipeline_line_16_while_1;
    router_retry_pipeline_line_21_except_2 -> log_retry;
    router_retry_pipeline_line_17_seq_4 -> call_external_api;
    call_external_api -> call_another_api;
    router_retry_pipeline_line_16_while_1 -> router_retry_pipeline_line_17_seq_4 [label="p['attempt'] < 3", color="#2E8B57", fontcolor="#2E8B57"];
    call_external_api -> router_retry_pipeline_line_21_except_2 [label="ConnectionError", color="#DC143C", fontcolor="#DC143C"];
    call_external_api -> router_retry_pipeline_line_23_except_3 [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    call_another_api -> router_retry_pipeline_line_21_except_2 [label="ConnectionError", color="#DC143C", fontcolor="#DC143C"];
    call_another_api -> router_retry_pipeline_line_23_except_3 [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    call_another_api -> router_retry_pipeline_line_16_while_1;
    log_retry -> __end__;
    router_retry_pipeline_line_23_except_3 -> __end__;
}