digraph "retry_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_retry_pipeline; }

    router_retry_pipeline_line_15_while_1 [label="router_retry_pipeline_line_15_while_1", fillcolor=wheat];
    router_retry_pipeline_line_16_seq_4 [label="router_retry_pipeline_line_16_seq_4\n\np['attempt'] += 1", fillcolor=wheat];
    start_retry_pipeline [label="start_retry_pipeline\n\np['attempt'] = 0", fillcolor=palegreen];

    start_retry_pipeline -> router_retry_pipeline_line_15_while_1;
    router_retry_pipeline_line_15_while_1 -> router_retry_pipeline_line_16_seq_4 [label="p['attempt'] < 3", color="#2E8B57", fontcolor="#2E8B57"];
    router_retry_pipeline_line_16_seq_4 -> router_retry_pipeline_line_15_while_1;
}