    call_external_api -->|"ConnectionError"| router_retry_pipeline_except_connectionerror
    call_external_api -->|"ValueError"| router_retry_pipeline_except_valueerror
    call_another_api -->|"ConnectionError"| router_retry_pipeline_except_connectionerror
    call_another_api -->|"ValueError"| router_retry_pipeline_except_valueerror
    call_another_api --> router_retry_pipeline_while_attempt_lt_3
    log_retry --> __end__
    router_retry_pipeline_except_valueerror --> __end__

