digraph "loop_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_loop_flow [label="end_loop_flow", fillcolor=palegreen];
    finalize_loop [label="finalize_loop", fillcolor=lightblue];
    router_loop_flow_line_16_while_1 [label="router_loop_flow_line_16_while_1", fillcolor=wheat];
    router_loop_flow_line_27_if_2 [label="router_loop_flow_line_27_if_2", fillcolor=wheat];

    router_loop_flow_line_27_if_2 -> finalize_loop [label="p['threshold_met']"];
    router_loop_flow_line_16_while_1 -> finalize_loop [label="p['iteration'] < p['max_iterations']"];
}