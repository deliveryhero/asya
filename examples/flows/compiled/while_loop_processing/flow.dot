digraph "loop_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_loop_flow; }

    check_threshold [label="check_threshold", fillcolor=lightblue];
    finalize_loop [label="finalize_loop", fillcolor=lightsalmon];
    initialize [label="initialize", fillcolor=lightblue];
    process_abort [label="process_abort", fillcolor=lightblue];
    process_item [label="process_item", fillcolor=lightblue];
    router_loop_flow_if_skip_threshold_check [label="router_loop_flow_if_skip_threshold_check", fillcolor=wheat];
    router_loop_flow_if_threshold_met [label="router_loop_flow_if_threshold_met", fillcolor=wheat];
    router_loop_flow_seq_set_abort [label="router_loop_flow_seq_set_abort\n\np['abort'] = 2", fillcolor=wheat];
    router_loop_flow_seq_set_abort_2 [label="router_loop_flow_seq_set_abort_2\n\np['abort'] = 1", fillcolor=wheat];
    router_loop_flow_seq_set_iteration [label="router_loop_flow_seq_set_iteration\n\np['iteration'] += 1", fillcolor=wheat];
    router_loop_flow_seq_set_iteration_2 [label="router_loop_flow_seq_set_iteration_2\n\np['iteration'] = 0", fillcolor=wheat];
    router_loop_flow_while_iteration_lt_max_iterations [label="router_loop_flow_while_iteration_lt_max_iterations", fillcolor=wheat];
    start_loop_flow [label="start_loop_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_loop_flow -> initialize;
    initialize -> router_loop_flow_seq_set_iteration_2;
    router_loop_flow_if_threshold_met -> finalize_loop [label="p['threshold_met']", color="#2E8B57", fontcolor="#2E8B57"];
    router_loop_flow_seq_set_abort -> router_loop_flow_while_iteration_lt_max_iterations;
    router_loop_flow_seq_set_abort_2 -> process_abort;
    process_abort -> router_loop_flow_seq_set_abort;
    router_loop_flow_if_skip_threshold_check -> router_loop_flow_seq_set_abort_2 [label="p.get('skip_threshold_check')", color="#2E8B57", fontcolor="#2E8B57"];
    router_loop_flow_if_skip_threshold_check -> check_threshold [label="else", color="#D35400", fontcolor="#D35400"];
    check_threshold -> router_loop_flow_if_threshold_met;
    router_loop_flow_seq_set_iteration -> process_item;
    process_item -> router_loop_flow_if_skip_threshold_check;
    router_loop_flow_while_iteration_lt_max_iterations -> router_loop_flow_seq_set_iteration [label="p['iteration'] < p['max_iterations']", color="#2E8B57", fontcolor="#2E8B57"];
    router_loop_flow_while_iteration_lt_max_iterations -> finalize_loop [label="else", color="#D35400", fontcolor="#D35400"];
    router_loop_flow_seq_set_iteration_2 -> router_loop_flow_while_iteration_lt_max_iterations;
    router_loop_flow_if_threshold_met -> router_loop_flow_while_iteration_lt_max_iterations [label="else", color="#D35400", fontcolor="#D35400"];
    finalize_loop -> __end__;
}