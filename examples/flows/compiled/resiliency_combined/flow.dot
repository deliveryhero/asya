digraph "resiliency_combined" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_resiliency_combined; }

    fetch_data [label="fetch_data", fillcolor=lightblue];
    handle_bad_data [label="handle_bad_data", fillcolor=lightblue];
    parse_data [label="parse_data", fillcolor=lightblue];
    router_resiliency_combined_except_valueerror [label="router_resiliency_combined_except_valueerror\n\np['error'] = 'bad_data'", fillcolor=wheat];
    start_resiliency_combined [label="start_resiliency_combined\n\np['status'] = 'started'", fillcolor=palegreen];
    store_results [label="store_results", fillcolor=lightsalmon];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_resiliency_combined -> fetch_data;
    fetch_data -> parse_data;
    parse_data -> store_results;
    router_resiliency_combined_except_valueerror -> handle_bad_data;
    handle_bad_data -> store_results;
    fetch_data -> router_resiliency_combined_except_valueerror [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    parse_data -> router_resiliency_combined_except_valueerror [label="ValueError", color="#DC143C", fontcolor="#DC143C"];
    store_results -> __end__;
    subgraph cluster_asyncio_timeout_60_ {
        label="asyncio.timeout(60)";
        style=dashed;
        fetch_data;
        parse_data;
        handle_bad_data;
    }
}