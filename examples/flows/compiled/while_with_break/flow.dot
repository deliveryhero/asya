digraph "while_with_break_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_while_with_break_flow [label="end_while_with_break_flow", fillcolor=palegreen];
    handler_finalize [label="handler_finalize", fillcolor=lightblue];
    router_while_with_break_flow_line_14_while_1 [label="router_while_with_break_flow_line_14_while_1", fillcolor=wheat];
    router_while_with_break_flow_line_17_if_2 [label="router_while_with_break_flow_line_17_if_2", fillcolor=wheat];

    router_while_with_break_flow_line_17_if_2 -> handler_finalize [label="p['stop_condition']"];
    router_while_with_break_flow_line_14_while_1 -> handler_finalize [label="p['i'] < p['max_iterations']"];
}