digraph "resource_pipeline" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_resource_pipeline; }

    acquire_resource [label="acquire_resource", fillcolor=lightblue];
    finalize [label="finalize", fillcolor=lightsalmon];
    handle_failure [label="handle_failure", fillcolor=lightblue];
    process_with_resource [label="process_with_resource", fillcolor=lightblue];
    release_resource [label="release_resource", fillcolor=lightblue];
    router_resource_pipeline_except_runtimeerror [label="router_resource_pipeline_except_runtimeerror\n\np['status'] = 'failed'", fillcolor=wheat];
    start_resource_pipeline [label="start_resource_pipeline\n\np['status'] = 'started'", fillcolor=palegreen];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_resource_pipeline -> acquire_resource;
    acquire_resource -> process_with_resource;
    process_with_resource -> release_resource;
    release_resource -> finalize;
    router_resource_pipeline_except_runtimeerror -> handle_failure;
    handle_failure -> release_resource;
    acquire_resource -> router_resource_pipeline_except_runtimeerror [label="RuntimeError", color="#DC143C", fontcolor="#DC143C"];
    process_with_resource -> router_resource_pipeline_except_runtimeerror [label="RuntimeError", color="#DC143C", fontcolor="#DC143C"];
    finalize -> __end__;
}