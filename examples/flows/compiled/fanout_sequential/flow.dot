digraph "multi_stage_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_multi_stage_flow; }

    fanin_multi_stage_flow_research [label="fanin_multi_stage_flow_research", fillcolor=lightblue];
    fanin_multi_stage_flow_reviews [label="fanin_multi_stage_flow_reviews", fillcolor=lightblue];
    research_agent [label="research_agent", fillcolor=lightblue];
    review_agent [label="review_agent", fillcolor=lightblue];
    router_multi_stage_flow_fanout_research [label="router_multi_stage_flow_fanout_research", fillcolor=wheat];
    router_multi_stage_flow_fanout_reviews [label="router_multi_stage_flow_fanout_reviews", fillcolor=wheat];
    start_multi_stage_flow [label="start_multi_stage_flow", fillcolor=palegreen];
    summarizer [label="summarizer", fillcolor=lightsalmon];
    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_multi_stage_flow -> router_multi_stage_flow_fanout_research;
    router_multi_stage_flow_fanout_reviews -> fanin_multi_stage_flow_reviews [label="fanout: p['research']", color="#6C35EA", fontcolor="#6C35EA"];
    fanin_multi_stage_flow_reviews -> summarizer;
    router_multi_stage_flow_fanout_reviews -> review_agent;
    review_agent -> fanin_multi_stage_flow_reviews;
    router_multi_stage_flow_fanout_research -> fanin_multi_stage_flow_research [label="fanout: p['topics']", color="#6C35EA", fontcolor="#6C35EA"];
    fanin_multi_stage_flow_research -> router_multi_stage_flow_fanout_reviews;
    router_multi_stage_flow_fanout_research -> research_agent;
    research_agent -> fanin_multi_stage_flow_research;
    summarizer -> __end__;
}