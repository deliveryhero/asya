digraph "multi_stage_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_multi_stage_flow [label="end_multi_stage_flow", fillcolor=palegreen];
    router_multi_stage_flow_line_15_fanout_2 [label="router_multi_stage_flow_line_15_fanout_2", fillcolor=wheat];
    start_multi_stage_flow [label="start_multi_stage_flow", fillcolor=palegreen];

    start_multi_stage_flow -> router_multi_stage_flow_line_15_fanout_2;
    router_multi_stage_flow_line_15_fanout_2 -> end_multi_stage_flow;
}