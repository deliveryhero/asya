digraph flow {
  rankdir=TB;
  graph [fontname="Courier", fontsize=10];
  node [fontname="Courier", fontsize=10, shape=box, style="filled,rounded", margin="0.2"];
  edge [fontname="Courier", fontsize=10];

  start_multi_stage_flow [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = start_multi_stage_flow(p)</i></td></tr></table>>];
  fanout_multi_stage_flow_L12 [fillcolor="plum1", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = fanout_multi_stage_flow_L12(p)</i></td></tr><tr><td bgcolor="plum2" align="center"><b>[fan-out:comprehension]</b></td></tr><tr><td bgcolor="plum3" align="left">for r in p['research']</td></tr></table>>, shape=diamond];
  fanout_multi_stage_flow_L11 [fillcolor="plum1", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = fanout_multi_stage_flow_L11(p)</i></td></tr><tr><td bgcolor="plum2" align="center"><b>[fan-out:comprehension]</b></td></tr><tr><td bgcolor="plum3" align="left">for t in p['topics']</td></tr></table>>, shape=diamond];
  end_multi_stage_flow [fillcolor="lightgreen", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = end_multi_stage_flow(p)</i></td></tr></table>>];
  research_agent [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = research_agent(p)</i></td></tr></table>>];
  review_agent [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = review_agent(p)</i></td></tr></table>>];
  summarizer [fillcolor="lightblue", label=<<table border="0" cellspacing="0" cellpadding="6" cellborder="1"><tr><td bgcolor="white" align="center"><i>p = summarizer(p)</i></td></tr></table>>];

  fanout_multi_stage_flow_L11 -> fanout_multi_stage_flow_L12 [color=mediumpurple4, label="slice 0\n(parent)", style=dashed];
  fanout_multi_stage_flow_L11 -> research_agent [color=mediumpurple4, label="slice 1..N\n(per t)", style=bold];
  fanout_multi_stage_flow_L12 -> review_agent [color=mediumpurple4, label="slice 1..N\n(per r)", style=bold];
  fanout_multi_stage_flow_L12 -> summarizer [color=mediumpurple4, label="slice 0\n(parent)", style=dashed];
  research_agent -> fanout_multi_stage_flow_L12 [color=slateblue4, style=dashed];
  review_agent -> summarizer [color=slateblue4, style=dashed];
  start_multi_stage_flow -> fanout_multi_stage_flow_L11;
  summarizer -> end_multi_stage_flow;
}