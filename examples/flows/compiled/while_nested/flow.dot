digraph "while_nested_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_while_nested_flow [label="end_while_nested_flow", fillcolor=palegreen];
    handler_finalize [label="handler_finalize", fillcolor=lightblue];
    handler_outer_end [label="handler_outer_end", fillcolor=lightblue];
    router_while_nested_flow_line_14_while_1 [label="router_while_nested_flow_line_14_while_1", fillcolor=wheat];
    router_while_nested_flow_line_18_while_2 [label="router_while_nested_flow_line_18_while_2", fillcolor=wheat];

    router_while_nested_flow_line_18_while_2 -> handler_outer_end [label="p['j'] < p['max_j']"];
    router_while_nested_flow_line_14_while_1 -> handler_finalize [label="p['i'] < p['max_i']"];
}