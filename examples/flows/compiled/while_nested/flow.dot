digraph "while_nested_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_while_nested_flow; }

    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_init [label="handler_init", fillcolor=lightblue];
    handler_inner [label="handler_inner", fillcolor=lightblue];
    handler_outer [label="handler_outer", fillcolor=lightblue];
    handler_outer_end [label="handler_outer_end", fillcolor=lightsalmon];
    router_while_nested_flow_seq_set_i [label="router_while_nested_flow_seq_set_i\n\np['i'] += 1", fillcolor=wheat];
    router_while_nested_flow_seq_set_i_2 [label="router_while_nested_flow_seq_set_i_2\n\np['i'] = 0", fillcolor=wheat];
    router_while_nested_flow_seq_set_j [label="router_while_nested_flow_seq_set_j\n\np['j'] += 1", fillcolor=wheat];
    router_while_nested_flow_seq_set_j_2 [label="router_while_nested_flow_seq_set_j_2\n\np['j'] = 0", fillcolor=wheat];
    router_while_nested_flow_while_i_lt_max_i [label="router_while_nested_flow_while_i_lt_max_i", fillcolor=wheat];
    router_while_nested_flow_while_j_lt_max_j [label="router_while_nested_flow_while_j_lt_max_j", fillcolor=wheat];
    start_while_nested_flow [label="start_while_nested_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_while_nested_flow -> handler_init;
    handler_init -> router_while_nested_flow_seq_set_i_2;
    router_while_nested_flow_seq_set_j -> handler_inner;
    router_while_nested_flow_while_j_lt_max_j -> router_while_nested_flow_seq_set_j [label="p['j'] < p['max_j']", color="#2E8B57", fontcolor="#2E8B57"];
    router_while_nested_flow_while_j_lt_max_j -> handler_outer_end [label="else", color="#D35400", fontcolor="#D35400"];
    router_while_nested_flow_seq_set_j_2 -> router_while_nested_flow_while_j_lt_max_j;
    router_while_nested_flow_seq_set_i -> handler_outer;
    handler_outer -> router_while_nested_flow_seq_set_j_2;
    router_while_nested_flow_while_i_lt_max_i -> router_while_nested_flow_seq_set_i [label="p['i'] < p['max_i']", color="#2E8B57", fontcolor="#2E8B57"];
    router_while_nested_flow_while_i_lt_max_i -> handler_finalize [label="else", color="#D35400", fontcolor="#D35400"];
    router_while_nested_flow_seq_set_i_2 -> router_while_nested_flow_while_i_lt_max_i;
    handler_inner -> router_while_nested_flow_while_j_lt_max_j;
    router_while_nested_flow_while_j_lt_max_j -> router_while_nested_flow_while_i_lt_max_i;
    handler_finalize -> __end__;
    handler_outer_end -> __end__;
}