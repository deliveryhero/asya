digraph "mutations_with_handler_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_mutations_with_handler_flow; }

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];
    handler_process [label="handler_process", fillcolor=lightblue];
    router_mutations_with_handler_flow_seq_set_finalized [label="router_mutations_with_handler_flow_seq_set_finalized\n\np['finalized'] = True", fillcolor=wheat];
    start_mutations_with_handler_flow [label="start_mutations_with_handler_flow\n\np['initialized'] = True\np['step'] = 1\np['count'] = 0", fillcolor=palegreen];

    start_mutations_with_handler_flow -> handler_process;
    handler_process -> router_mutations_with_handler_flow_seq_set_finalized;
    router_mutations_with_handler_flow_seq_set_finalized -> __end__;
}