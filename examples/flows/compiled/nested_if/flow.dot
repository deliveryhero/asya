digraph "nested_if_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_nested_if_flow; }

    handler_a_x [label="handler_a_x", fillcolor=lightblue];
    handler_a_y [label="handler_a_y", fillcolor=lightblue];
    handler_b_x [label="handler_b_x", fillcolor=lightblue];
    handler_b_y [label="handler_b_y", fillcolor=lightblue];
    handler_finalize [label="handler_finalize", fillcolor=lightsalmon];
    handler_validate [label="handler_validate", fillcolor=lightblue];
    router_nested_if_flow_if_level1_eq_a [label="router_nested_if_flow_if_level1_eq_a", fillcolor=wheat];
    router_nested_if_flow_if_level2_eq_x [label="router_nested_if_flow_if_level2_eq_x\n\np['l1'] = 'A'", fillcolor=wheat];
    router_nested_if_flow_if_level2_eq_x_2 [label="router_nested_if_flow_if_level2_eq_x_2\n\np['l1'] = 'B'", fillcolor=wheat];
    router_nested_if_flow_seq_set_l2 [label="router_nested_if_flow_seq_set_l2\n\np['l2'] = 'X'", fillcolor=wheat];
    router_nested_if_flow_seq_set_l2_2 [label="router_nested_if_flow_seq_set_l2_2\n\np['l2'] = 'Y'", fillcolor=wheat];
    router_nested_if_flow_seq_set_l2_3 [label="router_nested_if_flow_seq_set_l2_3\n\np['l2'] = 'X'", fillcolor=wheat];
    router_nested_if_flow_seq_set_l2_4 [label="router_nested_if_flow_seq_set_l2_4\n\np['l2'] = 'Y'", fillcolor=wheat];
    start_nested_if_flow [label="start_nested_if_flow", fillcolor=palegreen];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_nested_if_flow -> handler_validate;
    handler_validate -> router_nested_if_flow_if_level1_eq_a;
    router_nested_if_flow_seq_set_l2 -> handler_a_x;
    router_nested_if_flow_seq_set_l2_2 -> handler_a_y;
    router_nested_if_flow_if_level2_eq_x -> router_nested_if_flow_seq_set_l2 [label="p['level2'] == 'X'", color="#2E8B57", fontcolor="#2E8B57"];
    router_nested_if_flow_if_level2_eq_x -> router_nested_if_flow_seq_set_l2_2 [label="else", color="#D35400", fontcolor="#D35400"];
    router_nested_if_flow_seq_set_l2_3 -> handler_b_x;
    router_nested_if_flow_seq_set_l2_4 -> handler_b_y;
    router_nested_if_flow_if_level2_eq_x_2 -> router_nested_if_flow_seq_set_l2_3 [label="p['level2'] == 'X'", color="#2E8B57", fontcolor="#2E8B57"];
    router_nested_if_flow_if_level2_eq_x_2 -> router_nested_if_flow_seq_set_l2_4 [label="else", color="#D35400", fontcolor="#D35400"];
    router_nested_if_flow_if_level1_eq_a -> router_nested_if_flow_if_level2_eq_x [label="p['level1'] == 'A'", color="#2E8B57", fontcolor="#2E8B57"];
    router_nested_if_flow_if_level1_eq_a -> router_nested_if_flow_if_level2_eq_x_2 [label="else", color="#D35400", fontcolor="#D35400"];
    handler_a_x -> handler_finalize;
    handler_a_y -> handler_finalize;
    handler_b_x -> handler_finalize;
    handler_b_y -> handler_finalize;
    handler_finalize -> __end__;
}