digraph "nested_if_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_nested_if_flow [label="end_nested_if_flow", fillcolor=palegreen];
    handler_a_x [label="handler_a_x", fillcolor=lightblue];
    handler_a_y [label="handler_a_y", fillcolor=lightblue];
    handler_b_x [label="handler_b_x", fillcolor=lightblue];
    handler_b_y [label="handler_b_y", fillcolor=lightblue];
    handler_finalize [label="handler_finalize", fillcolor=lightblue];
    handler_validate [label="handler_validate", fillcolor=lightblue];
    router_nested_if_flow_line_14_if_7 [label="router_nested_if_flow_line_14_if_7", fillcolor=wheat];
    router_nested_if_flow_line_16_if_3 [label="router_nested_if_flow_line_16_if_3", fillcolor=wheat];
    router_nested_if_flow_line_17_seq_1 [label="router_nested_if_flow_line_17_seq_1", fillcolor=wheat];
    router_nested_if_flow_line_20_seq_2 [label="router_nested_if_flow_line_20_seq_2", fillcolor=wheat];
    router_nested_if_flow_line_24_if_6 [label="router_nested_if_flow_line_24_if_6", fillcolor=wheat];
    router_nested_if_flow_line_25_seq_4 [label="router_nested_if_flow_line_25_seq_4", fillcolor=wheat];
    router_nested_if_flow_line_28_seq_5 [label="router_nested_if_flow_line_28_seq_5", fillcolor=wheat];
    start_nested_if_flow [label="start_nested_if_flow", fillcolor=palegreen];

    start_nested_if_flow -> handler_validate;
    handler_validate -> router_nested_if_flow_line_14_if_7;
    router_nested_if_flow_line_17_seq_1 -> handler_a_x;
    router_nested_if_flow_line_20_seq_2 -> handler_a_y;
    router_nested_if_flow_line_16_if_3 -> router_nested_if_flow_line_17_seq_1 [label="p['level2'] == 'X'"];
    router_nested_if_flow_line_16_if_3 -> router_nested_if_flow_line_20_seq_2 [label="not (p['level2'] == 'X')"];
    router_nested_if_flow_line_25_seq_4 -> handler_b_x;
    router_nested_if_flow_line_28_seq_5 -> handler_b_y;
    router_nested_if_flow_line_24_if_6 -> router_nested_if_flow_line_25_seq_4 [label="p['level2'] == 'X'"];
    router_nested_if_flow_line_24_if_6 -> router_nested_if_flow_line_28_seq_5 [label="not (p['level2'] == 'X')"];
    router_nested_if_flow_line_14_if_7 -> router_nested_if_flow_line_16_if_3 [label="p['level1'] == 'A'"];
    router_nested_if_flow_line_16_if_3 -> handler_finalize;
    router_nested_if_flow_line_14_if_7 -> router_nested_if_flow_line_24_if_6 [label="not (p['level1'] == 'A')"];
    router_nested_if_flow_line_24_if_6 -> handler_finalize;
    handler_finalize -> end_nested_if_flow;
}