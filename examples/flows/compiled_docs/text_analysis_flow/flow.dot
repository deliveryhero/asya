digraph "text_analysis_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_text_analysis_flow; }

    clean_text [label="clean_text", fillcolor=lightblue];
    english_sentiment [label="english_sentiment", fillcolor=lightblue];
    extract_entities [label="extract_entities", fillcolor=lightblue];
    router_text_analysis_flow_if_language_eq_en [label="router_text_analysis_flow_if_language_eq_en", fillcolor=wheat];
    router_text_analysis_flow_if_language_eq_es [label="router_text_analysis_flow_if_language_eq_es", fillcolor=wheat];
    router_text_analysis_flow_seq_set_extracted [label="router_text_analysis_flow_seq_set_extracted\n\np['extracted'] = True", fillcolor=wheat];
    router_text_analysis_flow_seq_set_sentiment [label="router_text_analysis_flow_seq_set_sentiment\n\np['sentiment'] = 'neutral'", fillcolor=wheat];
    spanish_sentiment [label="spanish_sentiment", fillcolor=lightblue];
    start_text_analysis_flow [label="start_text_analysis_flow", fillcolor=palegreen];
    tokenize [label="tokenize", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_text_analysis_flow -> clean_text;
    clean_text -> tokenize;
    tokenize -> router_text_analysis_flow_if_language_eq_en;
    router_text_analysis_flow_if_language_eq_es -> spanish_sentiment [label="p['language'] == 'es'", color="#2E8B57", fontcolor="#2E8B57"];
    router_text_analysis_flow_if_language_eq_es -> router_text_analysis_flow_seq_set_sentiment [label="else", color="#D35400", fontcolor="#D35400"];
    router_text_analysis_flow_if_language_eq_en -> english_sentiment [label="p['language'] == 'en'", color="#2E8B57", fontcolor="#2E8B57"];
    english_sentiment -> extract_entities;
    extract_entities -> router_text_analysis_flow_seq_set_extracted;
    router_text_analysis_flow_if_language_eq_en -> router_text_analysis_flow_if_language_eq_es [label="else", color="#D35400", fontcolor="#D35400"];
    spanish_sentiment -> extract_entities;
    router_text_analysis_flow_seq_set_sentiment -> extract_entities;
    router_text_analysis_flow_seq_set_extracted -> __end__;
}
