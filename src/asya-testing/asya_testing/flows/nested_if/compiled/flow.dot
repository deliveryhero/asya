digraph "test_nested_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    { rank=source; start_test_nested_flow; }

    finalize_result [label="finalize_result", fillcolor=lightsalmon];
    route_a_x [label="route_a_x", fillcolor=lightblue];
    route_a_y [label="route_a_y", fillcolor=lightblue];
    route_b_x [label="route_b_x", fillcolor=lightblue];
    route_b_y [label="route_b_y", fillcolor=lightblue];
    router_test_nested_flow_line_11_if_3 [label="router_test_nested_flow_line_11_if_3\n\np['path'] = 'A'", fillcolor=wheat];
    router_test_nested_flow_line_12_seq_1 [label="router_test_nested_flow_line_12_seq_1\n\np['route'] = 'A-X'", fillcolor=wheat];
    router_test_nested_flow_line_15_seq_2 [label="router_test_nested_flow_line_15_seq_2\n\np['route'] = 'A-Y'", fillcolor=wheat];
    router_test_nested_flow_line_19_if_6 [label="router_test_nested_flow_line_19_if_6\n\np['path'] = 'B'", fillcolor=wheat];
    router_test_nested_flow_line_20_seq_4 [label="router_test_nested_flow_line_20_seq_4\n\np['route'] = 'B-X'", fillcolor=wheat];
    router_test_nested_flow_line_23_seq_5 [label="router_test_nested_flow_line_23_seq_5\n\np['route'] = 'B-Y'", fillcolor=wheat];
    router_test_nested_flow_line_9_if_7 [label="router_test_nested_flow_line_9_if_7", fillcolor=wheat];
    start_test_nested_flow [label="start_test_nested_flow", fillcolor=palegreen];
    validate_input [label="validate_input", fillcolor=lightblue];

    __end__ [label="", shape=doublecircle, fillcolor=black, width=0.3, fixedsize=true];

    start_test_nested_flow -> validate_input;
    validate_input -> router_test_nested_flow_line_9_if_7;
    router_test_nested_flow_line_12_seq_1 -> route_a_x;
    router_test_nested_flow_line_15_seq_2 -> route_a_y;
    router_test_nested_flow_line_11_if_3 -> router_test_nested_flow_line_12_seq_1 [label="p['level2'] == 'X'", color="#2E8B57", fontcolor="#2E8B57"];
    router_test_nested_flow_line_11_if_3 -> router_test_nested_flow_line_15_seq_2 [label="else", color="#D35400", fontcolor="#D35400"];
    router_test_nested_flow_line_20_seq_4 -> route_b_x;
    router_test_nested_flow_line_23_seq_5 -> route_b_y;
    router_test_nested_flow_line_19_if_6 -> router_test_nested_flow_line_20_seq_4 [label="p['level2'] == 'X'", color="#2E8B57", fontcolor="#2E8B57"];
    router_test_nested_flow_line_19_if_6 -> router_test_nested_flow_line_23_seq_5 [label="else", color="#D35400", fontcolor="#D35400"];
    router_test_nested_flow_line_9_if_7 -> router_test_nested_flow_line_11_if_3 [label="p['level1'] == 'A'", color="#2E8B57", fontcolor="#2E8B57"];
    router_test_nested_flow_line_9_if_7 -> router_test_nested_flow_line_19_if_6 [label="else", color="#D35400", fontcolor="#D35400"];
    route_a_x -> finalize_result;
    route_a_y -> finalize_result;
    route_b_x -> finalize_result;
    route_b_y -> finalize_result;
    finalize_result -> __end__;
}