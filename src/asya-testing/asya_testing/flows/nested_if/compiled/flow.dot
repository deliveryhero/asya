digraph "test_nested_flow" {
    rankdir=TB;
    node [shape=box, style=filled, fontname="Helvetica"];

    end_test_nested_flow [label="end_test_nested_flow", fillcolor=palegreen];
    finalize_result [label="finalize_result", fillcolor=lightblue];
    route_a_x [label="route_a_x", fillcolor=lightblue];
    route_a_y [label="route_a_y", fillcolor=lightblue];
    route_b_x [label="route_b_x", fillcolor=lightblue];
    route_b_y [label="route_b_y", fillcolor=lightblue];
    router_test_nested_flow_line_11_if_3 [label="router_test_nested_flow_line_11_if_3", fillcolor=wheat];
    router_test_nested_flow_line_12_seq_1 [label="router_test_nested_flow_line_12_seq_1", fillcolor=wheat];
    router_test_nested_flow_line_15_seq_2 [label="router_test_nested_flow_line_15_seq_2", fillcolor=wheat];
    router_test_nested_flow_line_19_if_6 [label="router_test_nested_flow_line_19_if_6", fillcolor=wheat];
    router_test_nested_flow_line_20_seq_4 [label="router_test_nested_flow_line_20_seq_4", fillcolor=wheat];
    router_test_nested_flow_line_23_seq_5 [label="router_test_nested_flow_line_23_seq_5", fillcolor=wheat];
    router_test_nested_flow_line_9_if_7 [label="router_test_nested_flow_line_9_if_7", fillcolor=wheat];
    start_test_nested_flow [label="start_test_nested_flow", fillcolor=palegreen];
    validate_input [label="validate_input", fillcolor=lightblue];

    start_test_nested_flow -> validate_input;
    validate_input -> router_test_nested_flow_line_9_if_7;
    router_test_nested_flow_line_12_seq_1 -> route_a_x;
    router_test_nested_flow_line_15_seq_2 -> route_a_y;
    router_test_nested_flow_line_11_if_3 -> router_test_nested_flow_line_12_seq_1 [label="p['level2'] == 'X'"];
    router_test_nested_flow_line_11_if_3 -> router_test_nested_flow_line_15_seq_2 [label="not (p['level2'] == 'X')"];
    router_test_nested_flow_line_20_seq_4 -> route_b_x;
    router_test_nested_flow_line_23_seq_5 -> route_b_y;
    router_test_nested_flow_line_19_if_6 -> router_test_nested_flow_line_20_seq_4 [label="p['level2'] == 'X'"];
    router_test_nested_flow_line_19_if_6 -> router_test_nested_flow_line_23_seq_5 [label="not (p['level2'] == 'X')"];
    router_test_nested_flow_line_9_if_7 -> router_test_nested_flow_line_11_if_3 [label="p['level1'] == 'A'"];
    router_test_nested_flow_line_9_if_7 -> router_test_nested_flow_line_19_if_6 [label="not (p['level1'] == 'A')"];
    router_test_nested_flow_line_12_seq_1 -> finalize_result;
    router_test_nested_flow_line_15_seq_2 -> finalize_result;
    router_test_nested_flow_line_20_seq_4 -> finalize_result;
    router_test_nested_flow_line_23_seq_5 -> finalize_result;
    finalize_result -> end_test_nested_flow;
    route_a_x -> end_test_nested_flow;
    route_a_y -> end_test_nested_flow;
    route_b_x -> end_test_nested_flow;
    route_b_y -> end_test_nested_flow;
}